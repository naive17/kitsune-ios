{
 "bottle": "Steam",
 "exe": "Apps/Steam/steam.exe",
 "args": [
  "-console",
  "-silent",
  "-applaunch",
  "570940"
 ],
 "env": {
  "IOSWINE_GAME_INPUT": "1",
  "IOSWINE_XINPUT_TRACE": "1",
  "WINEDLLOVERRIDES": "xinput1_1,xinput1_2,xinput1_3,xinput1_4,xinput9_1_0,xinputuap=b",
  "WINE_IOS_STACKPOOL_MB": "512",
  "IOSWINE_FORCE_SWRAST": "1",
  "WINE_IOS_BIGPOOL_MB": "1",
  "IOSWINE_THREAD_DUMP": "5",
  "IOSWINE_TRACE_BIGALLOC": "256",
  "WINE_IOS_CEF_LOWBAND": "1",
  "IOSWINE_FEX_CODE_MB": "48",
  "DXMT_CONFIG": "d3d11.mipClampBC = 4; d3d11.bcMaxDim = 512",
  "IOSWINE_BC_16BIT": "1",
  "WINEIOS_METAL_DEBUG": "1",
  "IOSWINE_ARENA_CODE_MB": "384",
  "IOSWINE_LANDSCAPE": "1",
  "IOSWINE_SCREEN_MAX": "1386x640",
  "IOSWINE_SWAP": "1",
  "IOSWINE_SWAP_MASK": "3"
 }
}
