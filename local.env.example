# Per-developer settings. Copy to local.env (ignored by git); every script
# reads it through scripts/common.sh.

# Your Apple Developer team, and a bundle id registered to it: the defaults in
# kitsune-device.yml belong to the maintainer's team and cannot be signed by
# anyone else. Xcode > Settings > Accounts shows the team id.
#KITSUNE_TEAM=ABCDE12345
#KITSUNE_BUNDLE_ID=com.example.kitsune

# The Xcode to build with, when it is not in /Applications, ~/Downloads or on
# an external volume.
#DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

# The phone and the LiveContainer app the device scripts use, when more than
# one is paired or installed.
#UDID=00008110-000000000000000E
#LIVECONTAINER=com.kdt.livecontainer.ABCDE12345
