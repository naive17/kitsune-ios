# Pinned upstream revisions, sourced by every build script. The SHAs are commits
# (annotated tags peeled with ^{}), not tag objects.

# --- Wine: ARM64 host + arm64ec PE modules -----------------------------------
WINE_URL=https://gitlab.winehq.org/wine/wine.git
WINE_TAG=wine-11.15
WINE_SHA=2df1ee28039cf84776eb1421ed90bd154cebb65f

# --- FEX: the only working x86_64 -> ARM64EC emulator (libarm64ecfex.dll) ----
FEX_URL=https://github.com/FEX-Emu/FEX.git
FEX_TAG=FEX-2608
FEX_SHA=e869aa644a16e4332cdc15c1ea0b4d13d482385d

# --- Graphics translation ----------------------------------------------------
DXMT_URL=https://github.com/3Shain/dxmt.git
DXMT_TAG=v0.80
DXMT_SHA=589adb780354b461645b29999cefaf533594ee99

DXVK_URL=https://github.com/doitsujin/dxvk.git
DXVK_TAG=v3.0.2
DXVK_SHA=6b20f622a77b87b2921fe5d2c1774d2f2ba3e9b7

VKD3D_URL=https://github.com/HansKristian-Work/vkd3d-proton.git
VKD3D_TAG=v3.0.1
VKD3D_SHA=3b10bd7a7ec6a7347e616cf8bea59333afec2255

# --- Toolchain ---------------------------------------------------------------
# llvm-mingw 20260812 ships arm64ec/arm64x support (its build-mingw-w64.sh:90,122).
LLVM_MINGW_VER=20260812
LLVM_MINGW_SHA=9b94494e4fc065bb404d10fb5d0d27e48720c33d
LLVM_MINGW_ASSET=llvm-mingw-20260812-ucrt-macos-universal.tar.xz

# SECOND toolchain, used only for FEX's module (06-fex-arm64ec.sh).
# Upstream llvm-mingw 20260812 (clang 23.1.0-rc3) cannot compile FEXCore for
# arm64ec: it dies with
#   fatal error: error in backend: Failed to evaluate function length in SEH unwind info
# in the AArch64 Assembly Printer. Verified NOT a flag interaction -- reproduces
# at -O0 with no extra flags on FEXCore/Source/Interface/Core/Addressing.cpp.
# bylaws maintains the out-of-tree ARM64EC LLVM patches FEX depends on, and
# Hangover (github.com/AndreRH/hangover) builds its FEX modules with this fork.
FEX_MINGW_REPO=bylaws/llvm-mingw
FEX_MINGW_VER=20250920
FEX_MINGW_ASSET=llvm-mingw-20250920-ucrt-macos-universal.tar.xz

# DXMT's DXBC->AIR backend requires LLVM major 15 EXACTLY (third_party/dxmt/docs/DEVELOPMENT.md).
LLVM_AIR_TAG=llvmorg-15.0.7

# --- FreeType: without it win32u's font_init bails at init_freetype_lib() and
# --- every window renders with no text at all (measured: notepad drew its
# --- title bar, menu strip and scrollbar, zero glyphs). iOS has no system
# --- freetype to dlopen, so this is built and linked in.
FREETYPE_URL=https://github.com/freetype/freetype.git
FREETYPE_TAG=VER-2-13-3
FREETYPE_SHA=42608f77f20749dd6ddc9e0536788eaad70ea4b5

# --- GnuTLS: Wine's schannel (TLS for WinHTTP/WinINet) and crypt32 PFX import
# --- dlopen it. Built by 05-gnutls-ios.sh as one dylib with GMP and nettle
# --- linked in statically. Upstream release tarballs, checked by SHA-256.
GMP_VER=6.3.0
GMP_URL=https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz
GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
NETTLE_VER=3.10.1
NETTLE_URL=https://ftp.gnu.org/gnu/nettle/nettle-3.10.1.tar.gz
NETTLE_SHA256=b0fcdd7fc0cdea6e80dcf1dd85ba794af0d5b4a57e26397eee3bc193272d9132
GNUTLS_VER=3.8.9
GNUTLS_URL=https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.9.tar.xz
GNUTLS_SHA256=69e113d802d1670c4d5ac1b99040b1f2d5c7c05daec5003813c049b5184820ed
