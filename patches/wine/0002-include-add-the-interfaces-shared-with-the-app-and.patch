diff --git a/include/wine/ios_gamepad.h b/include/wine/ios_gamepad.h
new file mode 100644
index 0000000000000000000000000000000000000000..6cddc86f949dfcfb7f6a78e858cb02ab6d5a9fda
--- /dev/null
+++ b/include/wine/ios_gamepad.h
@@ -0,0 +1,31 @@
+/* Kitsune private, pointer-free GameController -> XInput snapshot ABI.
+ * Shared by the native host, ntdll unix and ARM64EC PE XInput modules.
+ * Copyright 2026 the Kitsune project. SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef __WINE_IOS_GAMEPAD_H
+#define __WINE_IOS_GAMEPAD_H
+#include <stdint.h>
+
+#define KITSUNE_GAMEPAD_INFO_CLASS 1001
+#define KITSUNE_GAMEPAD_VERSION 1
+#define KITSUNE_GAMEPAD_COUNT 4
+
+struct ios_gamepad_state
+{
+    uint32_t connected, packet;
+    uint16_t buttons;
+    uint8_t left_trigger, right_trigger;
+    int16_t lx, ly, rx, ry;
+    uint8_t battery_type, battery_level;
+    uint16_t reserved;
+};
+
+struct ios_gamepad_info
+{
+    uint32_t version;
+    struct ios_gamepad_state pads[KITSUNE_GAMEPAD_COUNT];
+};
+
+/* No pointers, native long, BOOL, atomics or platform ABI-dependent enums. */
+_Static_assert(sizeof(struct ios_gamepad_state) == 24, "gamepad state ABI");
+_Static_assert(sizeof(struct ios_gamepad_info) == 100, "gamepad snapshot ABI");
+#endif
