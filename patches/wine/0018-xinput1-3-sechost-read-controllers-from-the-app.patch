     {
         SetLastError(ERROR_NOT_ENOUGH_MEMORY);
         return NULL;
@@ -2151,6 +2268,11 @@ HDEVNOTIFY WINAPI I_ScRegisterDeviceNotification( HANDLE handle, DEV_BROADCAST_H
     notify->handle = handle;
     notify->callback = callback;
     memcpy( notify->header, filter, filter->dbch_size );
+    notify->owner_pid = GetCurrentProcessId();
+    ios_gamepad_event( &broadcast, 0 );
+    notify->ios_gamepads = (filter->dbch_devicetype == DBT_DEVTYP_DEVICEINTERFACE || !filter->dbch_devicetype) &&
+        notification_filter_matches( filter, L"", (DEV_BROADCAST_HDR *)&broadcast, L"" ) &&
+        ios_gamepad_snapshot( &gamepads );
 
     if (filter->dbch_devicetype == DBT_DEVTYP_HANDLE)
     {
@@ -2173,6 +2295,7 @@ HDEVNOTIFY WINAPI I_ScRegisterDeviceNotification( HANDLE handle, DEV_BROADCAST_H
 
     EnterCriticalSection( &service_cs );
     list_add_tail( &device_notify_list, &notify->entry );
+    if (notify->ios_gamepads) ios_start_gamepad_listener( notify->owner_pid );
 
     if (!device_notify_thread)
         device_notify_thread = CreateThread( NULL, 0, device_notify_proc, NULL, 0, NULL );
