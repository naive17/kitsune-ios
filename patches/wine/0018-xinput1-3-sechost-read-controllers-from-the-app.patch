+/* iOS has GameController.framework, not the desktop HID bus. The private
+ * syscall copies native snapshots, so no guest thread waits on UIKit or HID
+ * discovery. The ordinary Wine backend is unchanged when the host lacks it. */
+static BOOL ios_backend;
+static BOOL ios_trace;
+static LONG ios_caps_traces;
+
+static BOOL ios_dsr_read( uintptr_t address, void *data, SIZE_T size )
+{
+    SIZE_T read = 0;
+    if (address < 0x10000 || address > UINTPTR_MAX - size) return FALSE;
+    return !NtReadVirtualMemory( GetCurrentProcess(), (const void *)address, data, size, &read ) && read == size;
+}
+
+static BOOL ios_dsr_match( uintptr_t address, const char *bytes, SIZE_T size )
+{
+    char data[32];
+    return size <= sizeof(data) && ios_dsr_read( address, data, size ) && !memcmp( data, bytes, size );
+}
+
+static uintptr_t ios_dsr_image(void)
+{
+    uintptr_t base = (uintptr_t)GetModuleHandleW( NULL );
+    DWORD pe, signature, stamp, size;
+    WORD dos, machine, magic;
+    if (!base || !ios_dsr_read( base, &dos, sizeof(dos) ) || dos != 0x5a4d ||
+        !ios_dsr_read( base + 0x3c, &pe, sizeof(pe) ) || pe > 0x1000 ||
+        !ios_dsr_read( base + pe, &signature, sizeof(signature) ) || signature != 0x4550 ||
+        !ios_dsr_read( base + pe + 4, &machine, sizeof(machine) ) || machine != 0x8664 ||
+        !ios_dsr_read( base + pe + 8, &stamp, sizeof(stamp) ) || stamp != 0x6344ca56 ||
+        !ios_dsr_read( base + pe + 24, &magic, sizeof(magic) ) || magic != 0x20b ||
+        !ios_dsr_read( base + pe + 80, &size, sizeof(size) ) || size != 0x319b000)
+        return 0;
+    /* Binding-manager global reference, binding vector layout, refresh code. */
+    if (!ios_dsr_match( base + 0x54c3bb, "\x48\x8b\x0d\x5e\x90\x76\x01\xe8\x79\x58\x74\x00", 12 ) ||
+        !ios_dsr_match( base + 0xc91c8c, "\x48\x8b\x5e\x08\x4c\x89\x74\x24\x50\x48\x3b\x5e\x10", 13 ) ||
+        !ios_dsr_match( base + 0xc96330, "\x48\x89\x5c\x24\x08\x48\x89\x6c\x24\x10\x48\x89\x74\x24\x18\x57\x48\x83\xec\x20", 20 ))
+        return 0;
+    return base;
+}
+
+static BOOL ios_dsr_bindings_ready( uintptr_t base )
+{
+    uint64_t address, manager[3], entry;
+    DWORD type;
+    if (!base) return TRUE;
+    if (!ios_dsr_read( base + 0x1cb5420, &address, sizeof(address) ) || address > UINTPTR_MAX ||
+        !ios_dsr_read( (uintptr_t)address, manager, sizeof(manager) ) ||
+        manager[0] != base + 0x12d2fd0 || manager[1] > manager[2] ||
+        manager[2] > UINTPTR_MAX || (manager[1] & 7) ||
+        (manager[2] - manager[1]) % 0x148 || (manager[2] - manager[1]) / 0x148 > 256)
+        return FALSE;
+    for (entry = manager[1]; entry < manager[2]; entry += 0x148)
+    {
+        if (!ios_dsr_read( (uintptr_t)entry + 0x88, &type, sizeof(type) )) return FALSE;
+        if (type == 1) return TRUE;
+    }
+    return FALSE;
+}
+
+struct ios_xinput_client
+{
+    struct ios_xinput_client *next;
+    DWORD pid;
+    LONG enabled, enable_epoch;
+    LONG trace_enable_count;
+    XINPUT_GAMEPAD last_keys[XUSER_MAX_COUNT];
+    DWORD trace_seen, trace_count;
+    DWORD trace_packet[XUSER_MAX_COUNT], trace_status[XUSER_MAX_COUNT];
+    uintptr_t dsr_image;
+    DWORD dsr_held, dsr_epoch[XUSER_MAX_COUNT], dsr_traces;
+};
+static struct ios_xinput_client *ios_clients;
+static SRWLOCK ios_clients_lock = SRWLOCK_INIT;
+
+static struct ios_xinput_client *ios_client(void)
+{
+    struct ios_xinput_client *client;
+    DWORD pid = GetCurrentProcessId();
+    AcquireSRWLockExclusive(&ios_clients_lock);
+    for (client = ios_clients; client && client->pid != pid; client = client->next) {}
+    if (!client && (client = calloc(1, sizeof(*client))))
+    {
+        client->pid = pid;
+        client->enabled = TRUE;
+        client->dsr_image = ios_dsr_image();
+        if (client->dsr_image)
+            WINE_MESSAGE("[ios-xinput] DSR binding guard enabled pid=%04lx image=%p\n", pid, (void *)client->dsr_image);
+        client->next = ios_clients;
+        ios_clients = client;
+    }
+    ReleaseSRWLockExclusive(&ios_clients_lock);
+    return client;
+}
+
+static DWORD ios_read_pad(DWORD index, struct ios_gamepad_state *pad)
+{
+    struct ios_gamepad_info info;
+    if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+    if (NtQuerySystemInformation((SYSTEM_INFORMATION_CLASS)KITSUNE_GAMEPAD_INFO_CLASS,
+                                &info, sizeof(info), NULL) || info.version != KITSUNE_GAMEPAD_VERSION)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    *pad = info.pads[index];
+    return pad->connected ? ERROR_SUCCESS : ERROR_DEVICE_NOT_CONNECTED;
+}
+
+static DWORD ios_get_state(DWORD index, XINPUT_STATE *state)
+{
+    struct ios_gamepad_state pad = {0};
+    struct ios_xinput_client *client;
+    DWORD ret;
+    BOOL enabled, emit = FALSE, held = FALSE, gate_emit = FALSE;
+    DWORD packet, count = 0;
+    if (index >= XUSER_MAX_COUNT) return ERROR_BAD_ARGUMENTS;
+    if (!(client = ios_client())) return ERROR_NOT_ENOUGH_MEMORY;
+    ret = ios_read_pad(index, &pad);
+    enabled = InterlockedCompareExchange(&client->enabled, 0, 0);
+    packet = pad.packet + InterlockedCompareExchange(&client->enable_epoch, 0, 0);
+    if (client->dsr_image)
+    {
+        DWORD bit = 1u << index;
+        AcquireSRWLockExclusive(&ios_clients_lock);
+        held = !ret && !ios_dsr_bindings_ready( client->dsr_image );
+        if (!!(client->dsr_held & bit) != held)
+        {
+            client->dsr_held ^= bit;
+            ++client->dsr_epoch[index]; /* Releasing neutral must change the packet even without native input. */
+            if (client->dsr_traces++ < 32) gate_emit = TRUE;
+        }
+        packet += client->dsr_epoch[index];
+        ReleaseSRWLockExclusive(&ios_clients_lock);
+        if (gate_emit)
+            WINE_MESSAGE("[ios-xinput] DSR binding gate pid=%04lx slot=%lu %s ret=%lu packet=%lu\n",
+                         client->pid, index, held ? "waiting-neutral" : "ready-or-disconnected", ret, packet);
+    }
+    if (ios_trace)
+    {
+        AcquireSRWLockExclusive(&ios_clients_lock);
+        if (client->trace_count < 128 && (!(client->trace_seen & (1u << index)) ||
+            client->trace_packet[index] != packet || client->trace_status[index] != ret))
+        {
+            client->trace_seen |= 1u << index;
+            client->trace_packet[index] = packet;
+            client->trace_status[index] = ret;
+            count = ++client->trace_count;
+            emit = TRUE;
+        }
+        ReleaseSRWLockExclusive(&ios_clients_lock);
+        if (emit) WINE_MESSAGE("[ios-xinput] state pid=%04lx slot=%lu ret=%lu enabled=%d held=%d packet=%lu raw-buttons=%04x lt=%u rt=%u l=%d,%d r=%d,%d trace=%lu/128\n",
+                              client->pid, index, ret, enabled, held, packet, pad.buttons,
+                              pad.left_trigger, pad.right_trigger, pad.lx, pad.ly, pad.rx, pad.ry, count);
+    }
+    if (ret) return ret;
+    memset(state, 0, sizeof(*state));
+    state->dwPacketNumber = packet;
+    if (enabled && !held)
+    {
+        state->Gamepad.wButtons = pad.buttons;
+        state->Gamepad.bLeftTrigger = pad.left_trigger;
+        state->Gamepad.bRightTrigger = pad.right_trigger;
+        state->Gamepad.sThumbLX = pad.lx;
+        state->Gamepad.sThumbLY = pad.ly;
+        state->Gamepad.sThumbRX = pad.rx;
+        state->Gamepad.sThumbRY = pad.ry;
+    }
+    return ERROR_SUCCESS;
+}
