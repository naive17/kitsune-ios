+struct ios_gamepad_listener
+{
+    struct list entry;
+    DWORD pid;
+};
+static struct list ios_gamepad_listeners = LIST_INIT(ios_gamepad_listeners);
+
+struct ios_gamepad_broadcast
+{
+    DWORD size, type, reserved;
+    GUID guid;
+    WCHAR name[96];
+};
+C_ASSERT( offsetof(struct ios_gamepad_broadcast, name) == offsetof(DEV_BROADCAST_DEVICEINTERFACE_W, dbcc_name) );
+
+static void ios_gamepad_event( struct ios_gamepad_broadcast *event, unsigned int slot )
+{
+    static const GUID hid_guid = {0x4d1e55b2,0xf16f,0x11cf,{0x88,0xcb,0x00,0x11,0x11,0x00,0x00,0x30}};
+    memset( event, 0, sizeof(*event) );
+    event->type = DBT_DEVTYP_DEVICEINTERFACE;
+    event->guid = hid_guid;
+    swprintf( event->name, ARRAY_SIZE(event->name),
+              L"\\\\?\\KITSUNE#GameController#%u#{4d1e55b2-f16f-11cf-88cb-001111000030}", slot );
+    event->size = offsetof(struct ios_gamepad_broadcast, name[wcslen(event->name) + 1]);
+}
+
+static BOOL ios_gamepad_snapshot( struct ios_gamepad_info *info )
+{
+    return !NtQuerySystemInformation( (SYSTEM_INFORMATION_CLASS)KITSUNE_GAMEPAD_INFO_CLASS,
+                                      info, sizeof(*info), NULL ) && info->version == KITSUNE_GAMEPAD_VERSION;
+}
+
+/* service_cs held. Each subscription has its own baseline, including pads
+ * already attached when a new child process/window registers. Never share
+ * that baseline between Steam and its threaded child processes. */
+static BOOL ios_collect_gamepad_events( DWORD pid, const struct ios_gamepad_info *info, struct list *events )
+{
+    struct device_notify *notify, *event;
+    struct ios_gamepad_broadcast broadcast;
+    unsigned int i, mask = 0;
+    BOOL listening = FALSE;
+
+    if (info) for (i = 0; i < KITSUNE_GAMEPAD_COUNT; ++i) if (info->pads[i].connected) mask |= 1u << i;
+    LIST_FOR_EACH_ENTRY( notify, &device_notify_list, struct device_notify, entry )
+    {
+        if (!notify->ios_gamepads || notify->owner_pid != pid) continue;
+        listening = TRUE;
+        if (!info) continue; /* A failed snapshot is not a disconnection. */
+        for (i = 0; i < KITSUNE_GAMEPAD_COUNT; ++i)
+        {
+            unsigned int bit = 1u << i;
+            if (!((notify->ios_seen ^ mask) & bit)) continue;
+            ios_gamepad_event( &broadcast, i );
+            if (!(event = device_notify_copy( notify, (DEV_BROADCAST_HDR *)&broadcast ))) continue;
+            event->ios_event = mask & bit ? DBT_DEVICEARRIVAL : DBT_DEVICEREMOVECOMPLETE;
+            list_add_tail( events, &event->entry );
+            notify->ios_seen ^= bit; /* Retry next poll if allocation failed. */
+        }
+    }
+    return listening;
+}
+
+static DWORD WINAPI ios_gamepad_notify_proc( void *arg )
+{
+    struct ios_gamepad_listener *listener = arg;
+    struct ios_gamepad_info info;
+    struct device_notify *event, *next;
+    BOOL valid, listening;
+    SetThreadDescription( GetCurrentThread(), L"ios_gamepad_device_notify" );
+    for (;;)
+    {
+        struct list events = LIST_INIT(events);
+        valid = ios_gamepad_snapshot( &info );
+        EnterCriticalSection( &service_cs );
+        listening = ios_collect_gamepad_events( listener->pid, valid ? &info : NULL, &events );
+        if (!listening) list_remove( &listener->entry );
+        LeaveCriticalSection( &service_cs );
+        if (!listening) break;
+
+        /* Match the normal notification path: no service lock across a
+         * callback, which may poll XInput, unregister, or register again. */
+        LIST_FOR_EACH_ENTRY_SAFE( event, next, &events, struct device_notify, entry )
+        {
+            event->callback( event->handle, event->ios_event, event->header );
+            list_remove( &event->entry );
+            free( event );
+        }
+        Sleep( 16 );
+    }
+    free( listener );
+    return 0;
+}
+
+/* service_cs held; one native notification worker per logical Wine process. */
+static void ios_start_gamepad_listener( DWORD pid )
+{
+    struct ios_gamepad_listener *listener;
+    HANDLE thread;
+    LIST_FOR_EACH_ENTRY( listener, &ios_gamepad_listeners, struct ios_gamepad_listener, entry )
+        if (listener->pid == pid) return;
+    if (!(listener = calloc( 1, sizeof(*listener) ))) return;
+    listener->pid = pid;
+    list_add_tail( &ios_gamepad_listeners, &listener->entry );
+    if ((thread = CreateThread( NULL, 0, ios_gamepad_notify_proc, listener, 0, NULL ))) CloseHandle( thread );
+    else
+    {
+        ERR( "could not start iOS gamepad notification worker for %04lx\n", pid );
+        list_remove( &listener->entry );
+        free( listener );
+    }
+}
