ntdll, wineboot: Start from a prebuilt prefix.

find_system_builtin finds builtin modules in a prefix without placeholder
files, wineboot writes the hardware keys as non-volatile, and wine.inf
registers the MMDevEnumerator class. The wineboot skip is in env.c
(0005).
---
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index d8b7a92bade64530164a01eae1b367d13b9cfbfd..2cf3080703b11db6fdd160963bf3b76cc34842ad 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -51,6 +51,8 @@ WINE_DECLARE_DEBUG_CHANNEL(imports);
 
 #ifdef __i386__
 static const WCHAR pe_dir[] = L"\\i386-windows";
+#elif defined __arm64ec__
+static const WCHAR pe_dir[] = L"\\aarch64-windows";
 #elif defined __x86_64__
 static const WCHAR pe_dir[] = L"\\x86_64-windows";
 #elif defined __arm__
@@ -3264,6 +3266,28 @@ done:
     return status;
 }
 
+/***********************************************************************
+ *	find_system_builtin
+ *
+ * Find the builtin for a system directory path that names no file, as all of
+ * them do in a prefix bootstrapped without placeholder files.
+ */
+static NTSTATUS find_system_builtin( UNICODE_STRING *nt_name, WINE_MODREF **pwm, HANDLE *mapping,
+                                     SECTION_IMAGE_INFORMATION *image_info, struct file_id *id )
+{
+    const WCHAR *path = nt_name->Buffer + 4;  /* skip \??\ */
+    ULONG len = wcslen( system_dir );
+    WCHAR name[MAX_PATH];
+
+    if (wcsnicmp( path, system_dir, len ) || wcschr( path + len, '\\' ) ||
+        wcslen( path + len ) >= ARRAY_SIZE(name))
+        return STATUS_DLL_NOT_FOUND;
+    wcscpy( name, path + len );
+    RtlFreeUnicodeString( nt_name );
+    return find_builtin_without_file( name, nt_name, pwm, mapping, image_info, id );
+}
+
+
 /***********************************************************************
  *	find_dll_file
  *
@@ -3284,6 +3308,7 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
     if (!contains_path( libname ))
     {
         status = find_apiset_dll( libname, &fullname );
+        TRACE( "ios: %s apiset->%08x\n", debugstr_w(libname), (unsigned)status );
         if (status == STATUS_DLL_NOT_FOUND) return status;
 
         if (status)
@@ -3299,6 +3324,7 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
         }
         else
         {
+            TRACE( "ios: %s actctx->%08x\n", debugstr_w(libname), (unsigned)status );
             if (status != STATUS_SXS_KEY_NOT_FOUND) return status;
             if ((*pwm = find_basename_module( libname ))) return STATUS_SUCCESS;
             if (find_loaded)
@@ -3320,7 +3346,11 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
             status = find_builtin_without_file( libname, nt_name, pwm, mapping, image_info, id );
     }
     else if (!(status = RtlDosPathNameToNtPathName_U_WithStatus( libname, nt_name, NULL, NULL )))
+    {
         status = open_dll_file( nt_name, pwm, mapping, image_info, id );
+        if (status == STATUS_DLL_NOT_FOUND && !find_loaded)
+            status = find_system_builtin( nt_name, pwm, mapping, image_info, id );
+    }
 
     if (status == STATUS_NOT_SUPPORTED) status = STATUS_INVALID_IMAGE_FORMAT;
 
