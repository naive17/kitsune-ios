 HKLM,"Software\Microsoft\OLE","EnableDCOM",,"Y"
 HKLM,"Software\Microsoft\OLE","EnableRemoteConnect",,"N"
 
+[MMDevAPIClasses]
+; mmdevapi's MMDeviceEnumerator coclass (mmdevapi_classes.idl, threading(both)).
+; mmdevapi.dll is NOT listed in [RegisterDllsSection], so nothing else populates
+; HKCR\CLSID for it. dsound's DirectSoundCreate8 path (dsound_main.c get_mmdevenum
+; -> CoCreateInstance(CLSID_MMDeviceEnumerator)) needs this class registered or it
+; returns REGDB_E_CLASSNOTREG (0x80040154) and audio never initialises. This is the
+; only coclass dsound/winmm require to reach mmdevapi -> winecoreaudio.
+HKCR,"CLSID\{BCDE0395-E52F-467C-8E3D-C4579291692E}",,2,"MMDeviceEnumerator class"
+HKCR,"CLSID\{BCDE0395-E52F-467C-8E3D-C4579291692E}\InprocServer32",,2,"mmdevapi.dll"
+HKCR,"CLSID\{BCDE0395-E52F-467C-8E3D-C4579291692E}\InprocServer32","ThreadingModel",2,"Both"
+
 [Printing]
 HKLM,%Control%\Print\Monitors\Local Port,"Driver",2,"localspl.dll"
 HKLM,%Control%\Print\Printers,"DefaultSpoolDirectory",2,"%11%\spool\printers"
