 {
+#ifndef WINE_IOS_JIT_ARENA
     FIXME("(%s,%p): stub\n", debugstr_w(name), index);
+#endif
 
     if (!name)
     {
@@ -70,6 +72,11 @@ HANDLE WINAPI AvSetMmThreadCharacteristicsW(const WCHAR *name, DWORD *index)
         return NULL;
     }
 
+#ifdef WINE_IOS_JIT_ARENA
+    if (!SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL))
+        WARN("iOS audio-thread promotion failed, error %lu\n", GetLastError());
+#endif
+
     return (HANDLE)0x12345678;
 }
 
