+static NTSTATUS unix_get_endpoint_ids(void *args)
+{
+    struct get_endpoint_ids_params *params = args;
+    static const WCHAR ios_name[] = {'i','O','S',' ','A','u','d','i','o',0};
+    static const char ios_uid[] = "ios-default-out";
+    struct endpoint *endpoint = params->endpoints;
+    unsigned int needed, offset;
+    const SIZE_T name_size = sizeof(ios_name);           /* WCHARs incl. NUL */
+    const SIZE_T uid_size = (sizeof(ios_uid) + 1) & ~1;  /* UTF8, padded even */
+
+    params->num = 0;
+    params->default_idx = 0;
+
+    if(params->flow != eRender && params->flow != eCapture){
+        params->result = E_INVALIDARG;
+        return STATUS_SUCCESS;
+    }
+
+    /* iOS exposes exactly one hardcoded default endpoint (RemoteIO). */
+    params->num = 1;
+    offset = sizeof(*endpoint);
+    needed = offset + name_size + uid_size;
+
+    if(needed <= params->size){
+        endpoint->name = offset;
+        memcpy((char *)params->endpoints + offset, ios_name, name_size);
+        offset += name_size;
+
+        endpoint->device = offset;
+        memcpy((char *)params->endpoints + offset, ios_uid, sizeof(ios_uid));
+        offset += uid_size;
+
+        params->result = S_OK;
+    }else{
+        params->size = needed;
+        params->result = HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+    }
+
+    return STATUS_SUCCESS;
+}
