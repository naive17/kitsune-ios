-                 NtCurrentTeb()->Tib.StackLimit, NtCurrentTeb()->Tib.StackBase );
+            /* The emulator stack is the other legal home for a frame here
+             * (is_valid_arm64ec_frame), and printing only the thread stack
+             * makes a frame that IS on the emulator stack look impossible. */
+            ERR( "invalid frame %I64x (thread %p-%p, emulator %I64x-%I64x)\n",
