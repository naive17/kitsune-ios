@@ -1105,14 +1123,603 @@ static BOOL handle_syscall_fault( struct thread_data *data, ucontext_t *context,
  *
  * Handler for SIGSEGV and related errors.
  */
+#ifdef WINE_IOS_JIT_ARENA
+static BOOL ios_page_is_exec_readonly( const void *addr )
+{
+    vm_address_t r_addr = (vm_address_t)addr;
+    vm_size_t r_size = 0;
+    vm_region_basic_info_data_64_t r_info;
+    mach_msg_type_number_t r_count = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t r_obj = MACH_PORT_NULL;
+
+    if (vm_region_64( mach_task_self(), &r_addr, &r_size, VM_REGION_BASIC_INFO_64,
+                      (vm_region_info_t)&r_info, &r_count, &r_obj ) != KERN_SUCCESS)
+        return FALSE;
+    /* vm_region_64 returns the first region at OR ABOVE the address, so an
+     * unmapped address answers with somebody else's region. Only a region that
+     * actually contains the address says anything about it. */
+    if (r_addr > (vm_address_t)addr || (vm_address_t)addr >= r_addr + r_size) return FALSE;
+    if (!(r_info.protection & VM_PROT_EXECUTE)) return FALSE;
+    return !(r_info.protection & VM_PROT_WRITE);
+}
+
+static BOOL ios_replay_store_via_alias( siginfo_t *siginfo, ucontext_t *sigcontext,
+                                        DWORD64 esr )
+{
+    ULONG instr;
+    void *alias;
+    unsigned rt, size_log2;
+
+    switch (esr & 0x3f)
+    {
+    case 0x0c: case 0x0d: case 0x0e: case 0x0f:   /* permission fault, levels 0-3 */
+        break;
+    case 0x04: case 0x05: case 0x06: case 0x07:   /* translation fault, levels 0-3 */
+        if (ios_arena_write_alias( siginfo->si_addr ) &&
+            ios_page_is_exec_readonly( siginfo->si_addr ))
+        {
+            static int once_nonres;
+
+            if (!once_nonres++)
+                ERR( "ios: translation fault at %p on a mapped r-x arena page "
+                     "(esr %#llx) -- non-resident, forwarding the store\n",
+                     siginfo->si_addr, (unsigned long long)esr );
+            break;
+        }
+        /* fall through */
+    default:
+    {
+        static int notperm;
+
+        if (notperm < 4)
+        {
+            unsigned long ip = PC_sig( sigcontext );
+            unsigned instr_at_pc = (ip & 3) ? 0 : *(ULONG *)ip;
+            void *wa = ios_arena_write_alias( siginfo->si_addr );
+            char prot[8] = "unmapped";
+            vm_address_t r_addr = (vm_address_t)siginfo->si_addr;
+            vm_size_t r_size = 0;
+            vm_region_basic_info_data_64_t r_info;
+            mach_msg_type_number_t r_count = VM_REGION_BASIC_INFO_COUNT_64;
+            mach_port_t r_obj = MACH_PORT_NULL;
+
+            if (vm_region_64( mach_task_self(), &r_addr, &r_size, VM_REGION_BASIC_INFO_64,
+                              (vm_region_info_t)&r_info, &r_count, &r_obj ) == KERN_SUCCESS &&
+                r_addr <= (vm_address_t)siginfo->si_addr &&
+                (vm_address_t)siginfo->si_addr < r_addr + r_size)
+                snprintf( prot, sizeof(prot), "%c%c%c",
+                          (r_info.protection & VM_PROT_READ)    ? 'r' : '-',
+                          (r_info.protection & VM_PROT_WRITE)   ? 'w' : '-',
+                          (r_info.protection & VM_PROT_EXECUTE) ? 'x' : '-' );
+
+            notperm++;
+            ERR( "ios: store fault at %p is not a permission fault (esr %#llx, "
+                 "dfsc %#llx) -- not replayed; pc %p instr %08x, page %s, "
+                 "arena alias %p\n", siginfo->si_addr,
+                 (unsigned long long)esr, (unsigned long long)(esr & 0x3f),
+                 (void *)ip, instr_at_pc, prot, wa );
+        }
+        return FALSE;
+    }
+    }
+
+    if (PC_sig( sigcontext ) & 3) return FALSE;
+    if (ios_arena_write_alias( siginfo->si_addr ) && !ios_arena_store_allowed( siginfo->si_addr ))
+    {
+        /* Read-only (or guard) at the Windows level: fault like Windows does.
+         * FEX's write-protected RWX code pages land here on every patch. */
+        static int refused;
+
+        if (refused < 4)
+        {
+            refused++;
+            ERR( "ios: store to %p refused by its Windows protection -- raising "
+                 "the access violation instead of forwarding\n", siginfo->si_addr );
+        }
+        return FALSE;
+    }
+    if (!(alias = ios_arena_write_alias( siginfo->si_addr )))
+    {
+        /* Declining here means the address is not an arena page, or the page
+         * already gave up its blessing. Both are legitimate, but on a page the
+         * trace reports as r-x neither should be true, so say so once. */
+        static int declined;
+
+        if (declined < 4)
+        {
+            declined++;
+            ERR( "ios: no write alias for %p (esr %#llx) -- not an arena page, "
+                 "or already unblessed\n",
+                 siginfo->si_addr, (unsigned long long)esr );
+        }
+        return FALSE;
+    }
+
+    instr = *(ULONG *)PC_sig( sigcontext );
+
+    if ((instr & 0x3fa07c00) == 0x08a07c00)
+    {
+        unsigned rs = (instr >> 16) & 0x1f;
+        unsigned rt_cas = instr & 0x1f;
+        BOOL is64 = ((instr >> 30) == 3);
+
+        if (is64)
+        {
+            UINT64 expected = (rs == 31) ? 0 : (UINT64)REGn_sig( rs, sigcontext );
+            UINT64 desired  = (rt_cas == 31) ? 0 : (UINT64)REGn_sig( rt_cas, sigcontext );
+
+            __atomic_compare_exchange_n( (UINT64 *)alias, &expected, desired, FALSE,
+                                         __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE );
+            if (rs != 31) REGn_sig( rs, sigcontext ) = expected;
+        }
+        else
+        {
+            UINT32 expected = (rs == 31) ? 0 : (UINT32)REGn_sig( rs, sigcontext );
+            UINT32 desired  = (rt_cas == 31) ? 0 : (UINT32)REGn_sig( rt_cas, sigcontext );
+
+            __atomic_compare_exchange_n( (UINT32 *)alias, &expected, desired, FALSE,
+                                         __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE );
+            if (rs != 31) REGn_sig( rs, sigcontext ) = expected;
+        }
+        {
+            static int once_cas;
+            if (!once_cas++)
+                ERR( "ios: forwarding compare-and-swap through the alias "
