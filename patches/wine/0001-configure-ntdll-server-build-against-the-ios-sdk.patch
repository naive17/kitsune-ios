configure, ntdll, server: Build against the iOS SDK.

configure recognises iOS through TargetConditionals, leaves AppKit out
and adds wineios.drv's makefile (the driver itself is 0015).
ios_compat.h and ios_mach_vm.h supply what the iOS SDK lacks (VLNK and
D_DISK constants, the mach_vm prototypes); cdrom.c builds as a non-Apple
target; server/sock.c uses Apple's TCPS values. file.c corrects the case
of the app container's path under HOME.

The TCPS numbering is after Madeira's Wine fork (willfaust/wine
d3d5a179a5).
---
diff --git a/configure b/configure
index aa3c65e1f81a41247f1edd53459d25c2fb753d35..ee14f76e794e92c46c3f45c659395b1c59510da9 100755
--- a/configure
+++ b/configure
@@ -1571,6 +1571,7 @@ enable_wined3d
 enable_winedmo
 enable_winegstreamer
 enable_winehid_sys
+enable_wineios_drv
 enable_winemac_drv
 enable_winemapi
 enable_wineoss_drv
@@ -12364,7 +12365,23 @@ case $host_os in
 
     CORESERVICES_LIBS="-framework CoreServices"
 
-    APPKIT_LIBS="-framework AppKit"
+    # AppKit does not exist on iOS. Detect via TargetConditionals rather than the
+    # host triple: --host stays *-apple-darwin so that every other Darwin check
+    # (Mach, CoreFoundation, dylib handling) still applies. Nothing in win32u
+    # actually calls AppKit; it is linked unconditionally on Darwin.
+    cat > conftest_ios.c <<_IOSEOF
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+#error building for iOS
+#endif
+int main(void){return 0;}
+_IOSEOF
+    if $CC $CFLAGS -c conftest_ios.c -o conftest_ios.o >/dev/null 2>&1; then
+      APPKIT_LIBS="-framework AppKit"
+    else
+      APPKIT_LIBS=""
+    fi
+    rm -f conftest_ios.c conftest_ios.o
 
     SECURITY_LIBS="-framework Security -framework CoreFoundation"
 
@@ -23102,6 +23119,7 @@ wine_fn_config_makefile dlls/wined3d enable_wined3d
 wine_fn_config_makefile dlls/winedmo enable_winedmo
 wine_fn_config_makefile dlls/winegstreamer enable_winegstreamer
 wine_fn_config_makefile dlls/winehid.sys enable_winehid_sys
+wine_fn_config_makefile dlls/wineios.drv enable_wineios_drv
 wine_fn_config_makefile dlls/winemac.drv enable_winemac_drv
 wine_fn_config_makefile dlls/winemapi enable_winemapi
 wine_fn_config_makefile dlls/wineoss.drv enable_wineoss_drv
