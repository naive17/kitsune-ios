+#ifdef WINE_IOS_JIT_ARENA
+/* Kitsune: direct server calls. The server is a thread of the app, so a client
+ * thread can run its own request handler instead of writing it to a pipe,
+ * waking the server thread and blocking on the reply: in a 30 s profile of
+ * Dark Souls: Remastered (2026-10-01) the pipe traffic -- write, kevent, read
+ * on both sides -- was about two thirds of the 21% of CPU the server cost.
+ * Every piece of server code runs under ios_server_lock: the server thread
+ * holds it except while it sleeps in kevent (fd.c), and a direct call holds it
+ * for one request. Waits that block still sleep on the thread's wait pipe and
+ * are woken by the server as before. KITSUNE_SERVER_PIPES=1 turns it off. */
+static os_unfair_lock ios_server_lock = OS_UNFAIR_LOCK_INIT;
+
+void ios_server_lock_acquire( void ) { os_unfair_lock_lock( &ios_server_lock ); }
+void ios_server_lock_release( void ) { os_unfair_lock_unlock( &ios_server_lock ); }
+
+/* Run one request for thread. req holds the request on entry and the reply on
+ * return; data is the request's variable part, which the caller keeps owning.
+ * The reply data, if any, is returned malloced in *reply_data so the caller
+ * copies it into its own buffer after the lock is released: a bad pointer must
+ * never fault while ios_server_lock is held. *dead is set when the thread has
+ * been killed and must exit, which a pipe client learns from EPIPE. */
+__attribute__((visibility("default")))
+unsigned int wineserver_inproc_call( void *ptr, void *req, void *data, void **reply_data, int *dead )
+{
+    struct thread *thread = ptr;
+    union generic_reply reply;
+
+    *reply_data = NULL;
+    *dead = 0;
+    ios_server_lock_acquire();
+    if (thread->state == TERMINATED)
+    {
+        ios_server_lock_release();
+        *dead = 1;
+        return STATUS_THREAD_IS_TERMINATING;
+    }
+    set_current_time();
+    memcpy( &thread->req, req, sizeof(thread->req) );
+    thread->req_data = data;
+    thread->ios_direct_req = 1;
+
+    run_req_handler( thread, &reply );
+
+    thread->req_data = NULL;
+    thread->ios_direct_req = 0;
+    if (current)
+    {
+        reply.reply_header.error = current->error;
+        reply.reply_header.reply_size = current->reply_size;
+        if (debug_level) trace_reply( thread->req.request_header.req, &reply );
+        *reply_data = current->reply_size ? current->reply_data : NULL;
+        if (!*reply_data) free( current->reply_data );
+        current->reply_data = NULL;
+        current = NULL;
+    }
+    else
+    {
+        reply.reply_header.error = STATUS_THREAD_IS_TERMINATING;
+        reply.reply_header.reply_size = 0;
+        *dead = 1;
+    }
+    ios_server_wake_if_needed();
+    ios_server_lock_release();
+
+    memcpy( req, &reply, sizeof(reply) );
+    return reply.reply_header.error;
+}
+#endif
