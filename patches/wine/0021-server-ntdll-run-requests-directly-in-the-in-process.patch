+/* The server's record of the calling thread, referenced so it outlives the
+ * thread's death on the server side; NULL when there is none yet. */
+__attribute__((visibility("default")))
+void *wineserver_inproc_attach( int unix_tid )
+{
+    struct thread *thread, *found = NULL;
+
+    ios_server_lock_acquire();
+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        /* a dead thread can keep a reused Mach port name */
+        if (thread->unix_tid == unix_tid && thread->state != TERMINATED)
+        {
+            found = (struct thread *)grab_object( thread );
+            break;
+        }
+    }
+    ios_server_lock_release();
+    return found;
+}
+
+__attribute__((visibility("default")))
+void wineserver_inproc_detach( void *ptr )
+{
+    ios_server_lock_acquire();
+    release_object( ptr );
+    ios_server_lock_release();
+}
