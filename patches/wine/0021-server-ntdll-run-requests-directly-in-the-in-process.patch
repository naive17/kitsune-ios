+/* Direct server calls: the request runs on this thread under the in-process
+ * server's lock (server/request.c) instead of going through the request and
+ * reply pipes and the server thread. Set up per thread once the server knows
+ * it; KITSUNE_SERVER_PIPES=1 keeps the pipes. */
+static int get_unix_tid(void);
+static unsigned int (*p_wineserver_inproc_call)( void *thread, void *req, void *data,
+                                                 void **reply_data, int *dead );
+static void *(*p_wineserver_inproc_attach)( int unix_tid );
+static void (*p_wineserver_inproc_detach)( void *thread );
+static int ios_server_direct = -1;
+
+void ios_server_attach_thread( struct thread_data *data )
+{
+    if (ios_server_direct < 0)  /* first thread, nothing else runs yet */
+    {
+        p_wineserver_inproc_call = dlsym( RTLD_DEFAULT, "wineserver_inproc_call" );
+        p_wineserver_inproc_attach = dlsym( RTLD_DEFAULT, "wineserver_inproc_attach" );
+        p_wineserver_inproc_detach = dlsym( RTLD_DEFAULT, "wineserver_inproc_detach" );
+        ios_server_direct = !getenv( "KITSUNE_SERVER_PIPES" ) && p_wineserver_inproc_call &&
+                            p_wineserver_inproc_attach && p_wineserver_inproc_detach;
+        fprintf( stderr, "ios: server calls %s\n", ios_server_direct ? "direct" : "through pipes" );
+    }
+    if (ios_server_direct && !data->ios_server_thread)
+        data->ios_server_thread = p_wineserver_inproc_attach( get_unix_tid() );
+}
+
+void ios_server_detach_thread( struct thread_data *data )
+{
+    void *thread = data->ios_server_thread;
+
+    data->ios_server_thread = NULL;
+    if (thread) p_wineserver_inproc_detach( thread );
+}
+
+static unsigned int ios_server_call_direct( struct thread_data *data, struct __server_request_info *req )
+{
+    data_size_t size = req->u.req.request_header.request_size;
+    char stack_buf[1024], *buf = NULL;
+    void *reply_data;
+    unsigned int ret, i;
+    int dead;
+
+    /* Copy the request data, even a single piece, before taking the lock:
+     * it can be an application buffer, and a bad pointer must fault here,
+     * where the syscall fault handler returns an access violation, and not
+     * in server code holding the lock, which would never be released. */
+    if (size)
+    {
+        char *pos;
+        if (!(buf = size <= sizeof(stack_buf) ? stack_buf : malloc( size ))) return STATUS_NO_MEMORY;
+        for (i = 0, pos = buf; i < req->data_count; i++)
+        {
+            memcpy( pos, req->data[i].ptr, req->data[i].size );
+            pos += req->data[i].size;
+        }
+    }
+    ret = p_wineserver_inproc_call( data->ios_server_thread, &req->u, buf, &reply_data, &dead );
+    if (buf != stack_buf) free( buf );
+    if (dead) abort_thread( 0 );
+    if (reply_data)
+    {
+        memcpy( req->reply_data, reply_data, req->u.reply.reply_header.reply_size );
+        free( reply_data );
+    }
+    return ret;
+}
+#endif
+
