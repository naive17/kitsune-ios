+#ifdef WINE_IOS_JIT_ARENA
+/* Called with ios_server_lock held after a direct call: wake the server thread
+ * if the call added a timeout due before the one it is sleeping until. */
+void ios_server_wake_if_needed( void )
+{
+    timeout_t next = TIMEOUT_INFINITE;
+    struct list *ptr;
+    struct kevent ev;
+
+    if (!ios_server_sleeping || kqueue_fd == -1) return;
+    if ((ptr = list_head( &abs_timeout_list )))
+    {
+        struct timeout_user *timeout = LIST_ENTRY( ptr, struct timeout_user, entry );
+        next = monotonic_time + (timeout->when - current_time);
+    }
+    if ((ptr = list_head( &rel_timeout_list )))
+    {
+        struct timeout_user *timeout = LIST_ENTRY( ptr, struct timeout_user, entry );
+        if (-timeout->when < next) next = -timeout->when;
+    }
+    if (next >= ios_sleep_deadline) return;
+    EV_SET( &ev, IOS_WAKE_IDENT, EVFILT_USER, 0, NOTE_TRIGGER, 0, IOS_WAKE_UDATA );
+    kevent( kqueue_fd, &ev, 1, NULL, 0, NULL );
+    ios_sleep_deadline = next;  /* one trigger per earlier deadline */
+}
+#endif
