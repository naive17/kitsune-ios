+            return STATUS_NOT_SUPPORTED;
+        }
+
+        n = 0;
+        for (i = 0; i < clen && n < sizeof(cl_ascii) - 1; i++)
+        {
+            WCHAR c = params->CommandLine.Buffer[i];
+            cl_ascii[n++] = (c > 0 && c < 128) ? (char)c : '?';
+        }
+        cl_ascii[n] = 0;
+
+        if (strstr( iname, "steamwebhelper" ) && !strstr( cl_ascii, "use-angle" ) &&
+            !strstr( cl_ascii, "disable-software-rasterizer" ))
+        {
+            int want_sp = !strstr( cl_ascii, "single-process" );
+            int want_sr = getenv( "KITSUNE_FORCE_SWRAST" ) != NULL;
+            ULONG swlen = sizeof(sw_ascii) - 1;
+            ULONG splen = want_sp ? sizeof(sp_ascii) - 1 : 0;
+            ULONG srlen = want_sr ? sizeof(sr_ascii) - 1 : 0;
+            ULONG total = swlen + splen + srlen;
+            ULONG oldbytes = params->CommandLine.Length;
+            WCHAR *nbuf = malloc( oldbytes + (total + 1) * sizeof(WCHAR) );
+
+            if (nbuf)
+            {
+                WCHAR *p = (WCHAR *)((char *)nbuf + oldbytes);
+                ULONG at = 0;
+
+                memcpy( nbuf, params->CommandLine.Buffer, oldbytes );
+                for (i = 0; i < swlen; i++) p[at++] = (unsigned char)sw_ascii[i];
+                for (i = 0; i < splen; i++) p[at++] = (unsigned char)sp_ascii[i];
+                for (i = 0; i < srlen; i++) p[at++] = (unsigned char)sr_ascii[i];
+                p[total] = 0;
+                params->CommandLine.Buffer = nbuf;
+                params->CommandLine.Length = oldbytes + total * sizeof(WCHAR);
+                params->CommandLine.MaximumLength = oldbytes + (total + 1) * sizeof(WCHAR);
+                ERR( "ios-nosandbox: added \"%s\"%s%s for %s\n",
+                     sw_ascii,
+                     want_sp ? " --single-process" : "",
+                     want_sr ? " --use-angle=swiftshader" : "",
+                     debugstr_us( &params->ImagePathName ) );
+            }
+        }
+    }
+    if (params && params->ImagePathName.Buffer && params->CommandLine.Buffer &&
+        wcsstr_ascii( params->ImagePathName.Buffer, params->ImagePathName.Length/sizeof(WCHAR), "steamwebhelper" ))
+    {
+        static const char pat[] = "--variations-seed-version";
+        WCHAR *buf = params->CommandLine.Buffer;
+        ULONG len = params->CommandLine.Length / sizeof(WCHAR), i, plen = sizeof(pat) - 1;
+        for (i = 0; i + plen <= len; i++)
+        {
+            ULONG j; int match = 1;
+            for (j = 0; j < plen; j++) if (buf[i+j] != (WCHAR)pat[j]) { match = 0; break; }
+            /* valueless == the char right after the name is not '=' (space or end) */
+            if (match && (i + plen >= len || buf[i+plen] != '='))
+            {
