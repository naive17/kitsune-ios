+#undef IOS_CHILD_CALLBACK
+    callbacks[IOS_CALLBACK_LdrSystemDllInitBlock] = boot->ntdll.LdrSystemDllInitBlock;
+    callbacks[IOS_CALLBACK_KiUserEmulationDispatcher] = boot->ntdll.KiUserEmulationDispatcher;
+    if ((status = ios_process_publish_callbacks( callbacks ))) goto failed;
+    fprintf( stderr, "IOS-CHILD enter: pid=%04x machine=%04x PEB=%p image=%p ntdll=%p thunk=%p emu=%p ecmap=%p\n",
+             get_current_process_id(), process_image_info.Machine, boot->peb, boot->peb->ImageBaseAddress,
+             boot->ntdll.module, boot->ntdll.LdrInitializeThunk, boot->ntdll.KiUserEmulationDispatcher,
+             boot->peb->EcCodeBitMap );
+    {
+        /* The app's heartbeat samples a program's first thread: the latest
+         * one, not the session host, which only waits. Steam's web helper is
+         * left out; Steam, or the game it starts, is the one worth sampling. */
+        void (*report)( unsigned int ) = dlsym( RTLD_DEFAULT, "wine_boot_guest_thread_started" );
+        BOOL helper = FALSE;
+        int i;
