diff --git a/dlls/ntdll/unix/ios_fd_cache.h b/dlls/ntdll/unix/ios_fd_cache.h
new file mode 100644
index 0000000000000000000000000000000000000000..ce5f8c9f057765d103aee1a6dc806bea68dd2304
--- /dev/null
+++ b/dlls/ntdll/unix/ios_fd_cache.h
@@ -0,0 +1,78 @@
+#ifndef KITSUNE_FD_CACHE_H
+#define KITSUNE_FD_CACHE_H
+
+/* Included after Wine's union fd_cache_entry and FD_CACHE_* definitions.
+ * Every function requires fd_cache_mutex, with Wine signals blocked. The
+ * pointer returned by lookup must not escape that critical section.
+ * The per-process cache is adapted from Madeira (willfaust/Madeira 9dc2324,
+ * build/ntdll-unix/server_ios.c), Copyright (C) 2026 Will Faust,
+ * LGPL-2.1-or-later. */
+struct ios_fd_cache
+{
+    union fd_cache_entry *blocks[FD_CACHE_ENTRIES];
+    union fd_cache_entry initial_block[FD_CACHE_BLOCK_SIZE];
+};
+
+#define IOS_MAX_FD_CACHES 64
+static struct ios_fd_cache_slot
+{
+    const void *owner;  /* non-NULL PEB; unbound threads are never cached */
+    struct ios_fd_cache *cache;
+} ios_fd_caches[IOS_MAX_FD_CACHES];
+
+static struct ios_fd_cache *ios_get_fd_cache( const void *owner, BOOL create )
+{
+    unsigned int i, vacant = IOS_MAX_FD_CACHES;
+    struct ios_fd_cache *cache;
+
+    if (!owner) return NULL;
+    for (i = 0; i < IOS_MAX_FD_CACHES; ++i)
+    {
+        if (ios_fd_caches[i].owner == owner) return ios_fd_caches[i].cache;
+        if (!ios_fd_caches[i].owner && vacant == IOS_MAX_FD_CACHES) vacant = i;
+    }
+    if (!create || vacant == IOS_MAX_FD_CACHES) return NULL;
+    if (!(cache = calloc( 1, sizeof(*cache) ))) return NULL;
+    ios_fd_caches[vacant].cache = cache;
+    ios_fd_caches[vacant].owner = owner;
+    return cache;
+}
+
+/* Returns how many cached descriptors it closed. */
+static inline unsigned int ios_release_fd_cache( const void *owner )
+{
+    unsigned int slot, i, j, closed = 0;
+    struct ios_fd_cache *cache = NULL;
+
+    if (!owner) return 0;
+    for (slot = 0; slot < IOS_MAX_FD_CACHES; ++slot)
+        if (ios_fd_caches[slot].owner == owner)
+        {
+            cache = ios_fd_caches[slot].cache;
+            ios_fd_caches[slot].owner = NULL;
+            ios_fd_caches[slot].cache = NULL;
+            break;
+        }
+    if (!cache) return 0;
+    for (i = 0; i < FD_CACHE_ENTRIES; ++i)
+    {
+        union fd_cache_entry *block = cache->blocks[i];
+        if (!block) continue;
+        for (j = 0; j < FD_CACHE_BLOCK_SIZE; ++j)
+        {
+            /* Wine encodes real descriptors as fd+1; FD_TYPE_INVALID carries
+             * an NTSTATUS instead. Neither empty nor error entries own fds. */
+            if (block[j].s.fd && block[j].s.type != FD_TYPE_INVALID)
+            {
+                close( block[j].s.fd - 1 );
+                closed++;
+            }
+        }
+        if (block != cache->initial_block)
+            munmap( block, FD_CACHE_BLOCK_SIZE * sizeof(*block) );
+    }
+    free( cache );
+    return closed;
+}
+
+#endif
diff --git a/dlls/ntdll/unix/ios_ntdll_image.h b/dlls/ntdll/unix/ios_ntdll_image.h
new file mode 100644
index 0000000000000000000000000000000000000000..5338bcb57829fdb9f048fbe8b1201a16d5c67a63
--- /dev/null
+++ b/dlls/ntdll/unix/ios_ntdll_image.h
@@ -0,0 +1,279 @@
+#ifndef KITSUNE_NTDLL_IMAGE_H
+#define KITSUNE_NTDLL_IMAGE_H
+
+#define IOS_NTDLL_CALLBACKS(X) \
+    X(DbgUiRemoteBreakin) \
+    X(KiRaiseUserExceptionDispatcher) \
+    X(KiUserExceptionDispatcher) \
+    X(KiUserApcDispatcher) \
+    X(KiUserCallbackDispatcher) \
+    X(LdrInitializeThunk) \
+    X(RtlUserThreadStart) \
+    X(__wine_ctrl_routine)
+
+struct ios_ntdll_image
+{
+    void *module;
+    SIZE_T size;
+    BOOL ready;
+#define IOS_DECLARE_CALLBACK(name) void *name;
+    IOS_NTDLL_CALLBACKS(IOS_DECLARE_CALLBACK)
+#undef IOS_DECLARE_CALLBACK
+    SYSTEM_DLL_INIT_BLOCK *LdrSystemDllInitBlock;
+    void **syscall_slot;
+    void **unix_call_slot;
+    UINT_PTR *unix_handle_slot;
+    WORD machine;                    /* header machine that was bound */
+    void *KiUserEmulationDispatcher; /* ARM64EC view only, else NULL */
+    void **unix_call_arm64ec_slot;   /* ARM64EC view only, else NULL */
+};
+
+struct ios_ntdll_dispatch
+{
+    void *syscall;
+    void *unix_call;
+    UINT_PTR unix_handle;
+    /* 0 or IMAGE_FILE_MACHINE_ARM64: native view. IMAGE_FILE_MACHINE_AMD64: the
+     * ARM64EC view of a hybrid image, already mapped with its ARM64X fixups. */
+    WORD machine;
+};
+
+static inline BOOL ios_image_range( SIZE_T size, SIZE_T offset, SIZE_T length )
+{
+    return offset <= size && length <= size - offset;
+}
+
+static inline const IMAGE_NT_HEADERS64 *ios_native_nt_headers( const void *module, SIZE_T size )
+{
+    const IMAGE_DOS_HEADER *dos = module;
+    const IMAGE_NT_HEADERS64 *nt;
+    SIZE_T section_offset;
+    if (!module || (UINT_PTR)module % 8 || size < sizeof(*dos) ||
+        dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew % 8)
+        return NULL;
+    if (!ios_image_range( size, dos->e_lfanew, sizeof(*nt) )) return NULL;
+    nt = (const void *)((const char *)module + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE ||
+        (nt->FileHeader.Machine != IMAGE_FILE_MACHINE_ARM64 && nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64) ||
+        nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+        nt->FileHeader.SizeOfOptionalHeader < sizeof(nt->OptionalHeader) ||
+        nt->FileHeader.SizeOfOptionalHeader % 4 ||
+        nt->OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_EXPORT ||
+        nt->OptionalHeader.SizeOfImage != size) return NULL;
+    section_offset = dos->e_lfanew + offsetof(IMAGE_NT_HEADERS64, OptionalHeader) +
+                     nt->FileHeader.SizeOfOptionalHeader;
+    if (!ios_image_range( size, section_offset,
+                         (SIZE_T)nt->FileHeader.NumberOfSections * sizeof(IMAGE_SECTION_HEADER) )) return NULL;
+    return nt;
+}
+
+static inline BOOL ios_image_section_has( const void *module, SIZE_T size, SIZE_T rva,
+                                         SIZE_T length, DWORD flags )
+{
+    const IMAGE_NT_HEADERS64 *nt = ios_native_nt_headers( module, size );
+    const IMAGE_SECTION_HEADER *section;
+    unsigned int i;
+    if (!nt || !ios_image_range( size, rva, length )) return FALSE;
+    section = IMAGE_FIRST_SECTION( nt );
+    for (i = 0; i < nt->FileHeader.NumberOfSections; ++i)
+    {
+        SIZE_T extent = section[i].Misc.VirtualSize;
+        if (!extent) extent = section[i].SizeOfRawData;
+        if (!ios_image_range( size, section[i].VirtualAddress, extent )) continue;
+        if (rva >= section[i].VirtualAddress &&
+            ios_image_range( extent, rva - section[i].VirtualAddress, length ) &&
+            (section[i].Characteristics & flags) == flags) return TRUE;
+    }
+    return FALSE;
+}
+
+static inline DWORD ios_image_u32( const void *module, SIZE_T rva )
+{
+    DWORD value;
+    memcpy( &value, (const char *)module + rva, sizeof(value) );
+    return value;
+}
+
+static inline WORD ios_image_u16( const void *module, SIZE_T rva )
+{
+    WORD value;
+    memcpy( &value, (const char *)module + rva, sizeof(value) );
+    return value;
+}
+
+/* No unchecked export names/ordinals, no forwarded export treated as code. */
+static inline void *ios_ntdll_export( void *module, SIZE_T size, const char *name,
+                                     SIZE_T length, DWORD flags )
+{
+    const IMAGE_NT_HEADERS64 *nt = ios_native_nt_headers( module, size );
+    const IMAGE_DATA_DIRECTORY *directory;
+    IMAGE_EXPORT_DIRECTORY exports;
+    unsigned int i;
+    if (!nt) return NULL;
+    directory = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+    if (!directory->VirtualAddress || directory->Size < sizeof(exports) ||
+        !ios_image_range( size, directory->VirtualAddress, directory->Size )) return NULL;
+    memcpy( &exports, (char *)module + directory->VirtualAddress, sizeof(exports) );
+    if (!ios_image_range( size, exports.AddressOfNames, (SIZE_T)exports.NumberOfNames * sizeof(DWORD) ) ||
+        !ios_image_range( size, exports.AddressOfNameOrdinals, (SIZE_T)exports.NumberOfNames * sizeof(WORD) ) ||
+        !ios_image_range( size, exports.AddressOfFunctions, (SIZE_T)exports.NumberOfFunctions * sizeof(DWORD) ))
+        return NULL;
+    for (i = 0; i < exports.NumberOfNames; ++i)
+    {
+        DWORD name_rva = ios_image_u32( module, exports.AddressOfNames + (SIZE_T)i * sizeof(DWORD) );
+        WORD ordinal;
+        DWORD rva;
+        if (name_rva >= size || !memchr( (char *)module + name_rva, 0, size - name_rva )) return NULL;
+        if (strcmp( (char *)module + name_rva, name )) continue;
+        ordinal = ios_image_u16( module, exports.AddressOfNameOrdinals + (SIZE_T)i * sizeof(WORD) );
+        if (ordinal >= exports.NumberOfFunctions) return NULL;
+        rva = ios_image_u32( module, exports.AddressOfFunctions + (SIZE_T)ordinal * sizeof(DWORD) );
+        if (!rva || (rva >= directory->VirtualAddress && rva - directory->VirtualAddress < directory->Size) ||
+            !ios_image_section_has( module, size, rva, length, flags )) return NULL;
+        return (char *)module + rva;
+    }
+    return NULL;
+}
+
+static inline const IMAGE_ARM64EC_METADATA *ios_ntdll_ec_metadata( const void *module, SIZE_T size )
+{
+    const IMAGE_NT_HEADERS64 *nt = ios_native_nt_headers( module, size );
+    const IMAGE_DATA_DIRECTORY *directory;
+    const IMAGE_LOAD_CONFIG_DIRECTORY64 *cfg;
+    const IMAGE_ARM64EC_METADATA *metadata;
+    ULONGLONG pointer;
+    SIZE_T rva, cfg_size;
+    if (!nt || nt->OptionalHeader.NumberOfRvaAndSizes <= IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG) return NULL;
+    directory = &nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG];
+    if (!directory->VirtualAddress ||
+        !ios_image_range( size, directory->VirtualAddress, directory->Size ) ||
+        directory->Size < offsetof( IMAGE_LOAD_CONFIG_DIRECTORY64, Size ) + sizeof(cfg->Size)) return NULL;
+    cfg = (const void *)((const char *)module + directory->VirtualAddress);
+    cfg_size = ios_image_u32( module, directory->VirtualAddress + offsetof( IMAGE_LOAD_CONFIG_DIRECTORY64, Size ) );
+    if (directory->Size < cfg_size) cfg_size = directory->Size;
+    if (cfg_size < offsetof( IMAGE_LOAD_CONFIG_DIRECTORY64, CHPEMetadataPointer ) + sizeof(pointer)) return NULL;
+    memcpy( &pointer, (const char *)module + directory->VirtualAddress +
+            offsetof( IMAGE_LOAD_CONFIG_DIRECTORY64, CHPEMetadataPointer ), sizeof(pointer) );
+    if (!pointer) return NULL;
+    if (pointer >= (ULONG_PTR)module && pointer - (ULONG_PTR)module < size) rva = pointer - (ULONG_PTR)module;
+    else if (pointer >= nt->OptionalHeader.ImageBase && pointer - nt->OptionalHeader.ImageBase < size)
+        rva = pointer - nt->OptionalHeader.ImageBase;
+    else return NULL;
+    if (rva % 4 || !ios_image_range( size, rva, sizeof(*metadata) )) return NULL;
+    metadata = (const void *)((const char *)module + rva);
+    if (metadata->RedirectionMetadata % 4 ||
+        !ios_image_range( size, metadata->RedirectionMetadata,
+                          (SIZE_T)metadata->RedirectionMetadataCount * sizeof(IMAGE_ARM64EC_REDIRECTION_ENTRY) ))
+        return NULL;
+    return metadata;
+}
+
+/* Exported ARM64EC entry points are x64-callable thunks; the native targets
+ * come from the redirection table. Unlisted addresses stay as they are, like
+ * the root loader's redirect. A listed target must be inside executable code. */
+static inline void *ios_ntdll_ec_redirect( void *module, SIZE_T size, const IMAGE_ARM64EC_METADATA *metadata,
+                                          void *code )
+{
+    const IMAGE_ARM64EC_REDIRECTION_ENTRY *map = (const void *)((char *)module + metadata->RedirectionMetadata);
+    SIZE_T rva = (char *)code - (char *)module;
+    ULONG i;
+    if (!code || rva >= size) return NULL;
+    for (i = 0; i < metadata->RedirectionMetadataCount; ++i)
+    {
+        if (map[i].Source != rva) continue;
+        if (!ios_image_section_has( module, size, map[i].Destination, 1, IMAGE_SCN_MEM_EXECUTE )) return NULL;
+        return (char *)module + map[i].Destination;
+    }
+    return code;
+}
+
+/* Resolve everything before the first write. A missing/invalid export leaves
+ * the mapped bytes and caller's output untouched, not partially bound. */
+static inline NTSTATUS ios_bind_ntdll_image( void *module, SIZE_T size,
+                                            const struct ios_ntdll_dispatch *dispatch,
+                                            struct ios_ntdll_image *out )
+{
+    struct ios_ntdll_image image = {0};
+    const IMAGE_NT_HEADERS64 *nt;
+    const IMAGE_ARM64EC_METADATA *metadata = NULL;
+    WORD machine;
+    if (!out || !dispatch || !dispatch->syscall || !dispatch->unix_call || !dispatch->unix_handle)
+        return STATUS_INVALID_PARAMETER;
+    machine = dispatch->machine ? dispatch->machine : IMAGE_FILE_MACHINE_ARM64;
+    if (machine != IMAGE_FILE_MACHINE_ARM64 && machine != IMAGE_FILE_MACHINE_AMD64) return STATUS_INVALID_PARAMETER;
+    if (!(nt = ios_native_nt_headers( module, size ))) return STATUS_INVALID_IMAGE_FORMAT;
+    /* A hybrid image only carries the AMD64 machine after its ARM64X fixups;
+     * a native view must never be bound as EC, nor an EC view as native. */
+    if (nt->FileHeader.Machine != machine) return STATUS_INVALID_IMAGE_FORMAT;
+    if (machine == IMAGE_FILE_MACHINE_AMD64 && !(metadata = ios_ntdll_ec_metadata( module, size )))
+        return STATUS_INVALID_IMAGE_FORMAT;
+    image.module = module;
+    image.size = size;
+    image.machine = machine;
+#define IOS_RESOLVE_CALLBACK(name) \
+    if (!(image.name = ios_ntdll_export( module, size, #name, 1, IMAGE_SCN_MEM_EXECUTE ))) \
+        return STATUS_PROCEDURE_NOT_FOUND;
+    IOS_NTDLL_CALLBACKS(IOS_RESOLVE_CALLBACK)
+#undef IOS_RESOLVE_CALLBACK
+    image.LdrSystemDllInitBlock = ios_ntdll_export( module, size, "LdrSystemDllInitBlock",
+                                                    sizeof(*image.LdrSystemDllInitBlock), IMAGE_SCN_MEM_WRITE );
+    image.syscall_slot = ios_ntdll_export( module, size, "__wine_syscall_dispatcher",
+                                            sizeof(*image.syscall_slot), IMAGE_SCN_MEM_WRITE );
+    image.unix_call_slot = ios_ntdll_export( module, size, "__wine_unix_call_dispatcher",
+                                              sizeof(*image.unix_call_slot), IMAGE_SCN_MEM_WRITE );
+    image.unix_handle_slot = ios_ntdll_export( module, size, "__wine_unixlib_handle",
+                                                sizeof(*image.unix_handle_slot), IMAGE_SCN_MEM_WRITE );
+    if (!image.LdrSystemDllInitBlock || !image.syscall_slot || !image.unix_call_slot || !image.unix_handle_slot)
+        return STATUS_PROCEDURE_NOT_FOUND;
+    if (metadata)
+    {
+        void *ctrl_routine;
+        image.KiUserEmulationDispatcher = ios_ntdll_export( module, size, "KiUserEmulationDispatcher", 1,
+                                                            IMAGE_SCN_MEM_EXECUTE );
+        image.unix_call_arm64ec_slot = ios_ntdll_export( module, size, "__wine_unix_call_dispatcher_arm64ec",
+                                                         sizeof(*image.unix_call_arm64ec_slot), IMAGE_SCN_MEM_WRITE );
+        if (!image.KiUserEmulationDispatcher || !image.unix_call_arm64ec_slot) return STATUS_PROCEDURE_NOT_FOUND;
+        /* Same redirection the root applies after its own export lookup;
+         * __wine_ctrl_routine stays the exported thunk there as well. */
+        ctrl_routine = image.__wine_ctrl_routine;
+#define IOS_REDIRECT_CALLBACK(name) \
+        if (!(image.name = ios_ntdll_ec_redirect( module, size, metadata, image.name ))) \
+            return STATUS_INVALID_IMAGE_FORMAT;
+        IOS_NTDLL_CALLBACKS(IOS_REDIRECT_CALLBACK)
+        IOS_REDIRECT_CALLBACK(KiUserEmulationDispatcher)
+#undef IOS_REDIRECT_CALLBACK
+        image.__wine_ctrl_routine = ctrl_routine;
+    }
+    /* Writable exports must be naturally aligned and disjoint. Otherwise
+     * binding one slot could corrupt another slot or the loader data block. */
+    {
+        UINT_PTR starts[] = { (UINT_PTR)image.LdrSystemDllInitBlock, (UINT_PTR)image.syscall_slot,
+                              (UINT_PTR)image.unix_call_slot, (UINT_PTR)image.unix_handle_slot,
+                              (UINT_PTR)image.unix_call_arm64ec_slot };
+        SIZE_T lengths[] = { sizeof(*image.LdrSystemDllInitBlock), sizeof(void *),
+                             sizeof(void *), sizeof(UINT_PTR), sizeof(void *) };
+        unsigned int i, j, count = metadata ? 5 : 4;
+        for (i = 0; i < count; ++i)
+        {
+            if (starts[i] % sizeof(void *)) return STATUS_INVALID_IMAGE_FORMAT;
+            for (j = 0; j < i; ++j)
+                if (starts[i] < starts[j] + lengths[j] && starts[j] < starts[i] + lengths[i])
+                    return STATUS_INVALID_IMAGE_FORMAT;
+        }
+    }
+    *image.syscall_slot = dispatch->syscall;
+    *image.unix_handle_slot = dispatch->unix_handle;
+    if (metadata)
+    {
+        /* Route PE unix calls through the EC dispatcher, which then reaches
+         * the Unix one: the same swap the root performs on its own image. */
