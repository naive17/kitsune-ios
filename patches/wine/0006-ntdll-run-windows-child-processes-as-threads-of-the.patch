+NTSTATUS ios_spawn_threaded_child( int socketfd, char **argv, USHORT machine )
+{
+    struct ios_child_boot *boot;
+    pthread_attr_t attr;
+    pthread_t thread;
+    sigset_t oldmask;
+    SIZE_T size = 0x10000;
+    NTSTATUS status;
+    int fd = -1, ret;
+    /* Native ARM64 or x64 (ARM64EC + emulator) children, from any owner.
+     * The child's own state decides is_arm64ec(); root globals are untouched. */
+    if (current_machine != IMAGE_FILE_MACHINE_ARM64 ||
+        (machine != IMAGE_FILE_MACHINE_ARM64 && machine != IMAGE_FILE_MACHINE_AMD64))
+        return STATUS_NOT_SUPPORTED;
