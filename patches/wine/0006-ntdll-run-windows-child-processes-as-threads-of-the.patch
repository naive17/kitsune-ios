+    pthread_attr_init( &attr );
+    pthread_attr_setguardsize( &attr, 0 );
+    ret = pthread_attr_setstack( &attr, get_kernel_stack( boot->data ), kernel_stack_size );
+    if (ret) ERR( "ios: threaded child: pthread_attr_setstack(%p, %#zx) failed: %s\n",
