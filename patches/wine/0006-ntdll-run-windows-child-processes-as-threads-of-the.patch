+             strerror( ret ), get_kernel_stack( boot->data ) );
+    pthread_attr_destroy( &attr );
+    pthread_sigmask( SIG_SETMASK, &oldmask, NULL );
+    if (!ret) return STATUS_SUCCESS;
+    status = STATUS_NO_MEMORY;
+failed:
+    if (fd >= 0) close( fd );
+    if (boot->data) virtual_free_thread_data( boot->data );
+    if (boot->peb) { size = 0; NtFreeVirtualMemory( NtCurrentProcess(), (void **)&boot->peb, &size, MEM_RELEASE ); }
+    free( boot );
+    return status;
+}
