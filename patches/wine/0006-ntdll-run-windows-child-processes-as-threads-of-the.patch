+    boot->state.child = TRUE;
+    boot->state.threads = 1;
+    boot->state.image.Machine = machine;
+    boot->state.cookie = 0xdeadbeef;
+    boot->state.argv = argv;
+    while (argv[boot->state.argc]) ++boot->state.argc;
+    boot->state.private_ntdll = &boot->ntdll;
