+
+static void *ios_child_entry( void *arg )
+{
+    struct ios_child_boot *boot = arg;
+    NTSTATUS status;
+    void *callbacks[IOS_CALLBACK_COUNT] = {0};
+    boot->data->pthread_id = pthread_self();
+    pthread_setspecific( thread_data_key, boot->data );
+    if ((status = virtual_alloc_teb( boot->data ))) goto failed;
+    if ((status = ios_server_init_child( &boot->state.startup_size ))) goto failed;
+    init_startup_info();
+    set_load_order_app_name( process_main_wargv[0] );
+    if ((status = init_thread_stack( boot->data->teb, 0, 0, 0 ))) goto failed;
+    if ((status = NtCreateKeyedEvent( &process_keyed_event, GENERIC_READ | GENERIC_WRITE, NULL, 0 ))) goto failed;
+    if ((status = ios_prepare_private_ntdll( &boot->ntdll ))) goto failed;
+    if (is_arm64ec())
+    {
+        /* One EC code bitmap per Mach address space: the private ntdll view
+         * just registered its ranges there. FEX and RtlIsEcCode read it
+         * through this owner's PEB, which is not the root's. */
+        const void *map_base;
+        size_t map_size;
+        if (!boot->ntdll.KiUserEmulationDispatcher || !ios_ec_map_range( &map_base, &map_size ))
+        {
+            status = STATUS_INVALID_IMAGE_FORMAT;
+            goto failed;
+        }
+        boot->peb->EcCodeBitMap = (void *)map_base;
+    }
