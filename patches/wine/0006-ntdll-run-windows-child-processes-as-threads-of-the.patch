+/* The boot record stays alive after initial-thread exit: sibling/system
+ * threads retain its context. Full image/PEB retirement is a separate step. */
+struct ios_child_boot
+{
+    struct ios_process_state state;
+    struct ios_ntdll_image ntdll;
+    struct thread_data *data;
+    PEB *peb;
