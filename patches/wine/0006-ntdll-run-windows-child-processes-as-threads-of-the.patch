+static void *ios_reaper_main( void *arg )
+{
+    (void)arg;
+    for (;;)
+    {
+        struct ios_process_context *ctx;
+        unsigned i;
+        pthread_mutex_lock( &ios_reap_lock );
+        while (ios_reap_head == ios_reap_tail) pthread_cond_wait( &ios_reap_cond, &ios_reap_lock );
+        ctx = ios_reap_queue[ios_reap_head % 256];
+        ios_reap_head++;
+        pthread_mutex_unlock( &ios_reap_lock );
+
+        /* Join every thread this owner registered. Each registered before it
+         * dropped its reference, so reap_count is complete once refs hit 0.
+         * pthread_join returns only after a thread has fully exited; only then
+         * are its stack and TEB freed (exit_thread leaves child threads here). */
+        for (i = 0; i < ctx->reap_count; i++)
+        {
+            pthread_join( ctx->reap[i].thread, NULL );
+            if (ctx->reap[i].data) virtual_free_thread_data( ctx->reap[i].data );
+        }
+        if (!ctx->reap_overflow) ios_reclaim_owner_arena_views( ctx->peb );
+        else fprintf( stderr, "ios: reaper skipped reclamation for child peb %p (thread list out of memory)\n", ctx->peb );
