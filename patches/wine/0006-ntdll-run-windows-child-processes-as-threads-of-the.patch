+static void ios_reaper_enqueue( struct ios_process_context *ctx )
+{
+    pthread_mutex_lock( &ios_reap_lock );
+    if (!ios_reaper_started)
+    {
+        pthread_t t;
+        if (!pthread_create( &t, NULL, ios_reaper_main, NULL )) { pthread_detach( t ); ios_reaper_started = 1; }
+    }
+    if (ios_reaper_started && ios_reap_tail - ios_reap_head < 256)
+    {
+        ios_reap_queue[ios_reap_tail % 256] = ctx;
+        ios_reap_tail++;
+        pthread_cond_signal( &ios_reap_cond );
+        pthread_mutex_unlock( &ios_reap_lock );
+        return;
+    }
