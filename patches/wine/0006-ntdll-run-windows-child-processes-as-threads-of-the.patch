+        if ((i = ios_retire_fd_cache( ctx->peb )))
+            fprintf( stderr, "ios: reaper closed %u cached descriptors for retired child peb %p\n", i, ctx->peb );
+        ios_proc_destroy( ctx );
+    }
+    return NULL;
+}
