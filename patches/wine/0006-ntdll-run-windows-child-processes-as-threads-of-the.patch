diff --git a/dlls/ntdll/unix/ios_process_context.h b/dlls/ntdll/unix/ios_process_context.h
new file mode 100644
index 0000000000000000000000000000000000000000..bb70946755568b223db027c6cf47c6d9b4f2bdd1
--- /dev/null
+++ b/dlls/ntdll/unix/ios_process_context.h
@@ -0,0 +1,178 @@
+#ifndef KITSUNE_PROCESS_CONTEXT_H
+#define KITSUNE_PROCESS_CONTEXT_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "ios_process_callbacks.h"
+
+struct thread_data;
+
+struct ios_process_context
+{
+    pthread_mutex_t lock;
+    unsigned int refs;
+    unsigned int windows_pid;
+    int exiting;
+    int socket;              /* immutable; owned until the final release */
+    void *peb;               /* identity only: loader still owns this memory */
+    void *callbacks[IOS_CALLBACK_COUNT]; /* immutable after publication */
+    unsigned int callbacks_ready;
+    struct ios_process_state *state; /* shared by this owner's retained threads */
+    /* Every thread of this owner that exited, which the reaper joins and
+     * frees, each exactly once. Grows: Chromium starts and ends hundreds. */
+    struct ios_reap_entry { pthread_t thread; struct thread_data *data; } *reap;
+    unsigned int reap_count, reap_cap;
+    int reap_overflow;   /* out of memory for the list: do not reclaim, only free */
+};
+
+/* On success consumes fd and returns the initial thread's reference. On
+ * failure the caller still owns fd. No caller may close/reuse a consumed fd. */
+static inline struct ios_process_context *ios_proc_create( void *peb, int fd )
+{
+    struct ios_process_context *ctx;
+    int flags, err;
+    if (!peb || fd < 0) { errno = EINVAL; return NULL; }
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return NULL;
+    if ((err = pthread_mutex_init( &ctx->lock, NULL )))
+    {
+        free( ctx );
+        errno = err;
+        return NULL;
+    }
+    if ((flags = fcntl( fd, F_GETFD )) == -1 || fcntl( fd, F_SETFD, flags | FD_CLOEXEC ) == -1)
+    {
+        err = errno;
+        pthread_mutex_destroy( &ctx->lock );
+        free( ctx );
+        errno = err;
+        return NULL;
+    }
+    ctx->refs = 1;
+    ctx->socket = fd;
+    ctx->peb = peb;
+    return ctx;
+}
+
+/* The server assigns identity before any sibling can be published. */
+static inline int ios_proc_set_pid( struct ios_process_context *ctx, unsigned int pid )
+{
+    int err = 0;
+    if (!ctx || !pid) return EINVAL;
+    pthread_mutex_lock( &ctx->lock );
+    if (ctx->windows_pid || ctx->exiting) err = EINVAL;
+    else ctx->windows_pid = pid;
+    pthread_mutex_unlock( &ctx->lock );
+    return err;
+}
+
+/* Caller must already hold a reference. Retain BEFORE pthread_create so the
+ * parent's exit cannot retire the socket while a new sibling is starting.
+ * A failed pthread_create must release the reserved reference. */
+static inline int ios_proc_inherit( struct ios_process_context *ctx )
+{
+    int err = 0;
+    if (!ctx) return EINVAL;
+    pthread_mutex_lock( &ctx->lock );
+    if (!ctx->windows_pid || ctx->exiting) err = EBUSY;
+    else if (ctx->refs == UINT_MAX) err = EOVERFLOW;
+    else ++ctx->refs;
+    pthread_mutex_unlock( &ctx->lock );
+    return err;
+}
+
+/* Bind before publishing siblings. Values belong to this process's PE image;
+ * retaining the context is necessary but not sufficient to free that image.
+ * Acquire/release publication lets signal handlers read without taking locks. */
+static inline int ios_proc_init_callbacks( struct ios_process_context *ctx, void *const *callbacks )
+{
+    int err = 0;
+    unsigned int i;
+    if (!ctx || !callbacks) return EINVAL;
+    for (i = 0; i < IOS_CALLBACK_COUNT; ++i)
+        if (i != IOS_CALLBACK_KiUserEmulationDispatcher && !callbacks[i]) return EINVAL;
+    pthread_mutex_lock( &ctx->lock );
+    if (ctx->refs != 1 || ctx->exiting || __atomic_load_n( &ctx->callbacks_ready, __ATOMIC_RELAXED ))
+        err = EBUSY;
+    else
+    {
+        for (i = 0; i < IOS_CALLBACK_COUNT; ++i) ctx->callbacks[i] = callbacks[i];
+        __atomic_store_n( &ctx->callbacks_ready, 1, __ATOMIC_RELEASE );
+    }
+    pthread_mutex_unlock( &ctx->lock );
+    return err;
+}
+
+static inline void *ios_proc_callback( struct ios_process_context *ctx, enum ios_process_callback which )
+{
+    if (!ctx || (unsigned int)which >= IOS_CALLBACK_COUNT ||
+        !__atomic_load_n( &ctx->callbacks_ready, __ATOMIC_ACQUIRE )) return NULL;
+    return ctx->callbacks[which];
+}
+
+static inline void ios_proc_begin_exit( struct ios_process_context *ctx )
+{
+    pthread_mutex_lock( &ctx->lock );
+    ctx->exiting = 1;
+    pthread_mutex_unlock( &ctx->lock );
+}
+
+static inline int ios_proc_is_exiting( struct ios_process_context *ctx )
+{
+    int result;
+    pthread_mutex_lock( &ctx->lock );
+    result = ctx->exiting;
+    pthread_mutex_unlock( &ctx->lock );
+    return result;
+}
+
+/* Register the calling thread for the reaper to join, before it releases its
+ * reference. Child owners only. */
+static inline void ios_proc_register_exit( struct ios_process_context *ctx, pthread_t self,
+                                           struct thread_data *data )
+{
+    if (!ctx) return;
+    pthread_mutex_lock( &ctx->lock );
+    if (ctx->reap_count == ctx->reap_cap)
+    {
+        unsigned int cap = ctx->reap_cap ? ctx->reap_cap * 2 : 32;
+        struct ios_reap_entry *grown = realloc( ctx->reap, cap * sizeof(*grown) );
+        if (grown) { ctx->reap = grown; ctx->reap_cap = cap; }
+    }
+    if (ctx->reap_count < ctx->reap_cap)
+    {
+        ctx->reap[ctx->reap_count].thread = self;
+        ctx->reap[ctx->reap_count].data = data;
+        ctx->reap_count++;
+    }
+    else ctx->reap_overflow = 1;
+    pthread_mutex_unlock( &ctx->lock );
+}
+
+/* Decrement without freeing; returns nonzero if this was the last reference so
+ * the caller can hand a child owner to the reaper (which frees it) or free a
+ * root owner inline. */
+static inline int ios_proc_release_islast( struct ios_process_context *ctx )
+{
+    int last;
+    if (!ctx) return 0;
+    pthread_mutex_lock( &ctx->lock );
+    last = !--ctx->refs;
+    pthread_mutex_unlock( &ctx->lock );
+    return last;
+}
+
+/* Final teardown the reaper (or an inline root release) performs. */
+static inline void ios_proc_destroy( struct ios_process_context *ctx )
+{
+    if (!ctx) return;
+    close( ctx->socket );
+    pthread_mutex_destroy( &ctx->lock );
+    free( ctx->reap );
+    free( ctx );
+}
+
+#endif
