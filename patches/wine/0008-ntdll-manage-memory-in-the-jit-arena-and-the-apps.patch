+/*
+ * A contiguous pool for oversized reservations, taken while the address space
+ * is still clean.
+ *
+ * The emulator reserves 2x512 MB plus 272 MB of GUEST address space
+ * (MEM_RESERVE|MEM_TOP_DOWN, PAGE_READWRITE -- address space, not executable
+ * memory). On device the second one fails, and the measurement says exactly
+ * why:
+ *
+ *   [ios-mmap] kernel choice FAILED for 0x20010000 bytes prot 0:
+ *              Cannot allocate memory (12). half the size would work
+ *              -> a size limit
+ *
+ * Not memory -- the phone had 2.5 GB free -- and not protection, since the
+ * request was already PROT_NONE. It is contiguity: by the time the emulator
+ * asks, the process has the arena, its alias, dyld and every loaded image
+ * scattered through the space, and no single hole 512 MB wide is left. An
+ * unhinted 4 GB mmap succeeds at startup and cannot be had later, which is the
+ * whole reason this exists.
+ *
+ * So take the space FIRST, when one large hole still exists, and hand pieces of
+ * it out afterwards. Same trick as the JIT arena, for the same reason.
+ *
+ * Descending ladder rather than one size: how much is available depends on the
+ * device and on what LiveContainer has already mapped, and a pool that is
+ * merely smaller is far better than no pool. PROT_NONE, because this is a
+ * reservation -- map_view mprotects the parts it actually commits.
+ *
+ * Bump-allocated and never freed. Wine unmaps a view's memory when it goes, so
+ * a freed range inside the pool would be a hole the kernel could hand to
+ * someone else, and the pool would stop being contiguous. These reservations
+ * live for the life of the process in practice; leaking address space that was
+ * only ever going to be reserved anyway costs nothing.
+ */
+static char *bigpool_base, *bigpool_next, *bigpool_end;
+
+static int      ios_swap_fd = -1;
+static char    *ios_swap_lo = (char *)0x7000000000ULL;
+static char    *ios_swap_hi = (char *)0x8000000000ULL;
+static size_t   ios_swap_mapped, ios_swap_punched;
+static unsigned ios_swap_maps;
+#define IOS_SWAP_RW       1u
+#define IOS_SWAP_RESERVE  2u
+static unsigned ios_swap_mask = IOS_SWAP_RW | IOS_SWAP_RESERVE;
+static const size_t ios_swap_min_view = 4u << 20;
+static unsigned char *ios_swap_occ;
+static size_t ios_swap_occ_pages;
+
+static inline size_t swap_occ_index( const void *p ) { return ((const char *)p - ios_swap_lo) / host_page_size; }
+static int swap_occ_any( const void *start, size_t size )
+{
+    size_t i = swap_occ_index( start ), n = (size + host_page_size - 1) / host_page_size;
+    if (!ios_swap_occ) return 1;   /* no bitmap: assume occupied, punch */
+    for (; n; n--, i++) if (ios_swap_occ[i >> 3] & (1u << (i & 7))) return 1;
+    return 0;
+}
+static void swap_occ_set( const void *start, size_t size, int on )
+{
+    size_t i = swap_occ_index( start ), n = (size + host_page_size - 1) / host_page_size;
+    if (!ios_swap_occ) return;
+    for (; n; n--, i++)
+    {
+        if (on) ios_swap_occ[i >> 3] |= (unsigned char)(1u << (i & 7));
+        else    ios_swap_occ[i >> 3] &= (unsigned char)~(1u << (i & 7));
+    }
