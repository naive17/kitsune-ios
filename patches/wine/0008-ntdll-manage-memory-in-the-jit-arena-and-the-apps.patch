+static void ios_dump_modules(void)
+{
+    PEB_LDR_DATA *ldr = NtCurrentTeb()->Peb->LdrData;
+    LIST_ENTRY *head, *e;
+
+    if (!ldr || !ldr->Initialized) return;
+    head = &ldr->InMemoryOrderModuleList;
+    for (e = head->Flink; e && e != head; e = e->Flink)
+    {
+        LDR_DATA_TABLE_ENTRY *m = CONTAINING_RECORD( e, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks );
+        const char *hdr = (const char *)m->DllBase;
+        char path[260];
+        unsigned int i, n;
+        unsigned lfanew;
+
+        if (!hdr) continue;
+        n = m->FullDllName.Length / sizeof(WCHAR);
+        if (n > sizeof(path) - 1) n = sizeof(path) - 1;
+        for (i = 0; i < n; i++) path[i] = (char)m->FullDllName.Buffer[i];
+        path[n] = 0;
+        lfanew = *(const unsigned *)(hdr + 0x3c);
+        fprintf( stderr, "[ios-module] %-56s base %p size %#010x stamp %08x\n", path, m->DllBase,
+                 (unsigned)m->SizeOfImage, *(const unsigned *)(hdr + lfanew + 8) );
+    }
+}
