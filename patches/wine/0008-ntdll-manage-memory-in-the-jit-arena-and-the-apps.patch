+static int ios_name_pe( unsigned long addr, char *buf, size_t len )
+{
+    PEB_LDR_DATA *ldr = NtCurrentTeb()->Peb->LdrData;
+    LIST_ENTRY *head, *e;
+    unsigned int guard = 0;
+
+    if (!ldr || !ldr->Initialized) return 0;
+    head = &ldr->InMemoryOrderModuleList;
+    if (!ios_safe_read( (unsigned long)&head->Flink, &e, sizeof(e) )) return 0;
+    while (e && e != head && guard++ < 1024)
+    {
+        LDR_DATA_TABLE_ENTRY m;
+        char name[64];
+        WCHAR wname[63];
+        unsigned int i, n;
+        unsigned long base;
+
+        if (!ios_safe_read( (unsigned long)CONTAINING_RECORD( e, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks ),
+                            &m, sizeof(m) )) return 0;
+        base = (unsigned long)m.DllBase;
+        if (addr >= base && addr < base + m.SizeOfImage)
+        {
+            n = m.BaseDllName.Length / sizeof(WCHAR);
+            if (n > 63) n = 63;
+            if (!ios_safe_read( (unsigned long)m.BaseDllName.Buffer, wname, n * sizeof(WCHAR) )) n = 0;
+            for (i = 0; i < n; i++) name[i] = (char)wname[i];
+            name[n] = 0;
+            snprintf( buf, len, "%s+%#lx", name, addr - base );
+            return 1;
+        }
+        e = m.InMemoryOrderLinks.Flink;
+    }
+    return 0;
+}
