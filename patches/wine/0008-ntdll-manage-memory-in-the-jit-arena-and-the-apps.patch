+static void bigpool_record_free( char *base, size_t size )
+{
+    char *end = base + size;
+    struct bigpool_free *prev = NULL, *cur = bigpool_freelist, *node;
+
+    while (cur && cur->base < base) { prev = cur; cur = cur->link; }
+
+    if (prev && prev->end == base)            /* merge with predecessor */
+    {
+        prev->end = end;
+        if (cur && prev->end == cur->base) { prev->end = cur->end; prev->link = cur->link; free( cur ); }
+        return;
+    }
+    if (cur && end == cur->base) { cur->base = base; return; }   /* merge with successor */
+
+    node = malloc( sizeof(*node) );
+    if (!node) return;   /* hole simply not reused; correctness preserved */
+    node->base = base; node->end = end; node->link = cur;
+    if (prev) prev->link = node; else bigpool_freelist = node;
