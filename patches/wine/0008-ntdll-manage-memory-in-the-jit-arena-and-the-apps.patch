+static void ios_dump_frames( const char *tag )
+{
+    unsigned long fp = (unsigned long)__builtin_frame_address(0), prev = 0;
+    int depth;
+
+    for (depth = 0; depth < 12 && fp && fp > prev && !(fp & 15); depth++)
+    {
+        unsigned long next = ((unsigned long *)fp)[0];
+        unsigned long ret  = ((unsigned long *)fp)[1];
+        char pe[96];
+        Dl_info fi;
+        const char *fmod = "?", *fsym = "?";
+        unsigned long off = 0;
+
+        if (!ret) break;
+        if (dladdr( (void *)ret, &fi ))
+        {
+            if (fi.dli_fname)
+                fmod = strrchr( fi.dli_fname, '/' ) ? strrchr( fi.dli_fname, '/' ) + 1 : fi.dli_fname;
+            if (fi.dli_sname) fsym = fi.dli_sname;
+            if (fi.dli_saddr) off = (unsigned long)((char *)ret - (char *)fi.dli_saddr);
+            fprintf( stderr, "[%s] #%d %p %s!%s +%#lx\n", tag, depth, (void *)ret, fmod, fsym, off );
+        }
+        else
+        {
+            /* Not a dylib address, so the unix chain has ended and everything
+               past here is residue on the kernel stack. Say so and stop -- the
+               PE side is walked separately, from the saved syscall frame. */
+            if (ios_name_pe( ret, pe, sizeof(pe) ))
+                fprintf( stderr, "[%s] #%d %p %s (residue, chain ends)\n", tag, depth, (void *)ret, pe );
+            break;
+        }
+        prev = fp;
+        fp = next;
+    }
+}
