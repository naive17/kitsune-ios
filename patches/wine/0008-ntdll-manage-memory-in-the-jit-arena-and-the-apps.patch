+    if (!env || !*env || *env == '0') return;
+    if (!(dir = getenv( "TMPDIR" )) || !*dir)
+    {
+        ERR( "ios: swap: no TMPDIR in the environment; pool commits stay anonymous\n" );
+        return;
+    }
+    snprintf( path, sizeof path, "%s/kitsune-swap-%d", dir, (int)getpid() );
