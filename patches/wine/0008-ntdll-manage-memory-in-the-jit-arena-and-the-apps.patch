+/* The memory a program's own code allocates or maps belongs to its process,
+ * so these four syscalls mark what they create for the reaper, which frees it
+ * when a threaded child dies. Wine's own calls to them are left unmarked. */
+NTSTATUS WINAPI ios_owned_NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR zero_bits,
+                                                   SIZE_T *size, ULONG type, ULONG protect )
+{
+    NTSTATUS status;
+
+    ios_view_owner_enter();
+    status = NtAllocateVirtualMemory( process, ret, zero_bits, size, type, protect );
+    ios_view_owner_leave();
+    return status;
+}
