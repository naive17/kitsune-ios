+    {
+        ERR( "ios: swap: cannot create %s (%s); pool commits stay anonymous\n", path, strerror( errno ) );
+        return;
+    }
+    unlink( path );   /* nameless from here on: vanishes with the process, invisible to Files */
+    if (ftruncate( fd, (off_t)(ios_swap_hi - ios_swap_lo) ) != 0)
+    {
