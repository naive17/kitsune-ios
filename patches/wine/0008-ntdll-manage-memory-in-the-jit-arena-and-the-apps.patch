+/* True if [p,p+size) lies wholly inside a reserved bigpool segment. */
+static int bigpool_owns_range( const char *p, size_t size )
+{
+    struct bigpool_seg *seg;
+    if (bigpool_base && p >= bigpool_base && p + size <= bigpool_end) return 1;
+    for (seg = bigpool_extra_segs; seg; seg = seg->link)
