dlls: Read KUSER_SHARED_DATA at its iOS address.

The Win32 side reads KUSER_SHARED_DATA at WINE_USER_SHARED_DATA_ADDR
(ios_shared_data.h, 0002).
---
diff --git a/dlls/kernel32/process.c b/dlls/kernel32/process.c
index 98313f4634c7b0750714fbb400be11e07c202e77..96060d48578eff9af8b49f491c86b2a1c4e68df9 100644
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -36,10 +36,11 @@
 #include "ddk/wdm.h"
 #include "wine/asm.h"
 #include "wine/debug.h"
+#include "wine/ios_shared_data.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(process);
 
-static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)0x7ffe0000;
+static const struct _KUSER_SHARED_DATA *user_shared_data = (struct _KUSER_SHARED_DATA *)(ULONG_PTR)WINE_USER_SHARED_DATA_ADDR;
 
 typedef struct
 {
