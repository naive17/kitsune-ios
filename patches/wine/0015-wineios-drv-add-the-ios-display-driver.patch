+
+WINE_DEFAULT_DEBUG_CHANNEL(wineios);
+
+static const struct user_driver_funcs wineios_drv_funcs =
+{
+    .pCreateWindowSurface = wineios_CreateWindowSurface,
+    .pDestroyWindow = wineios_DestroyWindow,
+    .pWindowPosChanged = wineios_WindowPosChanged,
+    .pUpdateDisplayDevices = wineios_UpdateDisplayDevices,
+};
+
+static NTSTATUS wineios_unix_init( void *arg )
+{
+    if (!wineios_metal_init())
+        ERR( "no Metal device; windows will be created but nothing will be presented\n" );
+
+    __wine_set_user_driver( &wineios_drv_funcs, WINE_GDI_DRIVER_VERSION );
+
+    /* Hand the input entry points to the host. See input.c. */
+    {
+        extern void wineios_input_register_with_host(void);
+        wineios_input_register_with_host();
+    }
+
+    TRACE( "wineios.drv installed\n" );
+    return STATUS_SUCCESS;
+}
+
+extern NTSTATUS wineios_unix_drain( void *arg );
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    wineios_unix_init,
+    wineios_unix_drain,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
