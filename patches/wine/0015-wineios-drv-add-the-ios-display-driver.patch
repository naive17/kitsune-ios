diff --git a/dlls/wineios.drv/wineios_metal.h b/dlls/wineios.drv/wineios_metal.h
new file mode 100644
index 0000000000000000000000000000000000000000..4a9cb58934f20665f84882067637399ac57b844e
--- /dev/null
+++ b/dlls/wineios.drv/wineios_metal.h
@@ -0,0 +1,51 @@
+
+#ifndef __WINE_WINEIOS_METAL_H
+#define __WINE_WINEIOS_METAL_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct wineios_layer;
+
+/* Returns 1 if a Metal device was found. Safe to call more than once. */
+int wineios_metal_init(void);
+
+void wineios_metal_screen_size(int *width, int *height);
+
+enum wineios_layer_role
+{
+    WINEIOS_LAYER_GDI = 0,
+    WINEIOS_LAYER_OVERLAY = 1,
+};
+
+/* One CAMetalLayer per (top-level Windows window, role). x/y are in screen
+ * pixels with the origin top-left, i.e. Windows coordinates, NOT Core
+ * Animation's. */
+struct wineios_layer *wineios_layer_create(void *hwnd, int width, int height, int role);
+void wineios_layer_destroy(struct wineios_layer *layer);
+/* Hide or show a layer; a GDI layer takes its window's overlay along. */
+void wineios_layer_set_hidden(struct wineios_layer *layer, int hidden);
+void wineios_layer_set_geometry(struct wineios_layer *layer, int x, int y,
+                                int width, int height);
+
+/* Upload a top-down 32bpp BGRA image and present it. Returns 1 on success.
+ * Called from the Wine thread that owns the window, never from the host's
+ * main thread. */
+int wineios_layer_present(struct wineios_layer *layer, const void *bits,
+                          int width, int height, int stride);
+
+/* The window's GDI layer: what every caller outside this file means by "the
+ * layer for this window". */
+struct wineios_layer *wineios_layer_for_hwnd(void *hwnd);
+/* Any role, by name. */
+struct wineios_layer *wineios_layer_find(void *hwnd, int role);
+void *wineios_layer_hwnd(struct wineios_layer *layer);
+void wineios_layer_size(struct wineios_layer *layer, int *width, int *height);
+void *wineios_layer_metal_layer(struct wineios_layer *layer);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __WINE_WINEIOS_METAL_H */
