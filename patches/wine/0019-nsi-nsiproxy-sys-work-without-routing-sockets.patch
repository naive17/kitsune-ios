+
+static BOOL nsi_unix_fallback( void )
+{
+    static int available = -1;
+    if (available == -1)
+    {
+        available = !__wine_init_unix_call();
+        ERR( "no \\\\.\\Nsi device; in-process nsiproxy fallback %s\n", available ? "ready" : "UNAVAILABLE" );
+    }
+    return available == 1;
+}
+
+static DWORD nsi_unix_status( NTSTATUS status )
+{
+    if (status == STATUS_BUFFER_OVERFLOW) return ERROR_MORE_DATA;
+    return RtlNtStatusToDosError( status );
+}
