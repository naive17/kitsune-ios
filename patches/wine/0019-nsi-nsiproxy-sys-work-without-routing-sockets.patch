 #include "ws2ipdef.h"
@@ -26,11 +28,42 @@
 #include "netiodef.h"
 #include "wine/nsi.h"
 #include "wine/debug.h"
+#include "wine/unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(nsi);
 
 static HANDLE nsi_device = INVALID_HANDLE_VALUE;
 static HANDLE nsi_device_async = INVALID_HANDLE_VALUE;
+/* The in-process fallback below is adapted from Madeira's Wine fork:
+ * nsi_unix_fallback from willfaust/wine d3d5a179a5, Copyright (C) 2026
+ * Will Faust, and remembering the missing device from 5c4d1f7a6f,
+ * Copyright (C) 2026 125hz. Both LGPL-2.1-or-later. */
+/* Kitsune: set once \\.\Nsi has been found missing. nsiproxy runs in
+ * process here (nsi_unix_fallback), so the device never appears, and
+ * retrying the open cost every NSI call a failing CreateFileW. */
+static LONG nsi_device_missing;
+/* Never signaled: what a change notification waits on when there is no
+ * device to report changes. */
+static HANDLE nsi_no_change_event;
+
+enum { nsi_unix_enumerate_all_ex = 2, nsi_unix_get_all_parameters_ex = 3, nsi_unix_get_parameter_ex = 4 };
+
+static BOOL nsi_unix_fallback( void )
+{
+    static int available = -1;
+    if (available == -1)
+    {
+        available = !__wine_init_unix_call();
+        ERR( "no \\\\.\\Nsi device; in-process nsiproxy fallback %s\n", available ? "ready" : "UNAVAILABLE" );
+    }
+    return available == 1;
+}
+
+static DWORD nsi_unix_status( NTSTATUS status )
+{
+    if (status == STATUS_BUFFER_OVERFLOW) return ERROR_MORE_DATA;
+    return RtlNtStatusToDosError( status );
+}
 
 BOOL WINAPI DllMain(HINSTANCE hinst, DWORD reason, void *reserved)
 {
@@ -54,10 +87,21 @@ static inline HANDLE get_nsi_device( BOOL async )
 
     if (*cached_device == INVALID_HANDLE_VALUE)
     {
+        if (ReadAcquire( &nsi_device_missing ))
+        {
+            SetLastError( ERROR_FILE_NOT_FOUND );
+            return INVALID_HANDLE_VALUE;
+        }
         device = CreateFileW( L"\\\\.\\Nsi", 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
                               async ? FILE_FLAG_OVERLAPPED : 0, NULL );
-        if (device != INVALID_HANDLE_VALUE
-            && InterlockedCompareExchangePointer( cached_device, device, INVALID_HANDLE_VALUE ) != INVALID_HANDLE_VALUE)
+        if (device == INVALID_HANDLE_VALUE)
+        {
+            DWORD err = GetLastError();
+            if (err == ERROR_FILE_NOT_FOUND || err == ERROR_PATH_NOT_FOUND)
+                WriteRelease( &nsi_device_missing, 1 );
+            SetLastError( err );
+        }
+        else if (InterlockedCompareExchangePointer( cached_device, device, INVALID_HANDLE_VALUE ) != INVALID_HANDLE_VALUE)
             CloseHandle( device );
     }
     return *cached_device;
@@ -123,6 +167,15 @@ DWORD WINAPI NsiCancelChangeNotification( OVERLAPPED *ovr )
     TRACE( "%p.\n", ovr );
 
     if (!ovr) return ERROR_NOT_FOUND;
+    if (ReadAcquire( &nsi_device_missing ))
+    {
+        /* A notification held by NsiRequestChangeNotificationEx below. */
+        if (ovr->Internal != STATUS_PENDING) return ERROR_NOT_FOUND;
+        ovr->Internal = STATUS_CANCELLED;
+        ovr->InternalHigh = 0;
+        if (ovr->hEvent) SetEvent( ovr->hEvent );
+        return ERROR_SUCCESS;
+    }
     if (!CancelIoEx(  get_nsi_device( TRUE ), ovr ))
         err = GetLastError();
 
@@ -168,7 +221,12 @@ DWORD WINAPI NsiEnumerateObjectsAllParametersEx( struct nsi_enumerate_all_ex *pa
     struct nsiproxy_enumerate_all in;
     BYTE *out, *ptr;
 
-    if (device == INVALID_HANDLE_VALUE) return GetLastError();
+    if (device == INVALID_HANDLE_VALUE)
+    {
+        DWORD device_err = GetLastError();
+        if (!nsi_unix_fallback()) return device_err;
+        return nsi_unix_status( WINE_UNIX_CALL( nsi_unix_enumerate_all_ex, params ) );
+    }
 
     out_size = sizeof(DWORD) +
         (params->key_size + params->rw_size + params->dynamic_size + params->static_size) * params->count;
@@ -251,7 +309,12 @@ DWORD WINAPI NsiGetAllParametersEx( struct nsi_get_all_parameters_ex *params )
     DWORD err = ERROR_SUCCESS;
     BYTE *out, *ptr;
 
-    if (device == INVALID_HANDLE_VALUE) return GetLastError();
+    if (device == INVALID_HANDLE_VALUE)
+    {
+        DWORD device_err = GetLastError();
+        if (!nsi_unix_fallback()) return device_err;
+        return nsi_unix_status( WINE_UNIX_CALL( nsi_unix_get_all_parameters_ex, params ) );
+    }
 
     in = malloc( in_size );
     out = malloc( out_size );
@@ -318,7 +381,12 @@ DWORD WINAPI NsiGetParameterEx( struct nsi_get_parameter_ex *params )
     ULONG in_size = FIELD_OFFSET( struct nsiproxy_get_parameter, key[params->key_size] ), received;
     DWORD err = ERROR_SUCCESS;
 
-    if (device == INVALID_HANDLE_VALUE) return GetLastError();
+    if (device == INVALID_HANDLE_VALUE)
+    {
+        DWORD device_err = GetLastError();
+        if (!nsi_unix_fallback()) return device_err;
+        return nsi_unix_status( WINE_UNIX_CALL( nsi_unix_get_parameter_ex, params ) );
+    }
 
     in = malloc( in_size );
     if (!in) return ERROR_OUTOFMEMORY;
@@ -365,6 +433,27 @@ DWORD WINAPI NsiRequestChangeNotificationEx( struct nsi_request_change_notificat
 
     if (params->unk) FIXME( "unknown parameter %#lx.\n", params->unk );
 
+    if (device == INVALID_HANDLE_VALUE && ReadAcquire( &nsi_device_missing ))
+    {
+        /* No device, so no changes are ever reported: the request stays
+         * pending, as it does on Windows while the network does not change.
+         * Failing it instead made Steam re-enumerate the adapters and ask
+         * again in a tight loop (~224,000 times in a few minutes). */
+        if (!nsi_no_change_event)
+        {
+            HANDLE event = CreateEventW( NULL, TRUE, FALSE, NULL );
+            if (event && InterlockedCompareExchangePointer( &nsi_no_change_event, event, NULL )) CloseHandle( event );
+        }
+        if (!params->ovr)
+        {
+            WaitForSingleObject( nsi_no_change_event, INFINITE );
+            return ERROR_SUCCESS;
+        }
+        params->ovr->Internal = STATUS_PENDING;
+        params->ovr->InternalHigh = 0;
+        if (params->handle) *params->handle = nsi_no_change_event;
+        return ERROR_IO_PENDING;
+    }
     if (device == INVALID_HANDLE_VALUE) return GetLastError();
 
     in = malloc( in_size );
