crypt32: Take trust roots from the app's CA bundle.

Root certificates come from KITSUNE_CA_BUNDLE, and enum_root_certs
tries again when the store comes back empty.
---
diff --git a/dlls/crypt32/unixlib.c b/dlls/crypt32/unixlib.c
index 4b9f0da0d211259b06673635d95145bf96cda27c..23af26ee74773c0c8de23be2a59eef0ee0e3d8dc 100644
--- a/dlls/crypt32/unixlib.c
+++ b/dlls/crypt32/unixlib.c
@@ -30,6 +30,7 @@
 #include <dlfcn.h>
 #include <sys/stat.h>
 #ifdef __APPLE__
+#include <TargetConditionals.h>
 #include <Security/Security.h>
 #endif
 #ifdef SONAME_LIBGNUTLS
@@ -958,7 +959,7 @@ static void load_root_certs(void)
 {
     unsigned int i;
 
-#ifdef __APPLE__
+#if defined(__APPLE__) && !TARGET_OS_IPHONE
     const SecTrustSettingsDomain domains[] = {
         kSecTrustSettingsDomainSystem,
         kSecTrustSettingsDomainAdmin,
@@ -991,6 +992,21 @@ static void load_root_certs(void)
     }
 #endif
 
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    /* The native host points at the pinned CA bundle in its signed resources.
+     * Do not treat this as iOS keychain enumeration or accept the peer's CA.
+     * Existing PE-side signature/chain verification still validates imports. */
+    {
+        const char *bundle = getenv( "KITSUNE_CA_BUNDLE" );
+        unsigned int n = 0;
+        struct list *e;
+        if (bundle && bundle[0] == '/') import_certs_from_path( bundle, FALSE );
+        LIST_FOR_EACH( e, &root_cert_list ) n++;
+        ERR( "ios: trust roots from KITSUNE_CA_BUNDLE=%s: %u certs\n", bundle ? bundle : "(unset)", n );
+    }
+#endif
+
+    /* An empty store must fail validation, never silently accept peers. */
     for (i = 0; i < ARRAY_SIZE(CRYPT_knownLocations) && list_empty(&root_cert_list); i++)
         import_certs_from_path( CRYPT_knownLocations[i], TRUE );
 }
@@ -1005,7 +1021,11 @@ static NTSTATUS enum_root_certs( void *args )
     if (!loaded) load_root_certs();
     loaded = TRUE;
 
-    if (!(ptr = list_head( &root_cert_list ))) return STATUS_NO_MORE_ENTRIES;
+    if (!(ptr = list_head( &root_cert_list )))
+    {
+        loaded = FALSE;
+        return STATUS_NO_MORE_ENTRIES;
+    }
     cert = LIST_ENTRY( ptr, struct root_cert, entry );
     *params->needed = cert->size;
     if (cert->size <= params->size)
