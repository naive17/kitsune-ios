+#endif
     if (process->unix_pid != -1)
         process->sigkill_timeout = add_timeout_user( -process->sigkill_delay, process_sigkill, process );
     else
@@ -669,7 +774,15 @@ struct process *create_process( int fd, struct process *parent, unsigned int fla
