diff --git a/server/ios_inproc.c b/server/ios_inproc.c
new file mode 100644
index 0000000000000000000000000000000000000000..92ca8f1277ce566f804cae2c861c0506637666b6
--- /dev/null
+++ b/server/ios_inproc.c
@@ -0,0 +1,74 @@
+
+#include "config.h"
+
+#include <signal.h>
+#include <stdio.h>
+
+#include "object.h"
+#include "file.h"
+#include "thread.h"
+#include "request.h"
+
+#if defined(WINE_IOS_JIT_ARENA)
+/* The single-process flavour: wineserver is a thread here, not a process.
+ * Keyed on WINE_IOS_JIT_ARENA rather than !TARGET_OS_OSX so the macOS test
+ * harness (scripts/16-host-harness.sh) builds the same code the device runs. */
+# define WINE_IOS_INPROC_SERVER
+#endif
+
+#ifdef WINE_IOS_INPROC_SERVER
+
+extern const char *server_argv0;
+extern void init_limits(void);
+extern struct fd *load_intl_file(void);
+
+/* The wineserver_inproc_* symbols are explicitly exported: ntdll and the app
+ * find them with dlsym(RTLD_DEFAULT), and the host build compiles with hidden
+ * visibility, which left them local and made start_server() fall back to
+ * spawning a process that cannot exist. */
+__attribute__((visibility("default")))
+int wineserver_inproc_ready = 0;
+
+__attribute__((visibility("default")))
+void wineserver_inproc_flush( void )
+{
+    if (__atomic_load_n( &wineserver_inproc_ready, __ATOMIC_ACQUIRE )) flush_registry();
+}
+
+/* Same supported settings as wineserver -f -p: this server belongs to the
+ * iOS app session, not the last Windows client. Closing a correctly owned
+ * guest socket must not arm the stock three-second exit(0) of the host. */
+static void configure_inproc_lifetime(void)
+{
+    foreground = 1;
+    master_socket_timeout = TIMEOUT_INFINITE;
+}
+
+__attribute__((visibility("default")))
+void *wineserver_inproc_main( void *arg )
+{
+    (void)arg;
+    setvbuf( stderr, NULL, _IOLBF, 0 );
+    server_argv0 = "wineserver";
+
+    signal( SIGPIPE, SIG_IGN );   /* the one handler we do need: writes to dead clients */
+    init_limits();
+
+    configure_inproc_lifetime();
+
+    sock_init();
+    open_master_socket();
+
+    /* Publish only after the socket exists, never before. */
+    __atomic_store_n( &wineserver_inproc_ready, 1, __ATOMIC_RELEASE );
+
+    set_current_time();
+    init_memory();
+    init_directories( load_intl_file() );
+    init_threading();
+    init_registry();
+    main_loop();
+    return NULL;
+}
+
+#endif /* WINE_IOS_INPROC_SERVER */
