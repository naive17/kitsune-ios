diff --git a/server/process.c b/server/process.c
index 94adb19c1c0d681d53fc4fce1bdd4a922433ec8c..df3e5f8758b753a8760dee118117586d32a58ae3 100644
--- a/server/process.c
+++ b/server/process.c
@@ -68,6 +68,95 @@
 
 static struct list process_list = LIST_INIT(process_list);
 static int running_processes, user_processes;
+
+#ifdef WINE_IOS_JIT_ARENA
+/* For the app hosting this server: programs running, not counting Wine's own
+ * system processes. */
+__attribute__((visibility("default"))) int wineserver_inproc_user_processes( void )
+{
+    return __atomic_load_n( &user_processes, __ATOMIC_RELAXED );
+}
+#endif
+
+#ifdef WINE_IOS_JIT_ARENA
+#include <mach/mach.h>
+
+/* For the app's process monitor; same layout as KitsuneProcessInfo in
+ * src/ios/process_monitor.h. */
+struct kitsune_process_info
+{
+    unsigned int       pid, ppid, threads;
+    unsigned int       flags;       /* 1: system process, 2: terminating */
+    unsigned long long cpu_us;      /* user + system time of its live threads */
+    unsigned long long age_ticks;   /* since it started, in 100 ns */
+    char               name[64];    /* exe file name, UTF-8 */
+};
+
+/* The file name of the process's exe, UTF-8, from its NT image path. */
+static void ios_image_file_name( const struct process *process, char *out, size_t size )
+{
+    const WCHAR *img = process->image;
+    data_size_t i, len = process->imagelen / sizeof(WCHAR), start = 0;
+    size_t pos = 0;
+
+    out[0] = 0;
+    if (!img) return;
+    for (i = 0; i < len; i++) if (img[i] == '\\' || img[i] == '/') start = i + 1;
+    for (i = start; i < len && pos + 4 < size; i++)
+    {
+        unsigned int c = img[i];
+
+        if (c >= 0xd800 && c < 0xdc00 && i + 1 < len && img[i + 1] >= 0xdc00 && img[i + 1] < 0xe000)
+            c = 0x10000 + ((c - 0xd800) << 10) + (img[++i] - 0xdc00);
+        if (c < 0x80) out[pos++] = c;
+        else if (c < 0x800) { out[pos++] = 0xc0 | (c >> 6); out[pos++] = 0x80 | (c & 0x3f); }
+        else if (c < 0x10000) { out[pos++] = 0xe0 | (c >> 12); out[pos++] = 0x80 | ((c >> 6) & 0x3f); out[pos++] = 0x80 | (c & 0x3f); }
+        else { out[pos++] = 0xf0 | (c >> 18); out[pos++] = 0x80 | ((c >> 12) & 0x3f); out[pos++] = 0x80 | ((c >> 6) & 0x3f); out[pos++] = 0x80 | (c & 0x3f); }
+    }
+    out[pos] = 0;
+}
+
+/* Every process with a live thread. Each Wine thread is a thread of this app,
+ * and unix_tid is its Mach port name here, so its CPU time is read directly. */
+__attribute__((visibility("default")))
+int wineserver_inproc_process_snapshot( struct kitsune_process_info *out, int max )
+{
+    struct process *process;
+    int n = 0;
+
+    ios_server_lock_acquire();
+    set_current_time();
+    LIST_FOR_EACH_ENTRY( process, &process_list, struct process, entry )
+    {
+        struct kitsune_process_info *info;
+        struct thread *thread;
+
+        if (n >= max) break;
+        if (!process->running_threads) continue;
+        info = &out[n++];
+        memset( info, 0, sizeof(*info) );
+        info->pid = process->id;
+        info->ppid = process->parent_id;
+        info->threads = process->running_threads;
+        info->flags = (process->is_system ? 1 : 0) | (process->is_terminating ? 2 : 0);
+        info->age_ticks = current_time > process->start_time ? current_time - process->start_time : 0;
+        LIST_FOR_EACH_ENTRY( thread, &process->thread_list, struct thread, proc_entry )
+        {
+            thread_basic_info_data_t tbi;
+            mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+
+            if (thread->state == TERMINATED || thread->unix_tid == -1) continue;
+            if (thread_info( (thread_act_t)thread->unix_tid, THREAD_BASIC_INFO,
+                             (thread_info_t)&tbi, &count ) != KERN_SUCCESS) continue;
+            info->cpu_us += (unsigned long long)tbi.user_time.seconds * 1000000 + tbi.user_time.microseconds +
+                            (unsigned long long)tbi.system_time.seconds * 1000000 + tbi.system_time.microseconds;
+        }
+        ios_image_file_name( process, info->name, sizeof(info->name) );
+    }
+    ios_server_lock_release();
+    return n;
+}
+#endif
