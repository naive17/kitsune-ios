+/* Private pointer-free snapshot, not a callback into PE from a UIKit thread.
+ * This keeps every threaded Wine child on its normal syscall/TEB path. */
+#if defined(__APPLE__) && defined(WINE_IOS_JIT_ARENA)
+static pthread_once_t ios_gamepad_once = PTHREAD_ONCE_INIT;
+static void (*ios_gamepad_snapshot)(struct ios_gamepad_info *);
+static void ios_resolve_gamepad(void)
+{
+    ios_gamepad_snapshot = dlsym(RTLD_DEFAULT, "kitsune_gamepad_snapshot_v1");
+}
+#endif
+
+static NTSTATUS ios_query_gamepads(void *info, ULONG size, ULONG *ret_size)
+{
+    if (ret_size) *ret_size = sizeof(struct ios_gamepad_info);
+    if (size != sizeof(struct ios_gamepad_info)) return STATUS_INFO_LENGTH_MISMATCH;
+    if (!info) return STATUS_ACCESS_VIOLATION;
+#if defined(__APPLE__) && defined(WINE_IOS_JIT_ARENA)
+    pthread_once(&ios_gamepad_once, ios_resolve_gamepad);
+    if (!ios_gamepad_snapshot) return STATUS_NOT_SUPPORTED;
+    ios_gamepad_snapshot(info);
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
