+#elif defined(__APPLE__)
+
+static BOOL darwin_has_feature( const char *name )
+{
+    int val = 0;
+    size_t len = sizeof(val);
+    if (sysctlbyname( name, &val, &len, NULL, 0 )) return FALSE;
+    return val != 0;
+}
+
+static DWORD get_core_id_regs_arm64( struct smbios_wine_id_reg_value_arm64 *regs,
+                                     WORD logical_thread_id )
+{
+    UINT64 pfr0 = 0, isar0 = 0, isar1 = 0, mmfr0 = 0, ctr = 0;
+    DWORD regidx = 0;
+    int64_t v64 = 0;
+    size_t len;
+
+#define FEAT(n) darwin_has_feature( "hw.optional.arm." n )
+#define FIELD(shift, value) ((UINT64)(value) << (shift))
+
+    /* ID_AA64PFR0_EL1: FP and AdvSIMD use 0 = present, 1 = present with
+     * half-precision, 0xF = absent. Every Apple core has both. */
+    pfr0 |= FIELD( 0, 2 );                       /* EL0 AArch64+AArch32 */
+    pfr0 |= FIELD( 4, 2 );                       /* EL1 */
+    pfr0 |= FIELD( 16, FEAT("FEAT_FP16") ? 1 : 0 );   /* FP */
+    pfr0 |= FIELD( 20, FEAT("FEAT_FP16") ? 1 : 0 );   /* AdvSIMD */
+
+    /* ID_AA64ISAR0_EL1 */
+    if (FEAT("FEAT_AES"))    isar0 |= FIELD( 4, FEAT("FEAT_PMULL") ? 2 : 1 );
+    if (FEAT("FEAT_SHA1"))   isar0 |= FIELD( 8, 1 );
+    if (FEAT("FEAT_SHA256")) isar0 |= FIELD( 12, FEAT("FEAT_SHA512") ? 2 : 1 );
+    {   /* CRC32 lives outside the arm. subtree */
+        int val = 0; len = sizeof(val);
+        if (!sysctlbyname( "hw.optional.armv8_crc32", &val, &len, NULL, 0 ) && val)
+            isar0 |= FIELD( 16, 1 );
+    }
+    if (FEAT("FEAT_LSE"))     isar0 |= FIELD( 20, 2 );   /* Atomic */
+    if (FEAT("FEAT_RDM"))     isar0 |= FIELD( 28, 1 );
+    if (FEAT("FEAT_SHA3"))    isar0 |= FIELD( 32, 1 );
+    if (FEAT("FEAT_DotProd")) isar0 |= FIELD( 44, 1 );
+    if (FEAT("FEAT_FHM"))     isar0 |= FIELD( 48, 1 );
+    if (FEAT("FEAT_FlagM"))   isar0 |= FIELD( 52, FEAT("FEAT_FlagM2") ? 2 : 1 );
+
+    /* ID_AA64ISAR1_EL1 */
+    if (FEAT("FEAT_DPB"))     isar1 |= FIELD( 0, FEAT("FEAT_DPB2") ? 2 : 1 );
+    if (FEAT("FEAT_JSCVT"))   isar1 |= FIELD( 12, 1 );
+    if (FEAT("FEAT_FCMA"))    isar1 |= FIELD( 16, 1 );
+    if (FEAT("FEAT_LRCPC"))   isar1 |= FIELD( 20, FEAT("FEAT_LRCPC2") ? 2 : 1 );
+    if (FEAT("FEAT_FRINTTS")) isar1 |= FIELD( 32, 1 );
+    if (FEAT("FEAT_SB"))      isar1 |= FIELD( 36, 1 );
+    if (FEAT("FEAT_SPECRES")) isar1 |= FIELD( 40, 1 );
+    if (FEAT("FEAT_BF16"))    isar1 |= FIELD( 44, 1 );
+    if (FEAT("FEAT_I8MM"))    isar1 |= FIELD( 52, 1 );
+
+    /* ID_AA64MMFR0_EL1: 4 KB granule supported, 16 KB supported (Apple's
+     * native page size), 64 KB not. PARange 40-bit is a safe floor. */
+    mmfr0 |= FIELD( 0, 2 );      /* PARange = 40 bits */
+    mmfr0 |= FIELD( 20, 1 );     /* TGran16 = supported */
+    mmfr0 |= FIELD( 28, 0 );     /* TGran4  = supported */
+
+    /* CTR_EL0 from the real cache geometry. IminLine/DminLine are log2 of the
+     * line size in WORDS, not bytes. */
+    len = sizeof(v64);
+    if (sysctlbyname( "hw.cachelinesize", &v64, &len, NULL, 0 ) || v64 <= 0) v64 = 64;
+    {
+        UINT64 words = (UINT64)v64 / 4, l2 = 0;
+        while ((1ull << l2) < words) l2++;
+        ctr  = FIELD( 31, 1 );          /* RES1 */
+        ctr |= FIELD( 0, l2 );          /* IminLine */
+        ctr |= FIELD( 16, l2 );         /* DminLine */
+        ctr |= FIELD( 24, l2 );         /* CWG */
+        ctr |= FIELD( 20, l2 );         /* ERG */
+        ctr |= FIELD( 14, 3 );          /* L1Ip = PIPT */
+    }
+
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4020, pfr0 };
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4030, isar0 };
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4031, isar1 };
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x4038, mmfr0 };
+    regs[regidx++] = (struct smbios_wine_id_reg_value_arm64){ 0x5801, ctr };
+
+    TRACE( "cpu%u synthesised from sysctl: pfr0=%llx isar0=%llx isar1=%llx ctr=%llx\n",
+           logical_thread_id, (unsigned long long)pfr0, (unsigned long long)isar0,
+           (unsigned long long)isar1, (unsigned long long)ctr );
+
+#undef FIELD
+#undef FEAT
+    return regidx;
+}
+
 #else
 
