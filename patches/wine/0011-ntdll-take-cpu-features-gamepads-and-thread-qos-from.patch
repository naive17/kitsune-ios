@@ -2300,6 +2338,70 @@ NTSTATUS WINAPI NtQueryTimer( HANDLE handle, TIMER_INFORMATION_CLASS class,
 /******************************************************************
  *		NtWaitForMultipleObjects (NTDLL.@)
  */
+
+#ifdef WINE_IOS_JIT_ARENA
+#include <dlfcn.h>
+#include <pthread.h>
+#include <pthread/qos.h>
+
+/* Guest thread QoS chosen by the host app's power mode. iOS lets a thread
+ * change only its own QoS, so each thread adopts a change at its next wait.
+ * The host publishes (generation << 8) | class; zero means never set. */
+static const volatile unsigned *ios_qos_state;
+static pthread_key_t ios_qos_key, ios_yield_key;
+static pthread_once_t ios_sync_once = PTHREAD_ONCE_INIT;
+
+static void ios_sync_init(void)
+{
+    ios_qos_state = dlsym( RTLD_DEFAULT, "kitsune_guest_qos_state" );
+    pthread_key_create( &ios_qos_key, NULL );
+    pthread_key_create( &ios_yield_key, NULL );
+}
+
+static void ios_qos_poll(void)
+{
+    unsigned state;
+
+    pthread_once( &ios_sync_once, ios_sync_init );
+    if (!ios_qos_state) return;
+    state = __atomic_load_n( ios_qos_state, __ATOMIC_ACQUIRE );
+    if (!state || state == (unsigned)(uintptr_t)pthread_getspecific( ios_qos_key )) return;
+    pthread_setspecific( ios_qos_key, (void *)(uintptr_t)state );
+    switch (state & 0xff)
+    {
+    case 1: pthread_set_qos_class_self_np( QOS_CLASS_USER_INTERACTIVE, 0 ); break;
+    case 2: pthread_set_qos_class_self_np( QOS_CLASS_USER_INITIATED, 0 ); break;
+    case 3: pthread_set_qos_class_self_np( QOS_CLASS_UTILITY, 0 ); break;
+    default: pthread_set_qos_class_self_np( QOS_CLASS_DEFAULT, 0 ); break;
+    }
+}
+
+/* A thread that yields back to back is spinning on another thread; after a
+ * long streak it sleeps briefly so the core can idle. A 2 ms gap between
+ * yields ends the streak. The key holds (time in 1.024 us units << 16) | count. */
+static void ios_yield_backoff(void)
+{
+    uint64_t now, v, last, count;
+
+    pthread_once( &ios_sync_once, ios_sync_init );
+    now = clock_gettime_nsec_np( CLOCK_UPTIME_RAW ) >> 10;
+    v = (uintptr_t)pthread_getspecific( ios_yield_key );
+    last = v >> 16;
+    count = v & 0xffff;
+    if (now - last > 2000) count = 0;
+    if (++count > 256)
+    {
+        usleep( 100 );
+        count = 0;
+        now = clock_gettime_nsec_np( CLOCK_UPTIME_RAW ) >> 10;
+    }
+    pthread_setspecific( ios_yield_key, (void *)(uintptr_t)((now << 16) | count) );
+}
+#else
+static inline void ios_qos_poll(void) {}
+static inline void ios_yield_backoff(void) {}
+#endif
