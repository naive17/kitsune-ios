+
+/* The server assigns identity before any sibling can be published. */
+static inline int ios_proc_set_pid( struct ios_process_context *ctx, unsigned int pid )
+{
+    int err = 0;
+    if (!ctx || !pid) return EINVAL;
+    pthread_mutex_lock( &ctx->lock );
+    if (ctx->windows_pid || ctx->exiting) err = EINVAL;
+    else ctx->windows_pid = pid;
+    pthread_mutex_unlock( &ctx->lock );
+    return err;
+}
+
+/* Caller must already hold a reference. Retain BEFORE pthread_create so the
+ * parent's exit cannot retire the socket while a new sibling is starting.
+ * A failed pthread_create must release the reserved reference. */
+static inline int ios_proc_inherit( struct ios_process_context *ctx )
+{
+    int err = 0;
+    if (!ctx) return EINVAL;
+    pthread_mutex_lock( &ctx->lock );
+    if (!ctx->windows_pid || ctx->exiting) err = EBUSY;
+    else if (ctx->refs == UINT_MAX) err = EOVERFLOW;
+    else ++ctx->refs;
+    pthread_mutex_unlock( &ctx->lock );
+    return err;
