+static BOOL load_driver_from_env(void)
+{
+    static const char driver_prefix[] = "wine";
+    static const char driver_suffix[] = ".drv";
+    const char *name = getenv( "WINE_DISPLAY_DRIVER" );
+    WCHAR buffer[64];
+    void *ret_ptr;
+    ULONG ret_len, len;
+
+    if (!name || !name[0]) return FALSE;
+    if (strlen( name ) >= ARRAY_SIZE(buffer) - ARRAY_SIZE(driver_prefix) - ARRAY_SIZE(driver_suffix))
+        return FALSE;
+
+    if (strchr( name, '.' ))
+    {
+        len = asciiz_to_unicode( buffer, name );
+    }
+    else
+    {
+        char dll_name[64];
+
+        snprintf( dll_name, sizeof(dll_name), "%s%s%s", driver_prefix, name, driver_suffix );
+        len = asciiz_to_unicode( buffer, dll_name );
+    }
+    TRACE( "loading driver %s (%s) from WINE_DISPLAY_DRIVER\n",
+           debugstr_a(name), debugstr_w(buffer) );
+    if (KeUserModeCallback( NtUserLoadDriver, buffer, len, &ret_ptr, &ret_len )) return FALSE;
+    return user_driver != &lazy_load_driver;
+}
