+/* Per-owner Unix -> PE callback identity. Kitsune authors, 2026.
+ * SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef KITSUNE_PROCESS_CALLBACKS_H
+#define KITSUNE_PROCESS_CALLBACKS_H
+#define IOS_PROCESS_CALLBACKS(X) \
+    X(DbgUiRemoteBreakin) \
+    X(KiRaiseUserExceptionDispatcher) \
