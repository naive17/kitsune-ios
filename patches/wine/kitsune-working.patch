+static BOOL ios_collect_gamepad_events( DWORD pid, const struct ios_gamepad_info *info, struct list *events )
+{
+    struct device_notify *notify, *event;
+    struct ios_gamepad_broadcast broadcast;
+    unsigned int i, mask = 0;
+    BOOL listening = FALSE;
