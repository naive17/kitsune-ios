diff --git a/dlls/winecoreaudio.drv/coreaudio_ios.m b/dlls/winecoreaudio.drv/coreaudio_ios.m
new file mode 100644
index 0000000..18b8bb7
--- /dev/null
+++ b/dlls/winecoreaudio.drv/coreaudio_ios.m
@@ -0,0 +1,49 @@
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <TargetConditionals.h>
+
+#if TARGET_OS_IPHONE
+
+#import <AVFoundation/AVFoundation.h>
+#import <AudioToolbox/AudioToolbox.h>
+
+/* Configure and activate the process-wide audio session so the RemoteIO audio
+ * unit actually produces sound.  Idempotent: safe to call once per stream. */
+OSStatus coreaudio_ios_prepare_audio_session(void)
+{
+    @autoreleasepool {
+        NSError *err = nil;
+        AVAudioSession *session = [AVAudioSession sharedInstance];
+        double slice = 0.010;
+
+        /* fprintf(stderr), not NSLog: NSLog goes to the system console, while
+         * wine-stderr.log is what a silent-audio report comes with. */
+        BOOL ok = [session setCategory:AVAudioSessionCategoryPlayback
+                           withOptions:AVAudioSessionCategoryOptionMixWithOthers
+                                 error:&err];
+        fprintf(stderr, "[winecoreaudio] setCategory(Playback) ok=%d err=%s\n",
+                (int)ok, err ? [[err localizedDescription] UTF8String] : "none");
+        err = nil;
+
+        ok = [session setPreferredIOBufferDuration:slice error:&err];
+        fprintf(stderr, "[winecoreaudio] setPreferredIOBufferDuration(%gms) ok=%d err=%s\n",
+                slice * 1000, (int)ok, err ? [[err localizedDescription] UTF8String] : "none");
+        err = nil;
+
+        ok = [session setActive:YES error:&err];
+        fprintf(stderr, "[winecoreaudio] setActive(YES) ok=%d err=%s  sampleRate=%g "
+                "ioBuffer=%.3fms outputLatency=%.3fms outputChannels=%ld\n",
+                (int)ok, err ? [[err localizedDescription] UTF8String] : "none",
+                [session sampleRate], [session IOBufferDuration] * 1000.0,
+                [session outputLatency] * 1000.0,
+                (long)[session outputNumberOfChannels]);
+        if (!ok) return -1;
+    }
+    return noErr;
+}
+
+#endif /* TARGET_OS_IPHONE */
