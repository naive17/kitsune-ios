@@ -0,0 +1,51 @@
+
+#ifndef __WINE_WINEIOS_METAL_H
+#define __WINE_WINEIOS_METAL_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct wineios_layer;
+
+/* Returns 1 if a Metal device was found. Safe to call more than once. */
+int wineios_metal_init(void);
+
+void wineios_metal_screen_size(int *width, int *height);
+
+enum wineios_layer_role
+{
+    WINEIOS_LAYER_GDI = 0,
+    WINEIOS_LAYER_OVERLAY = 1,
+};
+
+/* One CAMetalLayer per (top-level Windows window, role). x/y are in screen
+ * pixels with the origin top-left, i.e. Windows coordinates, NOT Core
+ * Animation's. */
+struct wineios_layer *wineios_layer_create(void *hwnd, int width, int height, int role);
+void wineios_layer_destroy(struct wineios_layer *layer);
+/* Hide or show a layer; a GDI layer takes its window's overlay along. */
+void wineios_layer_set_hidden(struct wineios_layer *layer, int hidden);
+void wineios_layer_set_geometry(struct wineios_layer *layer, int x, int y,
+                                int width, int height);
+
+/* Upload a top-down 32bpp BGRA image and present it. Returns 1 on success.
+ * Called from the Wine thread that owns the window, never from the host's
+ * main thread. */
+int wineios_layer_present(struct wineios_layer *layer, const void *bits,
+                          int width, int height, int stride);
+
+/* The window's GDI layer: what every caller outside this file means by "the
+ * layer for this window". */
+struct wineios_layer *wineios_layer_for_hwnd(void *hwnd);
+/* Any role, by name. */
+struct wineios_layer *wineios_layer_find(void *hwnd, int role);
+void *wineios_layer_hwnd(struct wineios_layer *layer);
+void wineios_layer_size(struct wineios_layer *layer, int *width, int *height);
+void *wineios_layer_metal_layer(struct wineios_layer *layer);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __WINE_WINEIOS_METAL_H */
diff --git a/dlls/xinput1_3/main.c b/dlls/xinput1_3/main.c
index 8530b02..0dadd95 100644
--- a/dlls/xinput1_3/main.c
+++ b/dlls/xinput1_3/main.c
@@ -43,6 +43,7 @@
 #include "xinput.h"
 
 #include "wine/debug.h"
+#include "wine/ios_gamepad.h"
 
 DEFINE_GUID(GUID_DEVINTERFACE_WINEXINPUT,0x6c53d5fd,0x6480,0x440f,0xb6,0x18,0x47,0x67,0x50,0xc5,0xe1,0xa6);
 
@@ -100,6 +101,174 @@ static HANDLE update_event;
 static SRWLOCK state_lock = SRWLOCK_INIT;
 static XINPUT_STATE current_state[XUSER_MAX_COUNT];
 
+/* iOS has GameController.framework, not the desktop HID bus. The private
+ * syscall copies native snapshots, so no guest thread waits on UIKit or HID
+ * discovery. The ordinary Wine backend is unchanged when the host lacks it. */
+static BOOL ios_backend;
+static BOOL ios_trace;
+static LONG ios_caps_traces;
+
+static BOOL ios_dsr_read( uintptr_t address, void *data, SIZE_T size )
+{
+    SIZE_T read = 0;
+    if (address < 0x10000 || address > UINTPTR_MAX - size) return FALSE;
+    return !NtReadVirtualMemory( GetCurrentProcess(), (const void *)address, data, size, &read ) && read == size;
+}
+
+static BOOL ios_dsr_match( uintptr_t address, const char *bytes, SIZE_T size )
+{
+    char data[32];
+    return size <= sizeof(data) && ios_dsr_read( address, data, size ) && !memcmp( data, bytes, size );
+}
+
+static uintptr_t ios_dsr_image(void)
+{
+    uintptr_t base = (uintptr_t)GetModuleHandleW( NULL );
+    DWORD pe, signature, stamp, size;
+    WORD dos, machine, magic;
+    if (!base || !ios_dsr_read( base, &dos, sizeof(dos) ) || dos != 0x5a4d ||
+        !ios_dsr_read( base + 0x3c, &pe, sizeof(pe) ) || pe > 0x1000 ||
+        !ios_dsr_read( base + pe, &signature, sizeof(signature) ) || signature != 0x4550 ||
+        !ios_dsr_read( base + pe + 4, &machine, sizeof(machine) ) || machine != 0x8664 ||
+        !ios_dsr_read( base + pe + 8, &stamp, sizeof(stamp) ) || stamp != 0x6344ca56 ||
+        !ios_dsr_read( base + pe + 24, &magic, sizeof(magic) ) || magic != 0x20b ||
+        !ios_dsr_read( base + pe + 80, &size, sizeof(size) ) || size != 0x319b000)
+        return 0;
+    /* Binding-manager global reference, binding vector layout, refresh code. */
+    if (!ios_dsr_match( base + 0x54c3bb, "\x48\x8b\x0d\x5e\x90\x76\x01\xe8\x79\x58\x74\x00", 12 ) ||
+        !ios_dsr_match( base + 0xc91c8c, "\x48\x8b\x5e\x08\x4c\x89\x74\x24\x50\x48\x3b\x5e\x10", 13 ) ||
+        !ios_dsr_match( base + 0xc96330, "\x48\x89\x5c\x24\x08\x48\x89\x6c\x24\x10\x48\x89\x74\x24\x18\x57\x48\x83\xec\x20", 20 ))
+        return 0;
+    return base;
+}
+
+static BOOL ios_dsr_bindings_ready( uintptr_t base )
+{
+    uint64_t address, manager[3], entry;
+    DWORD type;
+    if (!base) return TRUE;
+    if (!ios_dsr_read( base + 0x1cb5420, &address, sizeof(address) ) || address > UINTPTR_MAX ||
+        !ios_dsr_read( (uintptr_t)address, manager, sizeof(manager) ) ||
+        manager[0] != base + 0x12d2fd0 || manager[1] > manager[2] ||
+        manager[2] > UINTPTR_MAX || (manager[1] & 7) ||
+        (manager[2] - manager[1]) % 0x148 || (manager[2] - manager[1]) / 0x148 > 256)
+        return FALSE;
+    for (entry = manager[1]; entry < manager[2]; entry += 0x148)
+    {
+        if (!ios_dsr_read( (uintptr_t)entry + 0x88, &type, sizeof(type) )) return FALSE;
+        if (type == 1) return TRUE;
+    }
+    return FALSE;
+}
