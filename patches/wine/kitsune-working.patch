+#ifdef WINE_IOS_JIT_ARENA
+/* Steam without its UI while a game runs (KITSUNE_STEAM_LEAN, which the app
+ * sets for game launches). Steam's whole interface is its Chromium web
+ * helper, the largest thing in memory after the game, and neither the client
+ * nor the game needs it. When Steam starts the game the helper is ended, and
+ * its restarts are refused until the game has exited; the next one then
+ * brings the hidden UI back. steam.exe starts both, so these handles are
+ * steam.exe's, and only its calls may use them: ntdll's unix globals are
+ * shared by every threaded process. */
+enum ios_lean_kind { IOS_LEAN_NONE, IOS_LEAN_HELPER, IOS_LEAN_GAME };
+static HANDLE ios_lean_helper;   /* Steam's running web helper */
+static HANDLE ios_lean_game;     /* the game, while it runs */
+
+static BOOL ios_lean_caller_is_steam(void)
+{
+    RTL_USER_PROCESS_PARAMETERS *params = NtCurrentTeb()->Peb->ProcessParameters;
+    static const char tail[] = "\\steam.exe";
+    ULONG len, n = sizeof(tail) - 1, i;
+
+    if (!params || !params->ImagePathName.Buffer) return FALSE;
+    len = params->ImagePathName.Length / sizeof(WCHAR);
+    if (len < n) return FALSE;
+    for (i = 0; i < n; i++)
+    {
+        WCHAR c = params->ImagePathName.Buffer[len - n + i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != (WCHAR)tail[i]) return FALSE;
+    }
+    return TRUE;
+}
+
+static enum ios_lean_kind ios_lean_classify( const char *image )
+{
+    static int enabled = -1;
+    char lower[512];
+    size_t i;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "KITSUNE_STEAM_LEAN" );
+        enabled = e && atoi( e );
+    }
+    if (!enabled || !ios_lean_caller_is_steam()) return IOS_LEAN_NONE;
+    for (i = 0; image[i] && i < sizeof(lower) - 1; i++)
+        lower[i] = (image[i] >= 'A' && image[i] <= 'Z') ? image[i] + 'a' - 'A' : image[i];
+    lower[i] = 0;
+    if (strstr( lower, "steamwebhelper" )) return IOS_LEAN_HELPER;
+    if (strstr( lower, "\\steamapps\\common\\" )) return IOS_LEAN_GAME;
+    return IOS_LEAN_NONE;
+}
+
+static BOOL ios_lean_game_running(void)
+{
+    LARGE_INTEGER zero = {{0}};
+
+    if (!ios_lean_game) return FALSE;
+    if (NtWaitForSingleObject( ios_lean_game, FALSE, &zero ) == STATUS_TIMEOUT) return TRUE;
+    NtClose( ios_lean_game );
+    ios_lean_game = 0;
+    ERR( "ios-lean: the game has exited; Steam's web helper may start again\n" );
+    return FALSE;
+}
+
+static void ios_lean_started( enum ios_lean_kind kind, HANDLE process )
+{
+    HANDLE *slot = kind == IOS_LEAN_HELPER ? &ios_lean_helper : &ios_lean_game;
+
+    if (kind == IOS_LEAN_NONE) return;
+    if (*slot) NtClose( *slot );
+    *slot = 0;
+    NtDuplicateObject( NtCurrentProcess(), process, NtCurrentProcess(), slot, 0, 0, DUPLICATE_SAME_ACCESS );
+    if (kind == IOS_LEAN_GAME && ios_lean_helper)
+    {
+        ERR( "ios-lean: the game started; ending Steam's web helper until it exits\n" );
+        NtTerminateProcess( ios_lean_helper, 0 );
+        NtClose( ios_lean_helper );
+        ios_lean_helper = 0;
+    }
+}
+#endif
