diff --git a/dlls/ntdll/unix/ios_process_context.h b/dlls/ntdll/unix/ios_process_context.h
new file mode 100644
index 0000000..bb70946
--- /dev/null
+++ b/dlls/ntdll/unix/ios_process_context.h
@@ -0,0 +1,178 @@
+#ifndef KITSUNE_PROCESS_CONTEXT_H
+#define KITSUNE_PROCESS_CONTEXT_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "ios_process_callbacks.h"
+
+struct thread_data;
+
+struct ios_process_context
+{
+    pthread_mutex_t lock;
+    unsigned int refs;
+    unsigned int windows_pid;
+    int exiting;
+    int socket;              /* immutable; owned until the final release */
+    void *peb;               /* identity only: loader still owns this memory */
+    void *callbacks[IOS_CALLBACK_COUNT]; /* immutable after publication */
+    unsigned int callbacks_ready;
+    struct ios_process_state *state; /* shared by this owner's retained threads */
+    /* Every thread of this owner that exited, which the reaper joins and
+     * frees, each exactly once. Grows: Chromium starts and ends hundreds. */
+    struct ios_reap_entry { pthread_t thread; struct thread_data *data; } *reap;
+    unsigned int reap_count, reap_cap;
+    int reap_overflow;   /* out of memory for the list: do not reclaim, only free */
+};
+
+/* On success consumes fd and returns the initial thread's reference. On
+ * failure the caller still owns fd. No caller may close/reuse a consumed fd. */
+static inline struct ios_process_context *ios_proc_create( void *peb, int fd )
+{
+    struct ios_process_context *ctx;
+    int flags, err;
+    if (!peb || fd < 0) { errno = EINVAL; return NULL; }
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return NULL;
+    if ((err = pthread_mutex_init( &ctx->lock, NULL )))
+    {
+        free( ctx );
+        errno = err;
+        return NULL;
+    }
+    if ((flags = fcntl( fd, F_GETFD )) == -1 || fcntl( fd, F_SETFD, flags | FD_CLOEXEC ) == -1)
+    {
+        err = errno;
+        pthread_mutex_destroy( &ctx->lock );
+        free( ctx );
+        errno = err;
+        return NULL;
+    }
+    ctx->refs = 1;
+    ctx->socket = fd;
+    ctx->peb = peb;
+    return ctx;
