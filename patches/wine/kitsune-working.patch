+static void ios_dump_pe_frames( const char *tag )
+{
+    const unsigned long *f = (const unsigned long *)get_syscall_frame( get_thread_data() );
+    unsigned long lo = (unsigned long)NtCurrentTeb()->Tib.StackLimit;
+    unsigned long hi = (unsigned long)NtCurrentTeb()->Tib.StackBase;
+    unsigned long sp;
+    char pe[96];
+    int depth = 0, i;
+
+    if (!f) return;
+    sp = f[0x0f8 / 8];
+
+    if (sp < lo || sp >= hi)
+    {
+        fprintf( stderr, "[%s] pe: sp %p outside EC stack %p-%p -- scanning guest stack (page-checked)\n",
+                 tag, (void *)sp, (void *)lo, (void *)hi );
+        hi = sp + 512 * 8 + 16;   /* scan window; per-page readability enforced below */
+    }
+    for (depth = 0; depth < 2; depth++)
+    {
+        unsigned long a = depth ? f[0x0f0 / 8] : f[0x100 / 8];   /* pc then lr */
+        if (!a) continue;
+        if (ios_name_pe( a, pe, sizeof(pe) ))
+        {
+            unsigned int insn = 0;
+            ios_safe_read( a - 4, &insn, sizeof(insn) );
+            fprintf( stderr, "[%s] pe %s %p %s  [-4]=%08x\n", tag, depth ? "lr" : "pc",
+                     (void *)a, pe, insn );
+        }
+        else
+            fprintf( stderr, "[%s] pe %s %p (unknown)\n", tag, depth ? "lr" : "pc", (void *)a );
+    }
+
+    for (i = 0; i < 512 && sp + 8 * i + 8 <= hi; i++)
+    {
+        unsigned long w;
+
+        /* Page-checked read: the guest stack may end sooner than the window. */
+        unsigned int insn = 0;
+        if (!ios_safe_read( sp + 8 * i, &w, sizeof(w) )) break;
+
+        if (w < 0x10000 || (w & 3)) continue;
+        if (!ios_name_pe( w, pe, sizeof(pe) )) continue;
+        ios_safe_read( w - 4, &insn, sizeof(insn) );
+        fprintf( stderr, "[%s] pe stack+%#lx %p %s  [-4]=%08x\n", tag, (unsigned long)i * 8,
+                 (void *)w, pe, insn );
+        if (++depth >= 24) break;
+    }
+}
