+static NTSTATUS ios_nt_to_unix_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
+                                        char **unix_name_ret, UINT disposition,
+                                        BOOL open_reparse, unsigned int reparse_count );
+
+#ifdef WINE_IOS_JIT_ARENA
+static WCHAR *ios_fix_container_case( const WCHAR *name, int len )
+{
+    static WCHAR home[512];
+    static int home_len = -1;
+    int i, start;
+    WCHAR *out;
+
+    if (home_len < 0)
+    {
+        const char *h = getenv( "HOME" );
+        home_len = 0;
+        if (h && h[0] == '/' && strlen( h ) < ARRAY_SIZE(home))
+        {
+            for (i = 0; h[i]; i++) home[i] = h[i] == '/' ? '\\' : (unsigned char)h[i];
+            home_len = i;
+        }
+    }
+    if (home_len <= 0) return NULL;
+    /* \??\Z:\var\... */
+    if (len < 6 + home_len || name[0] != '\\' || name[1] != '?' || name[2] != '?' || name[3] != '\\' ||
+        (name[4] != 'Z' && name[4] != 'z') || name[5] != ':')
+        return NULL;
+    start = 6;
+    if (wcsnicmp( name + start, home, home_len )) return NULL;
+    if (len > start + home_len && name[start + home_len] != '\\') return NULL;
+    if (!memcmp( name + start, home, home_len * sizeof(WCHAR) )) return NULL;   /* already right */
+    if (!(out = malloc( len * sizeof(WCHAR) ))) return NULL;
+    memcpy( out, name, len * sizeof(WCHAR) );
+    memcpy( out + start, home, home_len * sizeof(WCHAR) );
+    return out;
+}
+#endif
+
 static NTSTATUS nt_to_unix_file_name_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
                                               char **unix_name_ret, UINT disposition,
                                               BOOL open_reparse, unsigned int reparse_count )
+{
+#ifdef WINE_IOS_JIT_ARENA
+    UNICODE_STRING *orig = attr->ObjectName, fixed_us;
+    WCHAR *fixed = orig && orig->Buffer ? ios_fix_container_case( orig->Buffer, orig->Length / sizeof(WCHAR) ) : NULL;
+    NTSTATUS status;
+
+    if (fixed)
+    {
+        fixed_us = *orig;
+        fixed_us.Buffer = fixed;
+        attr->ObjectName = &fixed_us;
+    }
+    status = ios_nt_to_unix_no_root( attr, nt_name, unix_name_ret, disposition, open_reparse, reparse_count );
+    if (fixed)
+    {
+        attr->ObjectName = orig;
+        free( fixed );
+    }
+    return status;
+#else
+    return ios_nt_to_unix_no_root( attr, nt_name, unix_name_ret, disposition, open_reparse, reparse_count );
+#endif
+}
+
+static NTSTATUS ios_nt_to_unix_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
