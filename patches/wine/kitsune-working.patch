+/* Register the calling thread for the reaper to join, before it releases its
+ * reference. Child owners only. */
+static inline void ios_proc_register_exit( struct ios_process_context *ctx, pthread_t self,
+                                           struct thread_data *data )
+{
+    if (!ctx) return;
+    pthread_mutex_lock( &ctx->lock );
+    if (ctx->reap_count == ctx->reap_cap)
+    {
+        unsigned int cap = ctx->reap_cap ? ctx->reap_cap * 2 : 32;
+        struct ios_reap_entry *grown = realloc( ctx->reap, cap * sizeof(*grown) );
+        if (grown) { ctx->reap = grown; ctx->reap_cap = cap; }
+    }
+    if (ctx->reap_count < ctx->reap_cap)
+    {
+        ctx->reap[ctx->reap_count].thread = self;
+        ctx->reap[ctx->reap_count].data = data;
+        ctx->reap_count++;
+    }
+    else ctx->reap_overflow = 1;
+    pthread_mutex_unlock( &ctx->lock );
+}
+
+/* Decrement without freeing; returns nonzero if this was the last reference so
+ * the caller can hand a child owner to the reaper (which frees it) or free a
+ * root owner inline. */
+static inline int ios_proc_release_islast( struct ios_process_context *ctx )
+{
+    int last;
+    if (!ctx) return 0;
+    pthread_mutex_lock( &ctx->lock );
+    last = !--ctx->refs;
+    pthread_mutex_unlock( &ctx->lock );
+    return last;
+}
+
+/* Final teardown the reaper (or an inline root release) performs. */
+static inline void ios_proc_destroy( struct ios_process_context *ctx )
+{
+    if (!ctx) return;
+    close( ctx->socket );
+    pthread_mutex_destroy( &ctx->lock );
+    free( ctx->reap );
+    free( ctx );
+}
