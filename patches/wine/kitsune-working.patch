+static void ios_va_census_now( const char *when );
+
+static void ios_va_census(void)
+{
+    if (!getenv( "WINE_IOS_VA_CENSUS" )) return;
+    ios_va_census_now( "AFTER startup" );
+}
+
+static void ios_va_census_now( const char *when )
+{
+    static const size_t ladder[] = { 4096, 2048, 1024, 512, 256, 128, 64, 32, 16 };  /* MB */
+    void *taken[512];
+    size_t sizes[512];
+    unsigned n = 0, i;
+    size_t total = 0, largest = 0;
+
+    for (i = 0; i < ARRAY_SIZE(ladder) && n < ARRAY_SIZE(taken); i++)
+    {
+        size_t want = ladder[i] * (size_t)1024 * 1024;
+
+        for (;;)
+        {
+            void *p;
+
+            if (n >= ARRAY_SIZE(taken)) break;
+            p = anon_mmap_alloc( want, PROT_NONE );
+            if (p == MAP_FAILED) break;
+            taken[n] = p;
+            sizes[n++] = want;
+            total += want;
+            if (want > largest) largest = want;
+        }
+    }
+    for (i = 0; i < n; i++) munmap( taken[i], sizes[i] );
+
+    ERR( "ios: VA census %s -- %zu MB free in %u blocks, largest %zu MB%s\n",
+         when, total >> 20, n, largest >> 20,
+         n >= ARRAY_SIZE(taken) ? " (census array full, real total is higher)" : "" );
+}
+
+__attribute__((visibility("default")))
+void ios_rss_report( const char *when )
+{
+    vm_address_t addr = 0;
+    struct { unsigned tag; size_t bytes; } tags[32];
+    unsigned ntags = 0, i, regions = 0;
+    size_t total = 0;
+    /* Tag 0 is every anonymous mapping -- ours, the guest's heaps, the JIT
+     * arena, CEF's pools -- so it says nothing on its own. Split it by WHICH
+     * pool the address belongs to, which is what we can actually act on. */
+    size_t rss_arena = 0, rss_pool = 0, rss_band = 0, rss_low = 0, rss_other = 0;
+    size_t win_file = 0, win_anon = 0, win_anon_dirty = 0, band_file = 0, band_anon = 0;
+    struct { ULONG_PTR addr; size_t size, rss; unsigned prot, tag; } top_anon[8] = {{0}};
+    char line[512];
+    int n;
+
+    for (;;)
+    {
+        vm_size_t sz = 0;
+        vm_region_submap_info_data_64_t info;
+        mach_msg_type_number_t cnt = VM_REGION_SUBMAP_INFO_COUNT_64;
+        natural_t depth = 0;
+        size_t rss;
+
+        if (vm_region_recurse_64( mach_task_self(), &addr, &sz, &depth,
+                                  (vm_region_recurse_info_t)&info, &cnt ) != KERN_SUCCESS)
+            break;
+        rss = (size_t)info.pages_resident * host_page_size;
+        total += rss;
+        if (rss)
+        {
+            ULONG_PTR a = (ULONG_PTR)addr;
+
+            if (a >= 0x7000000000ull && a < 0x8000000000ull)
+            {
+                int band = a >= 0x7400000000ull;
+                if (info.external_pager) { win_file += rss; if (band) band_file += rss; }
+                else
+                {
+                    unsigned k, worst = 0;
+                    win_anon += rss;
+                    win_anon_dirty += (size_t)info.pages_dirtied * host_page_size;
+                    if (band) band_anon += rss;
+                    for (k = 0; k < ARRAY_SIZE(top_anon); k++)
+                        if (top_anon[k].rss < top_anon[worst].rss) worst = k;
+                    if (rss > top_anon[worst].rss)
+                    {
+                        top_anon[worst].addr = a; top_anon[worst].size = sz; top_anon[worst].rss = rss;
+                        top_anon[worst].prot = info.protection; top_anon[worst].tag = info.user_tag;
+                    }
+                }
+            }
+            if (arena_lo && (char *)a >= arena_lo && (char *)a < arena_hi) rss_arena += rss;
+            else if (a >= 0x7400000000ull && a < 0x8000000000ull) rss_band += rss;
+            else if (a >= 0x7000000000ull && a < 0x7400000000ull) rss_pool += rss;
+            else if (a >= 0x100000000ull && a < 0x1000000000ull) rss_low += rss;
+            else rss_other += rss;
+            for (i = 0; i < ntags; i++) if (tags[i].tag == info.user_tag) break;
+            if (i == ntags && ntags < ARRAY_SIZE(tags)) { tags[ntags].tag = info.user_tag; tags[ntags].bytes = 0; ntags++; }
+            if (i < ARRAY_SIZE(tags)) tags[i].bytes += rss;
+        }
+        addr += sz;
+        if (++regions >= 400000) break;
+    }
+
+    n = snprintf( line, sizeof(line), "ios: RSS-REPORT %s -- %zu MB resident in %u regions "
+                  "(arena %zu, bigpool %zu, band %zu, lowband %zu, other %zu)\n",
+                  when, total >> 20, regions, rss_arena >> 20, rss_pool >> 20,
+                  rss_band >> 20, rss_low >> 20, rss_other >> 20 );
+    if (n > 0) write( 2, line, (size_t)n );
+    n = snprintf( line, sizeof(line), "ios: RSS-REPORT   swap window: %zu MB file-backed (uncharged), "
+                  "%zu MB anonymous (charged, %zu dirty); of which CEF band: %zu file / %zu anon\n",
+                  win_file >> 20, win_anon >> 20, win_anon_dirty >> 20, band_file >> 20, band_anon >> 20 );
+    if (n > 0) write( 2, line, (size_t)n );
+    for (i = 0; i < ARRAY_SIZE(top_anon); i++)
+    {
+        unsigned best = 0, j;
+        for (j = 1; j < ARRAY_SIZE(top_anon); j++) if (top_anon[j].rss > top_anon[best].rss) best = j;
+        if (!top_anon[best].rss) break;
+        n = snprintf( line, sizeof(line), "ios: RSS-REPORT     anon in window: %p+%#zx resident %zu MB prot %#x tag %u\n",
+                      (void *)top_anon[best].addr, top_anon[best].size, top_anon[best].rss >> 20,
+                      top_anon[best].prot, top_anon[best].tag );
+        if (n > 0) write( 2, line, (size_t)n );
+        top_anon[best].rss = 0;
+    }
+    for (i = 0; i < 6 && i < ntags; i++)
+    {
+        unsigned best = 0, j;
+
+        for (j = 1; j < ntags; j++) if (tags[j].bytes > tags[best].bytes) best = j;
+        if (!tags[best].bytes) break;
+        n = snprintf( line, sizeof(line), "ios: RSS-REPORT   tag %u: %zu MB\n",
+                      tags[best].tag, tags[best].bytes >> 20 );
+        if (n > 0) write( 2, line, (size_t)n );
+        tags[best].bytes = 0;
+    }
+}
+
+__attribute__((visibility("default")))
+void ios_va_report( const char *when )
+{
+    mach_vm_address_t addr = 0, prev_end = 0;
+    size_t hole_lo = 0, hole_hi = 0, hole_slack = 0, free_slack = 0;
+    size_t mapped_lo = 0, mapped_hi = 0;
+    unsigned regions = 0;
+    char line[1024];
+    int n;
+    struct { unsigned tag; size_t bytes; unsigned n; } tags[24];
+    unsigned ntags = 0, ti;
+    size_t slack_used = 0;
+
+    for (;;)
+    {
+        vm_size_t sz = 0;
+        vm_region_submap_info_data_64_t info;
+        mach_msg_type_number_t cnt = VM_REGION_SUBMAP_INFO_COUNT_64;
+        natural_t depth = 0;
+
+        if (vm_region_recurse_64( mach_task_self(), &addr, &sz, &depth,
+                                  (vm_region_recurse_info_t)&info, &cnt ) != KERN_SUCCESS)
+            break;
+        if (addr > prev_end)
+        {
+            size_t hole = (size_t)(addr - prev_end);
+
+            if (prev_end >= 0x7000000000ull) { if (hole > hole_hi) hole_hi = hole; }
+            else if (hole > hole_lo) hole_lo = hole;
+            /* The slack is unmapped by construction, so it shows up here as a
+             * hole; count how much of it survives. */
+            if (ios_slack_hi > ios_slack_lo)
+            {
+                ULONG_PTR s = max( (ULONG_PTR)prev_end, ios_slack_lo );
+                ULONG_PTR e = min( (ULONG_PTR)addr, ios_slack_hi );
+
+                if (e > s)
+                {
+                    free_slack += (size_t)(e - s);
+                    if ((size_t)(e - s) > hole_slack) hole_slack = (size_t)(e - s);
+                }
+            }
+        }
+        if (addr < 0x7000000000ull) mapped_lo += (size_t)sz; else mapped_hi += (size_t)sz;
+        if (ios_slack_hi > ios_slack_lo && addr < ios_slack_hi && addr + sz > ios_slack_lo)
+        {
+            ULONG_PTR s0 = max( (ULONG_PTR)addr, ios_slack_lo );
+            ULONG_PTR e0 = min( (ULONG_PTR)(addr + sz), ios_slack_hi );
+            size_t part = (size_t)(e0 - s0);
+
+            slack_used += part;
+            for (ti = 0; ti < ntags; ti++) if (tags[ti].tag == info.user_tag) break;
+            if (ti == ntags && ntags < ARRAY_SIZE(tags))
+            {
+                tags[ntags].tag = info.user_tag; tags[ntags].bytes = 0; tags[ntags].n = 0; ntags++;
+            }
+            if (ti < ARRAY_SIZE(tags)) { tags[ti].bytes += part; tags[ti].n++; }
+        }
+        regions++;
+        prev_end = addr + sz;
+        addr = prev_end;
+        if (regions >= 400000) break;
+    }
+
+    n = snprintf( line, sizeof(line),
+                  "ios: VA-REPORT %s -- slack %p-%p free %zu MB (largest %zu MB, bounced %u) | "
+                  "largest hole lo %zu MB hi %zu MB | mapped lo %zu MB hi %zu MB | %u regions\n",
+                  when, (void *)ios_slack_lo, (void *)ios_slack_hi, free_slack >> 20,
+                  hole_slack >> 20, ios_slack_bounced, hole_lo >> 20, hole_hi >> 20,
+                  mapped_lo >> 20, mapped_hi >> 20, regions );
+    if (n > 0) write( 2, line, (size_t)n );
+
+    for (ti = 0; ti < 3 && ti < ntags; ti++)
+    {
+        unsigned best = 0, j;
+
+        for (j = 1; j < ntags; j++) if (tags[j].bytes > tags[best].bytes) best = j;
+        n = snprintf( line, sizeof(line), "ios: VA-REPORT   slack tag %u: %zu MB in %u regions\n",
+                      tags[best].tag, tags[best].bytes >> 20, tags[best].n );
+        if (n > 0) write( 2, line, (size_t)n );
+        tags[best].bytes = 0;
+    }
+    n = snprintf( line, sizeof(line), "ios: VA-REPORT   slack used %zu MB of %zu MB\n",
+                  slack_used >> 20, (size_t)(ios_slack_hi - ios_slack_lo) >> 20 );
+    if (n > 0) write( 2, line, (size_t)n );
+    ios_arena_report_owners();
+}
+
+static void ios_va_diag( const char *why, size_t want )
+{
+    static unsigned calls;
+    mach_vm_address_t addr = 0, probe = 0, prev_end = 0;
+    unsigned long long mapped_lo = 0, mapped_hi = 0, hole_lo = 0, hole_hi = 0;
+    unsigned regions = 0, small = 0;
+    kern_return_t kr;
+    int mm_errno;
+    void *mm;
+
+    if (++calls > 3 && (calls % 2048)) return;
+
+    for (;;)
+    {
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t obj = MACH_PORT_NULL;
+        mach_vm_size_t sz = 0;
+
+        if (mach_vm_region( mach_task_self(), &addr, &sz, VM_REGION_BASIC_INFO_64,
+                            (vm_region_info_t)&info, &count, &obj ) != KERN_SUCCESS) break;
+        if (!sz) break;
+        if (addr > prev_end)
+        {
+            unsigned long long hole = addr - prev_end;
+            if (prev_end < 0x1000000000ull) { if (hole > hole_lo) hole_lo = hole; }
+            else if (hole > hole_hi) hole_hi = hole;
+        }
+        if (addr < 0x1000000000ull) mapped_lo += sz; else mapped_hi += sz;
+        if (sz <= 0x10000) small++;
+        regions++;
+        prev_end = addr + sz;
+        addr = prev_end;
+        if (regions >= 400000) break;
+    }
+
+    probe = 0;
+    kr = mach_vm_allocate( mach_task_self(), &probe, 0x10000, VM_FLAGS_ANYWHERE );
+    if (kr == KERN_SUCCESS) mach_vm_deallocate( mach_task_self(), probe, 0x10000 );
+    else probe = 0;
+
+    errno = 0;
+    mm = mmap( NULL, 0x10000, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0 );
+    mm_errno = errno;
+    if (mm != MAP_FAILED) munmap( mm, 0x10000 );
+
+    ERR( "ios: VA-DIAG #%u (%s want=%p): regions=%u small=%u mapped lo=%lluMB hi=%lluMB "
+         "max-hole lo=%lluMB hi=%lluMB | mach_vm_allocate(64K,ANY) kr=%d at %p | "
+         "mmap(NULL,64K)=%s errno=%d\n",
+         calls, why, (void *)want, regions, small,
+         mapped_lo >> 20, mapped_hi >> 20, hole_lo >> 20, hole_hi >> 20,
+         (int)kr, (void *)(ULONG_PTR)probe,
+         mm == MAP_FAILED ? "FAILED" : "ok", mm_errno );
+}
+
+/* Carve `size` from the pool, aligned. Returns NULL when it cannot. */
+static void *bigpool_take( size_t size, size_t align_mask )
+{
+    struct bigpool_seg *seg;
+    struct bigpool_free *fprev = NULL, *fcur;
+    char *start;
+
+    if (size >= 0x40000000) return NULL;
+
+    fcur = bigpool_freelist;
+    while (fcur)
+    {
+        struct bigpool_free *fnext = fcur->link;
+        if (!((ULONG_PTR)fcur->base & align_mask) && (size_t)(fcur->end - fcur->base) >= size)
+        {
+            /* Re-reserve just the piece we are about to hand out. PROT_NONE:
+             * the caller re-maps it with the requested protection, exactly as
+             * for a bump-path slice carved from the startup PROT_NONE pool. */
+            if (anon_mmap_tryfixed( fcur->base, size, PROT_NONE, MAP_NORESERVE ) == fcur->base)
+            {
+                start = fcur->base;
+                fcur->base += size;
+                if (fcur->base >= fcur->end)
+                {
+                    if (fprev) fprev->link = fcur->link; else bigpool_freelist = fcur->link;
+                    free( fcur );
+                }
+                return start;
+            }
+            /* VA no longer free -> forget this hole entirely (the kernel owns
+             * it now; a later free of the same range will re-record it). */
+            if (fprev) fprev->link = fnext; else bigpool_freelist = fnext;
+            free( fcur );
+            fcur = fnext;
+            continue;
+        }
+        fprev = fcur;
+        fcur = fnext;
+    }
+
+    if (bigpool_base)
+    {
+        start = ROUND_ADDR( bigpool_next + align_mask, align_mask );
+        if (start >= bigpool_next && (size_t)(bigpool_end - start) >= size)
+        {
+            bigpool_next = start + size;
+            return start;
+        }
+    }
+    for (seg = bigpool_extra_segs; seg; seg = seg->link)
+    {
+        start = ROUND_ADDR( seg->next + align_mask, align_mask );
+        if (start >= seg->next && (size_t)(seg->end - start) >= size)
+        {
+            seg->next = start + size;
+            return start;
+        }
+    }
+    return NULL;
+}
+
+struct ios_soft_pool { ULONG_PTR base, size, committed, guard; unsigned commits, collisions, decommits; void *owner;
+                       unsigned char *map; /* one bit per host page: MATERIALISED (mapped RW) */
+                       unsigned char *cmap;/* one bit per host page: COMMITTED (fault-materialise) */
+                       unsigned char *wmap;/* one bit per host page: WRITABLE when materialised.
+                                              NOT one prot per pool: PA/V8 mix RO and RW commits in
+                                              one pool, and a single latched prot materialised RW
+                                              pages read-only -> the write re-faulted as a real
+                                              guest AV (libcef c0000005, device 2026-09-20). */
+                       int commit_prot;    /* unix prot to map faulted committed pages with       */
+                       unsigned long faults;/* demand-materialised page count (diagnostic)          */
+                       int is_pack;         /* 1: a shared slot packing several small cages */
+                       int is_phantom;      /* 1: bookkeeping-only; VA is NOT mappable (see PHANTOM) */
+                       ULONG_PTR pack_next;  /* next free offset within a packing slot        */ };
+/* pages materialised per demand fault -- see FAULT-AHEAD CLUSTERING below.
+ * 64 x 16KB = 1MB: cuts vm_map entries and fault count ~64x. */
+#define IOS_SOFT_FAULT_CLUSTER 64
+#define IOS_SOFT_BIT(pool, idx)   ((pool)->map[(idx) >> 3] & (1u << ((idx) & 7)))
+#define IOS_SOFT_SET(pool, idx)   ((pool)->map[(idx) >> 3] |= (1u << ((idx) & 7)))
+#define IOS_SOFT_CLR(pool, idx)   ((pool)->map[(idx) >> 3] &= ~(1u << ((idx) & 7)))
+#define IOS_SOFT_CBIT(pool, idx)  ((pool)->cmap[(idx) >> 3] & (1u << ((idx) & 7)))
+#define IOS_SOFT_CSET(pool, idx)  ((pool)->cmap[(idx) >> 3] |= (1u << ((idx) & 7)))
+#define IOS_SOFT_CCLR(pool, idx)  ((pool)->cmap[(idx) >> 3] &= ~(1u << ((idx) & 7)))
+#define IOS_SOFT_WBIT(pool, idx)  ((pool)->wmap[(idx) >> 3] & (1u << ((idx) & 7)))
+#define IOS_SOFT_WSET(pool, idx)  ((pool)->wmap[(idx) >> 3] |= (1u << ((idx) & 7)))
+#define IOS_SOFT_WCLR(pool, idx)  ((pool)->wmap[(idx) >> 3] &= ~(1u << ((idx) & 7)))
+static struct ios_soft_pool ios_soft[IOS_SOFT_MAX];
+static unsigned ios_soft_n;
+
+/* Does `addr` fall inside any soft grant's full [base,base+size) span? */
+static int ios_soft_contains( const void *addr )
+{
+    unsigned i;
+    for (i = 0; i < ios_soft_n; i++)
+        if ((ULONG_PTR)addr >= ios_soft[i].base - ios_soft[i].guard &&
+            (ULONG_PTR)addr < ios_soft[i].base + ios_soft[i].size) return i + 1;
+    return 0;
+}
+
+static int ios_soft_slot_taken( ULONG_PTR addr )
+{
+    unsigned i;
+    if (addr >= IOS_CEF_LOW_LO && addr < IOS_CEF_POOL_HI && !(addr & (IOS_CEF_SLOT - 1)) &&
+        (ios_cef_unfenced & IOS_CEF_SLOT_BIT( addr )))
+        return 1;
+    for (i = 0; i < ios_soft_n; i++)
+        if (addr >= ios_soft[i].base && addr < ios_soft[i].base + ios_soft[i].size) return 1;
+    return 0;
+}
+
+static int ios_midsize_is_band( ULONG_PTR pool_base );
+static ULONG_PTR ios_soft_reserve( size_t size, void *hint, ULONG_PTR limit_high )
+{
+    int band;
+    ULONG_PTR slot, off;
+    unsigned slots_needed, i;
+
+    if (size < IOS_SOFT_MIN_SIZE || ios_soft_n >= IOS_SOFT_MAX) return 0;
+    {
+        static ULONG_PTR seen_size; static unsigned seen_n;
+        if (size != seen_size) { seen_size = size; seen_n = 0; }
+        if (++seen_n <= 4)
+            ERR( "ios: soft reserve size %p hint %p limit_high %p\n",
+                 (void *)size, hint, (void *)limit_high );
+    }
+    /* A pool is N*16GB plus at most a small guard tail; don't let the guard
+     * (e.g. 16GB+64KB) round the pool up to an extra whole 16GB slot. */
+    {
+        ULONG_PTR eff = size > 0x100000 ? (ULONG_PTR)size - 0x100000 : (ULONG_PTR)size;
+        slots_needed = (unsigned)((eff + IOS_CEF_SLOT - 1) / IOS_CEF_SLOT);
+        if (!slots_needed) slots_needed = 1;
+    }
+    /* Preserve the guard offset: if the hint sits `off` bytes into a 16GB slot,
+     * hand back the same offset one slot lower (slot + off - SLOT).
+     * off==0 -> plain slot base. */
+    off = (ULONG_PTR)hint & (IOS_CEF_SLOT - 1);
+
+    if ((off & (IOS_PACK_ALIGN - 1)) == 0 && size <= IOS_PACK_MAX)
+    {
+        ULONG_PTR need = (size + IOS_PACK_ALIGN - 1) & ~(IOS_PACK_ALIGN - 1);   /* 4GB-aligned span */
+        /* The V8 sandbox home first (see IOS_V8_LOW_LO): the only 8GB-aligned
+         * real region below V8's 256GB placement ceiling. */
+        if (ios_cef_lowband && size <= IOS_V8_LOW_HI - IOS_V8_LOW_LO &&
+            (!limit_high || IOS_V8_LOW_LO + size - 1 <= limit_high))
+        {
+            for (i = 0; i < ios_soft_n; i++)
+            {
+                if (ios_soft[i].base != IOS_V8_LOW_LO) continue;
+                if (ios_soft[i].owner == NtCurrentTeb()->Peb && !ios_soft[i].commits &&
+                    !ios_soft[i].decommits)
+                {
+                    static unsigned regrants;
+                    ERR( "ios: V8 LOW region RE-GRANTED %p size %p (previous grant never used, #%u)\n",
+                         (void *)IOS_V8_LOW_LO, (void *)size, ++regrants );
+                    return IOS_V8_LOW_LO;
+                }
+                break;
+            }
+        }
+        if (ios_cef_lowband && size <= IOS_V8_LOW_HI - IOS_V8_LOW_LO && ios_soft_n < IOS_SOFT_MAX &&
+            !ios_soft_slot_taken( IOS_V8_LOW_LO ) && (!limit_high || IOS_V8_LOW_LO + size - 1 <= limit_high))
+        {
+            size_t vsz = IOS_V8_LOW_HI - IOS_V8_LOW_LO;
+            ios_soft[ios_soft_n].base = IOS_V8_LOW_LO;
+            ios_soft[ios_soft_n].size = vsz;
+            ios_soft[ios_soft_n].committed = 0;
+            ios_soft[ios_soft_n].guard = 0;
+            ios_soft[ios_soft_n].commits = 0;
+            ios_soft[ios_soft_n].collisions = 0;
+            ios_soft[ios_soft_n].decommits = 0;
+            ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;
+            ios_soft[ios_soft_n].map = calloc( 1, vsz / (host_page_mask + 1) / 8 + 1 );
+            ios_soft[ios_soft_n].cmap = calloc( 1, vsz / (host_page_mask + 1) / 8 + 1 );
+            ios_soft[ios_soft_n].wmap = calloc( 1, vsz / (host_page_mask + 1) / 8 + 1 );
+            ios_soft[ios_soft_n].commit_prot = 0;
+            ios_soft[ios_soft_n].faults = 0;
+            ios_soft[ios_soft_n].is_pack = 1;
+            ios_soft[ios_soft_n].is_phantom = 0;
+            ios_soft[ios_soft_n].pack_next = vsz;   /* whole region to this consumer */
+            ios_soft_n++;
+            ERR( "ios: V8 LOW region GRANTED %p size %p (below the 256GB sandbox ceiling)\n",
+                 (void *)IOS_V8_LOW_LO, (void *)size );
+            return IOS_V8_LOW_LO;
+        }
+        /* an existing packing slot with room? (REAL slots only: without the
+         * is_phantom filter this loop matched the phantom pool and granted
+         * from it unbounded, bypassing the phantom cap -- device 2026-09-20) */
+        for (i = 0; i < ios_soft_n; i++)
+        {
+            ULONG_PTR poff;
+            if (!ios_soft[i].is_pack || ios_soft[i].is_phantom) continue;
+            poff = (ios_soft[i].pack_next + IOS_PACK_ALIGN - 1) & ~(IOS_PACK_ALIGN - 1);
+            if (limit_high && ios_soft[i].base + poff + size - 1 > limit_high) continue;
+            if (poff + size <= ios_soft[i].size)
+            {
+                ios_soft[i].pack_next = poff + need;
+                ERR( "ios: CEF cage PACKED %p size %p in slot %p (next %p)\n",
+                     (void *)(ios_soft[i].base + poff), (void *)size,
+                     (void *)ios_soft[i].base, (void *)ios_soft[i].pack_next );
+                return ios_soft[i].base + poff;
+            }
+        }
+        /* none with room: claim a fresh 16GB slot AS a packing slot, cage at off 0 */
+        if (ios_soft_n < IOS_SOFT_MAX)
+        {
+            for (band = 0; band < 2; band++)
+            {
+                ULONG_PTR blo = band ? IOS_CEF_LOW_LO : IOS_CEF_POOL_LO;
+                ULONG_PTR bhi = band ? IOS_CEF_LOW_HI : ios_cef_band_hi;
+                if (band && !ios_cef_lowband) break;
+                for (slot = blo; slot + IOS_CEF_SLOT <= bhi; slot += IOS_CEF_SLOT)
+                {
+                    if (limit_high && slot + size - 1 > limit_high) break;   /* ascending: rest over-limit too */
+                    if (ios_soft_slot_taken( slot )) continue;
+                    ios_soft[ios_soft_n].base = slot;
+                    ios_soft[ios_soft_n].size = IOS_CEF_SLOT;
+                    ios_soft[ios_soft_n].committed = 0;
+                    ios_soft[ios_soft_n].guard = 0;
+                    ios_soft[ios_soft_n].commits = 0;
+                    ios_soft[ios_soft_n].collisions = 0;
+                    ios_soft[ios_soft_n].decommits = 0;
+                    ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;
+                    ios_soft[ios_soft_n].map = calloc( 1, IOS_CEF_SLOT / (host_page_mask + 1) / 8 + 1 );
+                    ios_soft[ios_soft_n].cmap = calloc( 1, IOS_CEF_SLOT / (host_page_mask + 1) / 8 + 1 );
+                    ios_soft[ios_soft_n].wmap = calloc( 1, IOS_CEF_SLOT / (host_page_mask + 1) / 8 + 1 );
+                    ios_soft[ios_soft_n].commit_prot = 0;
+                    ios_soft[ios_soft_n].faults = 0;
+                    ios_soft[ios_soft_n].is_pack = 1;
+                    ios_soft[ios_soft_n].is_phantom = 0;
+                    ios_soft[ios_soft_n].pack_next = need;   /* this cage occupies [0,need) */
+                    ios_soft_n++;
+                    ERR( "ios: CEF cage PACK slot GRANTED %p (first cage size %p)\n",
+                         (void *)slot, (void *)size );
+                    return slot;
+                }
+            }
+        }
+        if (ios_soft_n < IOS_SOFT_MAX)
+        {
+            int aligned_cage = !(size & (IOS_PACK_ALIGN - 1));
+            void *bp = aligned_cage ? bigpool_take( need, IOS_PACK_ALIGN - 1 )
+                                    : bigpool_take( (size + granularity_mask) & ~(size_t)granularity_mask,
+                                                    granularity_mask );
+            if (!aligned_cage) need = (size + granularity_mask) & ~(size_t)granularity_mask;
+            if (bp && (!limit_high || (ULONG_PTR)bp + size - 1 <= limit_high))
+            {
+                size_t bsz = need;
+                ios_soft[ios_soft_n].base = (ULONG_PTR)bp;
+                ios_soft[ios_soft_n].size = bsz;
+                ios_soft[ios_soft_n].committed = 0;
+                ios_soft[ios_soft_n].guard = 0;
+                ios_soft[ios_soft_n].commits = 0;
+                ios_soft[ios_soft_n].collisions = 0;
+                ios_soft[ios_soft_n].decommits = 0;
+                ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;
+                ios_soft[ios_soft_n].map = calloc( 1, bsz / (host_page_mask + 1) / 8 + 1 );
+                ios_soft[ios_soft_n].cmap = calloc( 1, bsz / (host_page_mask + 1) / 8 + 1 );
+                ios_soft[ios_soft_n].wmap = calloc( 1, bsz / (host_page_mask + 1) / 8 + 1 );
+                ios_soft[ios_soft_n].commit_prot = 0;
+                ios_soft[ios_soft_n].faults = 0;
+                ios_soft[ios_soft_n].is_pack = 0;
+                ios_soft[ios_soft_n].is_phantom = 0;
+                ios_soft[ios_soft_n].pack_next = bsz;
+                ios_soft_n++;
+                ERR( "ios: CEF cage from BIGPOOL %p size %p (real VA, lazy)\n", bp, (void *)size );
+                return (ULONG_PTR)bp;
+            }
+            if (bp) ERR( "ios: bigpool cage %p over limit_high %p -- not used\n", bp, (void *)limit_high );
+            else ERR( "ios: bigpool has no 4GB-aligned %p span for a cage\n", (void *)need );
+        }
+        if (ios_soft_n < IOS_SOFT_MAX && size <= IOS_CEF_SLOT / 2)
+        {
+            ULONG_PTR align = need >= IOS_CEF_SLOT / 2 ? IOS_CEF_SLOT / 2 : IOS_PACK_ALIGN;
+            for (i = 0; i < ios_soft_n; i++)
+            {
+                ULONG_PTR top;
+                if (!ios_midsize_is_band( ios_soft[i].base ) || ios_soft[i].is_pack || ios_soft[i].is_phantom) continue;
+                top = (ios_soft[i].base + ios_soft[i].size - need) & ~(align - 1);
+                if (top < ios_soft[i].base || top < ios_soft[i].base + ios_soft[i].pack_next) continue;
+                if (limit_high && top + size - 1 > limit_high) continue;
+                {
+                    size_t csz = ios_soft[i].base + ios_soft[i].size - top;
+                    ios_soft[i].size = top - ios_soft[i].base;          /* band now ends at top */
+                    ios_soft[ios_soft_n].base = top;
+                    ios_soft[ios_soft_n].size = csz;
+                    ios_soft[ios_soft_n].committed = 0;
+                    ios_soft[ios_soft_n].guard = 0;
+                    ios_soft[ios_soft_n].commits = 0;
+                    ios_soft[ios_soft_n].collisions = 0;
+                    ios_soft[ios_soft_n].decommits = 0;
+                    ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;
+                    ios_soft[ios_soft_n].map = calloc( 1, csz / (host_page_mask + 1) / 8 + 1 );
+                    ios_soft[ios_soft_n].cmap = calloc( 1, csz / (host_page_mask + 1) / 8 + 1 );
+                    ios_soft[ios_soft_n].wmap = calloc( 1, csz / (host_page_mask + 1) / 8 + 1 );
+                    ios_soft[ios_soft_n].commit_prot = 0;
+                    ios_soft[ios_soft_n].faults = 0;
+                    ios_soft[ios_soft_n].is_pack = 1;       /* further cages may pack behind it */
+                    ios_soft[ios_soft_n].is_phantom = 0;
+                    ios_soft[ios_soft_n].pack_next = need;
+                    ios_soft_n++;
+                    ERR( "ios: CEF cage from MID-SIZE band top %p size %p (band %p now ends at %p, used %p)\n",
+                         (void *)top, (void *)size, (void *)ios_soft[i].base, (void *)top,
+                         (void *)ios_soft[i].pack_next );
+                    return top;
+                }
+            }
+        }
+        if (!limit_high || limit_high >= IOS_PHANTOM_LO + size)
+        {
+            for (i = 0; i < ios_soft_n; i++)
+                if (ios_soft[i].is_phantom) break;
+            if (i == ios_soft_n && ios_soft_n < IOS_SOFT_MAX)
+            {
+                ios_soft[ios_soft_n].base = IOS_PHANTOM_LO;
+                ios_soft[ios_soft_n].size = IOS_PHANTOM_HI - IOS_PHANTOM_LO;
+                ios_soft[ios_soft_n].committed = 0;
+                ios_soft[ios_soft_n].guard = 0;
+                ios_soft[ios_soft_n].commits = 0;
+                ios_soft[ios_soft_n].collisions = 0;
+                ios_soft[ios_soft_n].decommits = 0;
+                ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;
+                ios_soft[ios_soft_n].map = NULL;   /* phantom: no page bitmaps (16TB band) */
+                ios_soft[ios_soft_n].cmap = NULL;
+                ios_soft[ios_soft_n].wmap = NULL;
+                ios_soft[ios_soft_n].commit_prot = 0;
+                ios_soft[ios_soft_n].faults = 0;
+                ios_soft[ios_soft_n].is_pack = 1;
+                ios_soft[ios_soft_n].is_phantom = 1;
+                ios_soft[ios_soft_n].pack_next = 0;
+                ios_soft_n++;
+                ERR( "ios: PHANTOM pack region created %p-%p (bookkeeping only, LAST resort)\n",
+                     (void *)IOS_PHANTOM_LO, (void *)IOS_PHANTOM_HI );
+            }
+            {
+                static unsigned phantom_grants;
+                for (i = 0; i < ios_soft_n; i++)
+                {
+                    ULONG_PTR poff;
+                    if (!ios_soft[i].is_phantom) continue;
+                    if (phantom_grants >= 32)
+                    {
+                        if (phantom_grants++ == 32)
+                            ERR( "ios: PHANTOM grant cap (32) reached -- denying from here (probe should terminate)\n" );
+                        break;
+                    }
+                    poff = (ios_soft[i].pack_next + IOS_PACK_ALIGN - 1) & ~(IOS_PACK_ALIGN - 1);
+                    if (poff + size <= ios_soft[i].size)
+                    {
+                        ios_soft[i].pack_next = poff + need;
+                        if (++phantom_grants <= 8 || !(phantom_grants % 8))
+                            ERR( "ios: PHANTOM cage GRANTED %p size %p (grant #%u)\n",
+                                 (void *)(ios_soft[i].base + poff), (void *)size, phantom_grants );
+                        return ios_soft[i].base + poff;
+                    }
+                    break;
+                }
+            }
+        }
+        else
+        {
+            static unsigned limit_denies;
+            if (++limit_denies <= 8)
+                ERR( "ios: soft reserve size %p DENIED in-range (limit_high %p excludes phantom; real slots full)\n",
+                     (void *)size, (void *)limit_high );
+        }
+        /* fall through: no packing room -> try a whole slot below */
+    }
+
+    for (band = 0; band < 2; band++)
+    {
+    ULONG_PTR blo = band ? IOS_CEF_LOW_LO : IOS_CEF_POOL_LO;
+    ULONG_PTR bhi = band ? IOS_CEF_LOW_HI : ios_cef_band_hi;
+    if (band && !ios_cef_lowband) break;
+    for (slot = blo;
+         slot + (ULONG_PTR)slots_needed * IOS_CEF_SLOT <= bhi;
+         slot += IOS_CEF_SLOT)
+    {
+        int clear = 1;
+        /* honor the caller's MEM_ADDRESS_REQUIREMENTS ceiling: slots ascend,
+         * so the first over-limit slot ends the band */
+        if (limit_high && slot + (ULONG_PTR)slots_needed * IOS_CEF_SLOT - 1 > limit_high) break;
+        for (i = 0; i < slots_needed; i++)
+            if (ios_soft_slot_taken( slot + (ULONG_PTR)i * IOS_CEF_SLOT )) { clear = 0; break; }
+        if (!clear) continue;
+        ios_soft[ios_soft_n].base = slot;
+        ios_soft[ios_soft_n].size = (ULONG_PTR)slots_needed * IOS_CEF_SLOT;
+        ios_soft[ios_soft_n].committed = 0;
+        ios_soft[ios_soft_n].guard = off ? IOS_CEF_SLOT - off : 0;   /* bytes of guard prefix below base */
+        ios_soft[ios_soft_n].commits = 0;
+        ios_soft[ios_soft_n].collisions = 0;
+        ios_soft[ios_soft_n].decommits = 0;
+        ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;   /* the threaded child that asked */
+        ios_soft[ios_soft_n].map = calloc( 1, ios_soft[ios_soft_n].size / (host_page_mask + 1) / 8 + 1 );
+        ios_soft[ios_soft_n].cmap = calloc( 1, ios_soft[ios_soft_n].size / (host_page_mask + 1) / 8 + 1 );
+        ios_soft[ios_soft_n].wmap = calloc( 1, ios_soft[ios_soft_n].size / (host_page_mask + 1) / 8 + 1 );
+        ios_soft[ios_soft_n].commit_prot = 0;
+        ios_soft[ios_soft_n].faults = 0;
+        ios_soft[ios_soft_n].is_pack = 0;
+        ios_soft[ios_soft_n].is_phantom = 0;
+        ios_soft[ios_soft_n].pack_next = 0;
+        ios_soft_n++;
+        ERR( "ios: CEF soft pool GRANTED slot %p base %p size %p (%u slots, off %p; unbacked)\n",
+             (void *)slot, (void *)(off ? slot + off - IOS_CEF_SLOT : slot), (void *)size,
+             slots_needed, (void *)off );
+        return off ? slot + off - IOS_CEF_SLOT : slot;
+    }
+    }
+    {
+        static ULONG_PTR denied_size; static unsigned denied_n;
+        if (size != denied_size) { denied_size = size; denied_n = 0; }
+        if (++denied_n <= 4)
+            ERR( "ios: CEF soft pool DENIED size %p (%u slots) -- no clear run in [%p,%p)\n",
+                 (void *)size, slots_needed, (void *)IOS_CEF_POOL_LO, (void *)ios_cef_band_hi );
+        else if (denied_n == 5)
+            ERR( "ios: CEF soft pool DENIED size %p -- further denials at this size are silent (spin loop)\n",
+                 (void *)size );
+    }
+    return 0;
+}
+
+/* Mid-size requests go to the bands only once init_ios_bigpool has laid them
+ * out (and, in the low-band layout, fenced their slots); the bands themselves
+ * are claimed on first use with maps that never replace anything. */
+static int ios_soft_midsize_ready(void)
+{
+    return ios_bigpool_init_ran;
+}
+
+#define IOS_MID_BANDS   8
+#define IOS_MID_ALLOCS  1024
+static ULONG_PTR ios_mid_bands[IOS_MID_BANDS];
+static unsigned ios_mid_band_n;
+/* owner: the child whose own code asked for it (see ios_view_owner_depth), so
+ * the reaper can return it; the band itself is shared. */
+static struct { ULONG_PTR base; SIZE_T size; void *owner; } ios_mid_allocs[IOS_MID_ALLOCS];
+static unsigned ios_mid_alloc_n;
+
+#define IOS_SUBRES_MAX 4096
+static struct { ULONG_PTR base; SIZE_T size; } ios_sub_res[IOS_SUBRES_MAX];
+static unsigned ios_sub_res_n;
+
+static void ios_subres_record( ULONG_PTR base, SIZE_T size )
+{
+    unsigned i;
+    for (i = 0; i < ios_sub_res_n; i++)
+        if (ios_sub_res[i].base == base) { ios_sub_res[i].size = size; return; }
+    if (ios_sub_res_n < IOS_SUBRES_MAX)
+    {
+        ios_sub_res[ios_sub_res_n].base = base;
+        ios_sub_res[ios_sub_res_n].size = size;
+        ios_sub_res_n++;
+    }
+}
+
+/* size of the sub-reservation based at `base`, removing it; 0 if unknown */
+static SIZE_T ios_subres_take( ULONG_PTR base )
+{
+    unsigned i;
+    for (i = 0; i < ios_sub_res_n; i++)
+        if (ios_sub_res[i].base == base)
+        {
+            SIZE_T s = ios_sub_res[i].size;
+            ios_sub_res[i] = ios_sub_res[--ios_sub_res_n];
+            return s;
+        }
+    return 0;
+}
+
+static int ios_midsize_is_band( ULONG_PTR pool_base )
+{
+    unsigned i;
+    for (i = 0; i < ios_mid_band_n; i++) if (ios_mid_bands[i] == pool_base) return 1;
+    return 0;
+}
+
+static ULONG_PTR ios_soft_midsize_take( size_t size )
+{
+    static ULONG_PTR cur_base;   /* base, not index: pool array compaction moves entries */
+    ULONG_PTR aligned = (size + granularity_mask) & ~(ULONG_PTR)granularity_mask;
+    int band;
+    ULONG_PTR slot;
+
+    for (;;)
+    {
+        if (cur_base)
+        {
+            struct ios_soft_pool *p = NULL;
+            unsigned pi;
+            for (pi = 0; pi < ios_soft_n; pi++)
+                if (ios_soft[pi].base == cur_base) { p = &ios_soft[pi]; break; }
+            if (p)
+            {
+                ULONG_PTR off = (p->pack_next + granularity_mask) & ~(ULONG_PTR)granularity_mask;
+                if (off + aligned <= p->size)
+                {
+                    p->pack_next = off + aligned;
+                    if (ios_mid_alloc_n < IOS_MID_ALLOCS)
+                    {
+                        ios_mid_allocs[ios_mid_alloc_n].base = p->base + off;
+                        ios_mid_allocs[ios_mid_alloc_n].size = aligned;
+                        ios_mid_allocs[ios_mid_alloc_n].owner = ios_view_owner_depth ? ios_current_child_peb() : NULL;
+                        ios_mid_alloc_n++;
+                    }
+                    return p->base + off;
+                }
+            }
+            cur_base = 0;   /* band full or entry vanished: claim another slot */
+        }
+        if (ios_soft_n >= IOS_SOFT_MAX) return 0;
+        for (band = 0; band < 2; band++)
+        {
+            ULONG_PTR blo = band ? IOS_CEF_LOW_LO : IOS_CEF_POOL_LO;
+            ULONG_PTR bhi = band ? IOS_CEF_LOW_HI : ios_cef_band_hi;
+            if (band && !ios_cef_lowband) break;
+            for (slot = blo; slot + IOS_CEF_SLOT <= bhi; slot += IOS_CEF_SLOT)
+            {
+                if (ios_soft_slot_taken( slot )) continue;
+                ios_soft[ios_soft_n].base = slot;
+                ios_soft[ios_soft_n].size = IOS_CEF_SLOT;
+                ios_soft[ios_soft_n].committed = 0;
+                ios_soft[ios_soft_n].guard = 0;
+                ios_soft[ios_soft_n].commits = 0;
+                ios_soft[ios_soft_n].collisions = 0;
+                ios_soft[ios_soft_n].decommits = 0;
+                ios_soft[ios_soft_n].owner = NtCurrentTeb()->Peb;
+                ios_soft[ios_soft_n].map = calloc( 1, IOS_CEF_SLOT / (host_page_mask + 1) / 8 + 1 );
+                ios_soft[ios_soft_n].cmap = calloc( 1, IOS_CEF_SLOT / (host_page_mask + 1) / 8 + 1 );
+                ios_soft[ios_soft_n].wmap = calloc( 1, IOS_CEF_SLOT / (host_page_mask + 1) / 8 + 1 );
+                ios_soft[ios_soft_n].commit_prot = 0;
+                ios_soft[ios_soft_n].faults = 0;
+                ios_soft[ios_soft_n].is_pack = 0;      /* NOT a cage-packing slot */
+                ios_soft[ios_soft_n].is_phantom = 0;
+                ios_soft[ios_soft_n].pack_next = 0;    /* bump cursor */
+                ios_soft_n++;
+                cur_base = slot;
+                if (ios_mid_band_n < IOS_MID_BANDS) ios_mid_bands[ios_mid_band_n++] = slot;
+                ERR( "ios: MID-SIZE lazy band GRANTED slot %p (16GB, bump; VA cost = touched pages)\n",
+                     (void *)slot );
+                goto claimed;
+            }
+        }
+        return 0;   /* no free slot anywhere: caller keeps the old OOM path */
+claimed:;
+    }
+}
+
+static int ios_soft_materialize( void *addr, size_t size, int unix_prot )
+{
+    ULONG_PTR a = (ULONG_PTR)addr;
+    unsigned i;
+
+    for (i = 0; i < ios_soft_n; i++)
+    {
+        ULONG_PTR base = ios_soft[i].base;
+        if (a < base || a >= base + ios_soft[i].size) continue;
+        /* Phantom: bookkeeping only, no bitmaps (16TB band). A commit into it
+         * is a paper success; nothing can ever materialise there. */
+        if (ios_soft[i].is_phantom)
+        {
+            ios_soft[i].commits++;
+            return 1;
+        }
+        {
+            char *want = ROUND_ADDR( (char *)addr, host_page_mask );
+            size_t need = ROUND_SIZE( (char *)addr - want, size, host_page_mask );
+            /* Nothing of ours should own this VA (the band is kept clear). If a
+             * live wine view IS here, do not touch it -- report instead. */
+            if (find_view( want, need ))
+            {
+                ios_soft[i].collisions++;
+                ERR( "ios: CEF soft-pool COLLISION at %p+%p inside soft %p (a live wine view is here)\n",
+                     want, (void *)need, (void *)base );
+                return 1;
+            }
+            {
+                size_t page = host_page_mask + 1, k, npages = need / page;
+                ULONG_PTR first = ((ULONG_PTR)want - base) / page;
+                int prot = (unix_prot ? unix_prot : PROT_READ | PROT_WRITE) & ~PROT_EXEC;
+                struct ios_soft_pool *pool = &ios_soft[i];
+                if (!(prot & PROT_READ)) prot |= PROT_READ;
+                pool->commit_prot = prot;
+                for (k = 0; k < npages; k++)
+                {
+                    IOS_SOFT_CSET( pool, first + k );
+                    if (prot & PROT_WRITE) IOS_SOFT_WSET( pool, first + k );
+                    else IOS_SOFT_WCLR( pool, first + k );
+                    /* Re-commit over an ALREADY materialised page may change its
+                     * protection (PA flips RO<->RW); apply it now, in place. */
+                    if (IOS_SOFT_BIT( pool, first + k ))
+                        mprotect( (char *)base + (first + k) * page, page, prot );
+                }
+            }
+            ios_soft[i].commits++;
+            if (ios_soft[i].commits <= 8 || !(ios_soft[i].commits % 256))
+                ERR( "ios: CEF soft-pool commit(lazy) #%u %p+%p in soft %p (mapped %luMB, faults %lu)\n",
+                     ios_soft[i].commits, want, (void *)need, (void *)base,
+                     (unsigned long)(ios_soft[i].committed >> 20), ios_soft[i].faults );
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int ios_soft_fault( void *page )
+{
+    ULONG_PTR a = (ULONG_PTR)page;
+    size_t pg = host_page_mask + 1;
+    unsigned i;
+
+    for (i = 0; i < ios_soft_n; i++)
+    {
+        struct ios_soft_pool *pool = &ios_soft[i];
+        ULONG_PTR idx;
+        if (a < pool->base || a >= pool->base + pool->size) continue;
+        if (pool->is_phantom)
+        {
+            /* The never-touched bet lost for this consumer: report loudly; the
+             * surfaced fault at a 4TB address names the caller. (No bitmaps on
+             * phantom pools -- nothing can materialise here.) */
+            ERR( "ios: PHANTOM TOUCHED at %p -- the never-touched assumption is wrong for this consumer\n",
+                 (void *)a );
+            return 0;
+        }
+        idx = (a - pool->base) / pg;
+        if (!IOS_SOFT_CBIT( pool, idx )) return 0;     /* not committed -> real fault */
+        if (IOS_SOFT_BIT( pool, idx ))
+        {
+            if (IOS_SOFT_WBIT( pool, idx ))
+            {
+                if (mprotect( (void *)a, pg, PROT_READ | PROT_WRITE ) == 0) return 1;
+                ERR( "ios: soft self-heal mprotect FAILED at %p (%s) -- remapping\n",
+                     (void *)a, strerror( errno ) );
+                if (anon_mmap_fixed( (void *)a, pg, PROT_READ | PROT_WRITE, 0 ) != MAP_FAILED)
+                    return 1;
+                ERR( "ios: soft self-heal remap ALSO failed at %p -- surfacing real fault\n", (void *)a );
+                return 0;
+            }
+            return 0;
+        }
+        {
+            ULONG_PTR npages = pool->size / pg, run = 1, k;
+            int want_w = IOS_SOFT_WBIT( pool, idx ) != 0;
+            int prot = PROT_READ | (want_w ? PROT_WRITE : 0);
+
+            while (run < IOS_SOFT_FAULT_CLUSTER && idx + run < npages)
+            {
+                k = idx + run;
+                if (!IOS_SOFT_CBIT( pool, k )) break;                  /* not committed   */
+                if (IOS_SOFT_BIT( pool, k )) break;                    /* already mapped  */
+                if ((IOS_SOFT_WBIT( pool, k ) != 0) != want_w) break;  /* different prot  */
+                run++;
+            }
+            if (anon_mmap_fixed( (void *)a, run * pg, prot, 0 ) == MAP_FAILED)
+            {
+                /* a cluster can straddle a hole something else already owns */
+                if (run == 1 || anon_mmap_fixed( (void *)a, pg, prot, 0 ) == MAP_FAILED)
+                {
+                    pool->collisions++;
+                    ERR( "ios: CEF soft-pool demand-map FAILED at %p (%s)\n", (void *)a, strerror( errno ) );
+                    return 0;
+                }
+                run = 1;
+            }
+            for (k = 0; k < run; k++) IOS_SOFT_SET( pool, idx + k );
+            pool->committed += run * pg;
+            if (!(++pool->faults & 0x3fff))
+                ERR( "ios: CEF soft-pool demand faults %lu in soft %p (mapped %luMB, last run %lu pages)\n",
+                     pool->faults, (void *)pool->base, (unsigned long)(pool->committed >> 20),
+                     (unsigned long)run );
+        }
+        return 1;
+    }
+    return 0;
+}
+
+static int ios_soft_free( char *base, SIZE_T *size, ULONG type, unsigned int *status )
+{
+    unsigned i, j;
+    ULONG_PTR a = (ULONG_PTR)base;
+
+    for (i = 0; i < ios_soft_n; i++)
+    {
+        ULONG_PTR lo = ios_soft[i].base - ios_soft[i].guard, hi = ios_soft[i].base + ios_soft[i].size;
+        if (a < lo || a >= hi) continue;
+        /* Phantom: bookkeeping only (no bitmaps, nothing mapped). Decommit and
+         * release are paper successes; a tail release still rolls pack_next
+         * back so the VA range is re-grantable. */
+        if (ios_soft[i].is_phantom)
+        {
+            ULONG_PTR fend = *size ? a + *size : hi;
+            if ((type & MEM_RELEASE) && fend - ios_soft[i].base == ios_soft[i].pack_next)
+                ios_soft[i].pack_next = a - ios_soft[i].base;
+            if (!*size) *size = hi - a;
+            *status = STATUS_SUCCESS;
+            return 1;
+        }
+        if (type == MEM_DECOMMIT)
+        {
+            ULONG_PTR end = *size ? a + *size : hi;
+            /* bump band: a size-0 decommit means "this allocation", never
+             * "to the end of the 16GB pool" (that clobbers later members) */
+            if (!*size && ios_midsize_is_band( ios_soft[i].base ))
+            {
+                unsigned ai;
+                end = a + host_page_mask + 1;
+                for (ai = 0; ai < ios_mid_alloc_n; ai++)
+                    if (ios_mid_allocs[ai].base == a) { end = a + ios_mid_allocs[ai].size; break; }
+            }
+            ULONG_PTR s = (a + host_page_mask) & ~host_page_mask, e = end & ~host_page_mask;
+            if (end > hi) end = hi;
+            if (e > end) e = end;
+            if (e > s)
+            {
+                size_t page = host_page_mask + 1, k;
+                anon_mmap_fixed( (void *)s, e - s, PROT_NONE, MAP_NORESERVE );
+                for (k = (s - ios_soft[i].base) / page; k < (e - ios_soft[i].base) / page; k++)
+                { IOS_SOFT_CLR( &ios_soft[i], k ); IOS_SOFT_CCLR( &ios_soft[i], k ); IOS_SOFT_WCLR( &ios_soft[i], k ); }
+                if (ios_soft[i].committed >= e - s) ios_soft[i].committed -= e - s;
+                else ios_soft[i].committed = 0;
+            }
+            /* Partial host pages stay mapped; a recommit must read zero, so zero
+             * the decommitted slice now (mapped pages only). */
+            {
+                size_t page = host_page_mask + 1;
+                ULONG_PTR lo2 = a, hi2 = end, cut;
+                if (e > s) { /* the middle is gone; only the head and tail slices remain */
+                    if (lo2 < s && IOS_SOFT_BIT( &ios_soft[i], (lo2 & ~host_page_mask) - ios_soft[i].base ? ((lo2 & ~host_page_mask) - ios_soft[i].base) / page : 0 ))
+                        memset( (void *)lo2, 0, s - lo2 );
+                    if (hi2 > e && IOS_SOFT_BIT( &ios_soft[i], ((hi2 & ~host_page_mask) - ios_soft[i].base) / page ))
+                        memset( (void *)e, 0, hi2 - e );
+                }
+                else if (hi2 > lo2 && IOS_SOFT_BIT( &ios_soft[i], ((lo2 & ~host_page_mask) - ios_soft[i].base) / page ))
+                {
+                    for (cut = lo2; cut < hi2; )
+                    {
+                        ULONG_PTR pe = (cut & ~host_page_mask) + page, stop = hi2 < pe ? hi2 : pe;
+                        if (IOS_SOFT_BIT( &ios_soft[i], ((cut & ~host_page_mask) - ios_soft[i].base) / page ))
+                            memset( (void *)cut, 0, stop - cut );
+                        cut = stop;
+                    }
+                }
+            }
+            ios_soft[i].decommits++;
+            if (ios_soft[i].decommits <= 8 || !(ios_soft[i].decommits % 256))
+                ERR( "ios: CEF soft-pool decommit #%u %p+%p in soft %p (refenced %p, total %luMB)\n",
+                     ios_soft[i].decommits, base, (void *)*size, (void *)ios_soft[i].base,
+                     (void *)(e > s ? e - s : 0), (unsigned long)(ios_soft[i].committed >> 20) );
+            if (!*size) *size = hi - a;
+            *status = STATUS_SUCCESS;
+            return 1;
+        }
+        if (type & MEM_RELEASE)
+        {
+            if (ios_soft[i].is_pack)
+            {
+                size_t page = host_page_mask + 1, k;
+                ULONG_PTR fend = *size ? a + *size : hi;
+                ULONG_PTR s = (a + host_page_mask) & ~host_page_mask, e = fend & ~host_page_mask;
+                if (e > hi) e = hi;
+                if (e > s)
+                {
+                    anon_mmap_fixed( (void *)s, e - s, PROT_NONE, MAP_NORESERVE );
+                    for (k = (s - ios_soft[i].base) / page; k < (e - ios_soft[i].base) / page; k++)
+                    { IOS_SOFT_CLR( &ios_soft[i], k ); IOS_SOFT_CCLR( &ios_soft[i], k ); IOS_SOFT_WCLR( &ios_soft[i], k ); }
+                    if (ios_soft[i].committed >= e - s) ios_soft[i].committed -= e - s; else ios_soft[i].committed = 0;
+                }
+                if (fend - ios_soft[i].base == ios_soft[i].pack_next)   /* tail: reclaim VA */
+                    ios_soft[i].pack_next = a - ios_soft[i].base;
+                ERR( "ios: CEF packed cage RELEASED %p+%p in slot %p (pack_next %p)\n",
+                     (void *)a, (void *)(fend - a), (void *)ios_soft[i].base, (void *)ios_soft[i].pack_next );
+                if (!*size) *size = hi - a;
+                *status = STATUS_SUCCESS;
+                return 1;
+            }
+            if (ios_midsize_is_band( ios_soft[i].base ))
+            {
+                unsigned ai;
+                ULONG_PTR fbase = 0; SIZE_T fsize;
+                if ((fsize = ios_subres_take( a ))) fbase = a;
+                else for (ai = 0; ai < ios_mid_alloc_n; ai++)
+                    if (ios_mid_allocs[ai].base == a) { fbase = a; fsize = ios_mid_allocs[ai].size; ios_mid_allocs[ai].base = 0; break; }
+                if (fbase && fsize)
+                {
+                    size_t page = host_page_mask + 1, k;
+                    ULONG_PTR s = fbase, e = fbase + fsize;   /* extents are 64KB-aligned */
+                    anon_mmap_fixed( (void *)s, e - s, PROT_NONE, MAP_NORESERVE );
+                    for (k = (s - ios_soft[i].base) / page; k < (e - ios_soft[i].base) / page; k++)
+                    { IOS_SOFT_CLR( &ios_soft[i], k ); IOS_SOFT_CCLR( &ios_soft[i], k ); IOS_SOFT_WCLR( &ios_soft[i], k ); }
+                    if (ios_soft[i].committed >= e - s) ios_soft[i].committed -= e - s; else ios_soft[i].committed = 0;
+                    if (e - ios_soft[i].base == ios_soft[i].pack_next)   /* tail: VA reusable */
+                        ios_soft[i].pack_next = s - ios_soft[i].base;
+                    *size = fsize;
+                }
+                else
+                {
+                    static unsigned midfree_misses;
+                    if (++midfree_misses <= 4)
+                        ERR( "ios: mid-size band free at %p matches no recorded extent -- paper success (leak)\n", (void *)a );
+                    if (!*size) *size = host_page_mask + 1;
+                }
+                *status = STATUS_SUCCESS;
+                return 1;
+            }
+            if (a != lo && a != ios_soft[i].base)
+            {
+                SIZE_T subsz = ios_subres_take( a );
+                if (!subsz) subsz = *size;
+                if (subsz)
+                {
+                    size_t page = host_page_mask + 1, k;
+                    ULONG_PTR s2 = a & ~host_page_mask, e2 = (a + subsz + host_page_mask) & ~host_page_mask;
+                    if (e2 > hi) e2 = hi;
+                    if (e2 > s2)
+                    {
+                        anon_mmap_fixed( (void *)s2, e2 - s2, PROT_NONE, MAP_NORESERVE );
+                        for (k = (s2 - ios_soft[i].base) / page; k < (e2 - ios_soft[i].base) / page; k++)
+                        { IOS_SOFT_CLR( &ios_soft[i], k ); IOS_SOFT_CCLR( &ios_soft[i], k ); IOS_SOFT_WCLR( &ios_soft[i], k ); }
+                        if (ios_soft[i].committed >= e2 - s2) ios_soft[i].committed -= e2 - s2;
+                        else ios_soft[i].committed = 0;
+                    }
+                    *size = subsz;
+                }
+                else
+                {
+                    /* unknown extent: paper success (leak) beats destroying the
+                     * pool every other allocation depends on */
+                    static unsigned subfree_misses;
+                    if (++subfree_misses <= 8)
+                        ERR( "ios: sub-reservation free at %p in pool %p matches no extent -- paper success (leak)\n",
+                             (void *)a, (void *)ios_soft[i].base );
+                    if (!*size) *size = host_page_mask + 1;
+                }
+                {
+                    static unsigned subfrees;
+                    if (++subfrees <= 8)
+                        ERR( "ios: sub-reservation RELEASED %p+%p in pool %p (pool kept)\n",
+                             (void *)a, (void *)*size, (void *)ios_soft[i].base );
+                }
+                *status = STATUS_SUCCESS;
+                return 1;
+            }
+            if (*size && a != lo) { *status = STATUS_FREE_VM_NOT_AT_BASE; return 1; }
+            anon_mmap_fixed( (void *)ios_soft[i].base, ios_soft[i].size, PROT_NONE, MAP_NORESERVE );
+            free( ios_soft[i].map );
+            free( ios_soft[i].cmap );
+            free( ios_soft[i].wmap );
+            ERR( "ios: CEF soft pool RELEASED slot %p size %p (%u commits, %u decommits)\n",
+                 (void *)ios_soft[i].base, (void *)ios_soft[i].size, ios_soft[i].commits, ios_soft[i].decommits );
+            *size = hi - lo;
+            for (j = i + 1; j < ios_soft_n; j++) ios_soft[j - 1] = ios_soft[j];
+            ios_soft_n--;
+            *status = STATUS_SUCCESS;
+            return 1;
+        }
+        *status = STATUS_INVALID_PARAMETER;
+        return 1;
+    }
+    return 0;
+}
+
+static NTSTATUS get_vprot_flags( DWORD protect, unsigned int *vprot, BOOL image );
+static int ios_soft_protect( char *base, SIZE_T size, ULONG new_prot, ULONG *old_prot )
+{
+    unsigned int vprot = 0;
+    int prot, idx = ios_soft_contains( base );
+    ULONG_PTR s, e, a = (ULONG_PTR)base, end = a + size;
+    size_t page = host_page_mask + 1;
+    struct ios_soft_pool *pool;
+
+    if (!idx) return 0;
+    pool = &ios_soft[idx - 1];
+    if (pool->is_phantom) { *old_prot = PAGE_READWRITE; return 1; }   /* paper success */
+    if (get_vprot_flags( new_prot, &vprot, FALSE )) { *old_prot = PAGE_NOACCESS; return 1; }
+    prot = get_unix_prot( vprot ) & ~PROT_EXEC;
+    if (prot) prot |= PROT_READ;
+    s = a & ~host_page_mask;
+    e = (end + host_page_mask) & ~host_page_mask;
+    if (e > pool->base + pool->size) e = pool->base + pool->size;
+    {
+        ULONG_PTR k, first = (s - pool->base) / page, last = (e - pool->base) / page;
+        for (k = first; k < last; k++)
+        {
+            if (prot & PROT_WRITE) IOS_SOFT_WSET( pool, k );
+            else if (s + (k - first) * page >= a && s + (k - first + 1) * page <= end)
+                IOS_SOFT_WCLR( pool, k );   /* only whole inner pages lose W */
+            if (IOS_SOFT_BIT( pool, k ))
+                mprotect( (char *)pool->base + k * page, page,
+                          IOS_SOFT_WBIT( pool, k ) ? (PROT_READ | PROT_WRITE) : (prot ? prot : PROT_READ) );
+        }
+    }
+    *old_prot = PAGE_READWRITE;
+    return 1;
+}
+
+static void ios_soft_release_owner( void *peb )
+{
+    unsigned i = 0, j, n = 0, mid_n = 0;
+    unsigned long long mid_bytes = 0;
+    sigset_t sigset;
+
+    if (!peb) return;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    /* The child's allocations in the shared mid-size bands, each released the
+     * way its own MEM_RELEASE would have: the bands stay, their members go. */
+    for (i = 0; i < ios_mid_alloc_n; i++)
+    {
+        SIZE_T size = 0;
+        SIZE_T was = ios_mid_allocs[i].size;
+        unsigned int status;
+
+        if (!ios_mid_allocs[i].base || ios_mid_allocs[i].owner != peb) continue;
+        if (ios_soft_free( (char *)ios_mid_allocs[i].base, &size, MEM_RELEASE, &status ) && !status)
+        {
+            mid_n++;
+            mid_bytes += was;
+        }
+        ios_mid_allocs[i].base = 0;
+    }
+    i = 0;
+    while (i < ios_soft_n)
+    {
+        if (ios_soft[i].owner != peb) { i++; continue; }
+        if (ios_midsize_is_band( ios_soft[i].base )) { i++; continue; }
+        anon_mmap_fixed( (void *)ios_soft[i].base, ios_soft[i].size, PROT_NONE, MAP_NORESERVE );
+        free( ios_soft[i].map );
+        free( ios_soft[i].cmap );
+            free( ios_soft[i].wmap );
+        ERR( "ios: CEF soft pool RELEASED by reaper: slot %p size %p (%u commits, %u decommits) owner %p\n",
+             (void *)ios_soft[i].base, (void *)ios_soft[i].size, ios_soft[i].commits, ios_soft[i].decommits, peb );
+        for (j = i + 1; j < ios_soft_n; j++) ios_soft[j - 1] = ios_soft[j];
+        ios_soft_n--;
+        n++;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    if (n) fprintf( stderr, "ios: reaper released %u CEF soft pools for retired child peb %p\n", n, peb );
+    if (mid_n) fprintf( stderr, "ios: reaper released %u mid-size allocations (%llu MB) for retired child peb %p\n",
+                        mid_n, mid_bytes >> 20, peb );
+}
+
+static char *stackpool_base, *stackpool_next, *stackpool_end;
+struct ios_stack_free { void *addr; size_t size; struct ios_stack_free *next; };
+static struct ios_stack_free *stackpool_freelist;
+
+static void init_ios_stackpool(void)
+{
+    const char *env = getenv( "WINE_IOS_STACKPOOL_MB" );
+    size_t mb, want;
+    void *p;
+
+    if (stackpool_base) return;
+    if (!env) return;
+    mb = (size_t)atoi( env );
+    if ((long)mb <= 0) mb = 1024;
+    want = mb * 1024 * 1024;
+    p = anon_mmap_alloc( want, PROT_NONE );
+    if (p == MAP_FAILED)
+    {
+        ERR( "ios: thread-stack pool reservation of %zu MB failed; stacks use the general path\n", mb );
+        return;
+    }
+    stackpool_base = stackpool_next = p;
+    stackpool_end = (char *)p + want;
+    ERR( "ios: thread-stack pool %p-%p (%zu MB)\n", stackpool_base, stackpool_end, mb );
+}
+
+/* Recycled fixed-size take: exact-size reuse from the free list, else bump.
+   virtual_mutex held. Returns a PROT_NONE piece; caller sets protection. */
+static void *ios_stackpool_take( size_t size, size_t align_mask )
+{
+    struct ios_stack_free **pp;
+    char *start;
+
+    if (!stackpool_base) return NULL;
+    for (pp = &stackpool_freelist; *pp; pp = &(*pp)->next)
+    {
+        if ((*pp)->size == size && !((UINT_PTR)(*pp)->addr & align_mask))
+        {
+            struct ios_stack_free *n = *pp;
+            void *a = n->addr;
+            *pp = n->next;
+            free( n );
+            return a;
+        }
+    }
+    start = ROUND_ADDR( stackpool_next + align_mask, align_mask );
+    if (start < stackpool_next) return NULL;                    /* wrapped */
+    if ((size_t)(stackpool_end - start) < size) return NULL;    /* exhausted */
+    stackpool_next = start + size;
+    return start;
+}
+
+/* If addr is in the stack pool, drop it back to PROT_NONE and recycle it.
+   virtual_mutex held. Returns 1 if it belonged to the pool (no munmap). */
+static int ios_stackpool_reclaim_view( void *addr, size_t size )
+{
+    struct ios_stack_free *n;
+
+    if (!stackpool_base) return 0;
+    if ((char *)addr < stackpool_base || (char *)addr >= stackpool_end) return 0;
+    anon_mmap_fixed( addr, size, PROT_NONE, MAP_NORESERVE );
+    if ((n = malloc( sizeof(*n) )))
+    {
+        n->addr = addr;
+        n->size = size;
+        n->next = stackpool_freelist;
+        stackpool_freelist = n;
+    }   /* malloc failure just leaves the piece reserved-but-unlisted: no leak of address space, only of reuse */
+    return 1;
+}
+
+static inline size_t arena_page_index( const void *addr )
+{
+    return ((const char *)addr - arena_lo) / host_page_size;
+}
+
+static void mark_arena_unblessed( const void *addr, size_t size )
+{
+    size_t i, first, last;
+
+    if (!arena_unblessed || !is_arena_range( addr )) return;
+    first = arena_page_index( addr );
+    last  = arena_page_index( (const char *)addr + size - 1 );
+    for (i = first; i <= last; i++) arena_unblessed[i / 8] |= 1 << (i % 8);
+}
+
+/* Is this address backed by blessed pages whose protection must not be touched? */
+static inline BOOL is_arena_addr( const void *addr )
+{
+    size_t i;
+
+    if (!is_arena_range( addr )) return FALSE;
+    if (!arena_unblessed) return TRUE;
+    i = arena_page_index( addr );
+    return !(arena_unblessed[i / 8] & (1 << (i % 8)));
+}
+
+static void mark_arena_jit( const void *addr, size_t size )
+{
+    size_t i, first, last;
+
+    if (!arena_jit || !is_arena_range( addr )) return;
+    first = arena_page_index( addr );
+    last  = arena_page_index( (const char *)addr + size - 1 );
+    for (i = first; i <= last; i++) arena_jit[i / 8] |= 1 << (i % 8);
+}
+
+static inline BOOL is_arena_jit( const void *addr )
+{
+    size_t i;
+
+    if (!arena_jit || !is_arena_range( addr )) return FALSE;
+    i = arena_page_index( addr );
+    return !!(arena_jit[i / 8] & (1 << (i % 8)));
+}
+
+static void ios_arena_free_blessed_runs( const void *addr, size_t size, BOOL jit )
+{
+    const char *p = addr, *end = (const char *)addr + size;
+    const char *run = NULL;
+    size_t dropped = 0;
+
+    for (; p < end; p += host_page_size)
+    {
+        if (is_arena_addr( p ))
+        {
+            if (!run) run = p;
+            continue;
+        }
+        dropped += host_page_size;
+        if (run)
+        {
+            if (jit) p_arena_free_jit( (void *)run, (size_t)(p - run) );
+            else p_arena_free( (void *)run, (size_t)(p - run) );
+            run = NULL;
+        }
+    }
+    if (run)
+    {
+        if (jit) p_arena_free_jit( (void *)run, (size_t)(end - run) );
+        else p_arena_free( (void *)run, (size_t)(end - run) );
+    }
+    if (dropped)
+    {
+        static unsigned n;
+        if (++n <= 16)
+            fprintf( stderr, "ios: kept %zu KB of %p+%lx out of the arena free list "
+                     "(de-blessed, cannot execute)\n", dropped >> 10, addr, (unsigned long)size );
+    }
+}
+
+static BOOL ios_arena_reclaim_view( const void *addr, size_t size )
+{
+    size_t i, first, last;
+    BOOL reusable_jit = p_arena_free_jit && is_arena_range( addr ) &&
+                        (ios_in_reaper ? ios_reaper_reusable : is_arena_jit( addr ));
+
+    /* Any arena-backed view (image or FEX code buffer) has a write alias and
+     * lives in the arena range. is_arena_jit only covers FEX buffers, so range
+     * is the correct test -- the big CEF DLL image views are not marked jit. */
+    if (!p_arena_free || !is_arena_range( addr )) return FALSE;
+    if (arena_jit)
+    {
+        first = arena_page_index( addr );
+        last  = arena_page_index( (const char *)addr + size - 1 );
+        for (i = first; i <= last; i++) arena_jit[i / 8] &= ~(1 << (i % 8));
+    }
+    if (arm64ec_map && arm64ec_view && (ULONG_PTR)addr + size <= arm64ec_map_limit)
+    {
+        size_t start = ((size_t)addr >> page_shift) / 8;
+        size_t end = (((size_t)addr + size) >> page_shift) / 8;
+        void *base = ROUND_ADDR( (char *)arm64ec_view->base + start, page_mask );
+        set_vprot( arm64ec_view, base, ROUND_SIZE( start, end + 1 - start, page_mask ),
+                   VPROT_READ | VPROT_WRITE | VPROT_COMMITTED );
+        clear_arm64ec_range( addr, size );
+    }
+    /* The fixed-base exe window is overmapped, unblessed memory the allocator
+     * never hands out; leave it mapped for the next such exe. */
+    if (arena_exe_lo && (const char *)addr >= arena_exe_lo && (const char *)addr < arena_exe_hi)
+        return TRUE;
+    if (reusable_jit)
+    {
+        if (!ios_in_reaper) ERR( "ios: JIT buffer %p size %lx returned to the arena for reuse\n", addr, size );
+        ios_arena_free_blessed_runs( addr, size, TRUE );
+    }
+    else ios_arena_free_blessed_runs( addr, size, FALSE );
+    return TRUE;
+}
+
+/* Reclaim every arena view a retired threaded child created. Called by the
+ * reaper AFTER it has joined all the child's threads, so nothing executes from
+ * these images any more. Batches because delete_view mutates views_tree. */
+static BOOL ios_child_arena_reusable( void *peb )
+{
+    /* Steam's web helper restarts after every game Steam runs without it: its
+     * ranges must come back too. Safe once the reaper joins every thread of
+     * a child before reclaiming (it used to skip past 128 and join twice). */
+    static const WCHAR *const keys[] = { u"\\explorer.exe", u"\\cmd.exe", u"\\steamapps\\",
+                                         u"\\steamwebhelper.exe" };
+    RTL_USER_PROCESS_PARAMETERS *params;
+    UNICODE_STRING name;
+    WCHAR buf[512];
+    size_t len, i, j, k;
+
+    if (!ios_safe_read( (unsigned long)&((PEB *)peb)->ProcessParameters, &params, sizeof(params) ) || !params) return FALSE;
+    if (!ios_safe_read( (unsigned long)&params->ImagePathName, &name, sizeof(name) ) || !name.Buffer) return FALSE;
+    len = min( name.Length / sizeof(WCHAR), ARRAY_SIZE(buf) );
+    if (!ios_safe_read( (unsigned long)name.Buffer, buf, len * sizeof(WCHAR) )) return FALSE;
+    for (k = 0; k < ARRAY_SIZE(keys); k++)
+    {
+        size_t klen = 0;
+        while (keys[k][klen]) klen++;
+        for (i = 0; i + klen <= len; i++)
+        {
+            for (j = 0; j < klen; j++)
+            {
+                WCHAR c = buf[i + j];
+                if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+                if (c != keys[k][j]) break;
+            }
+            if (j == klen) return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void ios_peb_image_name( void *peb, char *out, size_t outlen )
+{
+    RTL_USER_PROCESS_PARAMETERS *params;
+    UNICODE_STRING name;
+    WCHAR buf[256];
+    size_t len, i, start = 0;
+
+    out[0] = 0;
+    if (!peb) { strcpy( out, "(host)" ); return; }
+    if (!ios_safe_read( (unsigned long)&((PEB *)peb)->ProcessParameters, &params, sizeof(params) ) || !params) return;
+    if (!ios_safe_read( (unsigned long)&params->ImagePathName, &name, sizeof(name) ) || !name.Buffer) return;
+    len = min( name.Length / sizeof(WCHAR), ARRAY_SIZE(buf) );
+    if (!ios_safe_read( (unsigned long)name.Buffer, buf, len * sizeof(WCHAR) )) return;
+    for (i = 0; i < len; i++) if (buf[i] == '\\') start = i + 1;   /* basename only */
+    for (i = 0; start + i < len && i + 1 < outlen; i++)
+    {
+        WCHAR c = buf[start + i];
+        out[i] = (c > 0 && c < 128) ? (char)c : '?';
+    }
+    out[i] = 0;
+}
+
+__attribute__((visibility("default"))) void ios_arena_report_owners(void)
+{
+    struct { void *peb; size_t bytes; unsigned views; } own[32];
+    unsigned nown = 0, i, printed;
+    struct file_view *view;
+    size_t total = 0;
+    char line[512], iname[128];
+    int n;
+
+    WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+    {
+        if (!view->write_delta) continue;          /* not arena-backed */
+        total += view->size;
+        for (i = 0; i < nown; i++) if (own[i].peb == view->ios_owner_peb) break;
+        if (i == nown)
+        {
+            if (nown == ARRAY_SIZE(own)) continue;
+            own[nown].peb = view->ios_owner_peb; own[nown].bytes = 0; own[nown].views = 0; nown++;
+        }
+        own[i].bytes += view->size;
+        own[i].views++;
+    }
+
+    n = snprintf( line, sizeof(line), "ios: ARENA-OWNERS %zu MB held by %u owners\n", total >> 20, nown );
+    if (n > 0) write( 2, line, (size_t)n );
+
+    for (printed = 0; printed < nown && printed < 8; printed++)
+    {
+        unsigned best = 0, j;
+
+        for (j = 1; j < nown; j++) if (own[j].bytes > own[best].bytes) best = j;
+        if (!own[best].bytes) break;
+        ios_peb_image_name( own[best].peb, iname, sizeof(iname) );
+        n = snprintf( line, sizeof(line), "ios: ARENA-OWNERS   %-28s %4zu MB in %u views (peb %p)\n",
+                      iname[0] ? iname : "(unknown)", own[best].bytes >> 20, own[best].views, own[best].peb );
+        if (n > 0) write( 2, line, (size_t)n );
+        own[best].bytes = 0;
+    }
+}
+
+/* Everything a retired child owned: its arena views (images, JIT) and the
+ * memory its own code allocated or mapped. Its threads have all been joined. */
+void ios_reclaim_owner_arena_views( void *peb )
+{
+    sigset_t sigset;
+    unsigned reclaimed = 0;
+    unsigned long long bytes = 0;
+    BOOL reusable;
+
+    if (!peb) return;
+    reusable = ios_child_arena_reusable( peb );
+    for (;;)
+    {
+        struct file_view *batch[256];
+        struct file_view *view;
+        unsigned n = 0, i;
+
+        server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+        WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+        {
+            if (n == 256) break;
+            if (view->ios_owner_peb != peb) continue;
+            if (!view->write_delta && (view->protect & VPROT_SYSTEM)) continue;
+            bytes += view->size;
+            batch[n++] = view;
+        }
+        ios_in_reaper = TRUE;
+        ios_reaper_reusable = reusable;
+        for (i = 0; i < n; i++) delete_view( batch[i] );
+        ios_in_reaper = FALSE;
+        ios_reaper_reusable = FALSE;
+        server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+        reclaimed += n;
+        if (n < 256) break;
+    }
+    if (reclaimed) fprintf( stderr, "ios: reaper reclaimed %u views (%llu MB) for retired child peb %p%s\n",
+                            reclaimed, bytes >> 20, peb, reusable ? " (reusable)" : "" );
+    ios_soft_release_owner( peb );
+}
+
+static BOOL no_write_forward(void)
+{
+    static int cached = -1;
+
+    if (cached < 0) cached = getenv( "WINE_IOS_WRITE_FORWARD" ) == NULL;
+    return cached;
+}
+
+/* Whether the current allocation was made by the application rather than by
+ * FEX. Wine's ARM64EC NtAllocateVirtualMemory(Ex) wrappers set
+ * InSyscallCallback to 2 around the syscall; FEX's own calls skip them and
+ * leave 1. An application's executable memory holds x86-64 code, which FEX
+ * only reads, so it needs no blessed arena page. In the arena every store to it
+ * faulted and was replayed through the alias (slow for a JIT emitting code, and
+ * a store-exclusive cannot be replayed, so FEX's atomics on it looped until the
+ * page was force-remapped, which also lost FEX's write traps); outside it,
+ * Windows protection applies and FEX traps translated code as upstream.
+ * KITSUNE_APP_EXEC_IN_ARENA=1 restores the arena placement. */
+static BOOL ios_app_vm_call(void)
+{
+    static int in_arena = -1;
+    CHPE_V2_CPU_AREA_INFO *area = NtCurrentTeb()->ChpeV2CpuAreaInfo;
+
+    if (in_arena < 0) in_arena = getenv( "KITSUNE_APP_EXEC_IN_ARENA" ) != NULL;
+    return !in_arena && area && area->InSyscallCallback == 2;
+}
+
+void *ios_arena_write_alias( const void *addr )
+{
+    /* is_arena_addr() is already "in the arena AND still blessed" -- a page
+     * that gave up its blessing is genuinely writable, so a fault on it is a
+     * real fault and must not be replayed. */
+    if (!arena_delta || !is_arena_addr( addr )) return NULL;
+    return (char *)addr + arena_delta;
+}
+
+/* Whether Windows would let a store to addr through. Blessed arena pages stay
+ * r-x on the host whatever their Windows protection, so every store to one
+ * faults; only a store to a page that is writable at the Windows level may be
+ * forwarded through the alias. The others must raise the access violation (or
+ * guard page violation) they raise on Windows: FEX write-protects the RWX pages
+ * it has translated code from and relies on that fault to drop the stale
+ * translation, which is how a JIT that patches its own code (Mono) works.
+ * Lock-free like get_page_vprot(); called from the signal handler. */
+BOOL ios_arena_store_allowed( const void *addr )
+{
+    BYTE vprot = get_page_vprot( addr );
+
+    return (vprot & VPROT_COMMITTED) && (vprot & (VPROT_WRITE | VPROT_WRITECOPY)) &&
+           !(vprot & VPROT_GUARD);
+}
+
+#else
+/* Keep non-iOS host builds source-compatible with mprotect_exec() below.  The
+ * branch is unreachable because is_arena_addr() is always false, but the
+ * compiler must still be able to parse it. */
+static const ptrdiff_t arena_delta;
+static inline BOOL no_write_forward(void) { return TRUE; }
+static inline BOOL is_arena_addr( const void *addr ) { return FALSE; }
+static inline void mark_arena_unblessed( const void *addr, size_t size ) { }
+static inline BOOL is_arena_jit( const void *addr ) { return FALSE; }
+#endif
+
+
+static NTSTATUS get_vprot_flags( DWORD protect, unsigned int *vprot, BOOL image )
+{
+    switch(protect & 0xff)
+    {
+    case PAGE_READONLY:
+        *vprot = VPROT_READ;
+        break;
+    case PAGE_READWRITE:
+        if (image)
+            *vprot = VPROT_READ | VPROT_WRITECOPY;
+        else
+            *vprot = VPROT_READ | VPROT_WRITE;
+        break;
+    case PAGE_WRITECOPY:
+        *vprot = VPROT_READ | VPROT_WRITECOPY;
+        break;
+    case PAGE_EXECUTE:
+        *vprot = VPROT_EXEC;
+        break;
+    case PAGE_EXECUTE_READ:
+        *vprot = VPROT_EXEC | VPROT_READ;
+        break;
+    case PAGE_EXECUTE_READWRITE:
+        if (image)
+            *vprot = VPROT_EXEC | VPROT_READ | VPROT_WRITECOPY;
+        else
+            *vprot = VPROT_EXEC | VPROT_READ | VPROT_WRITE;
+        break;
+    case PAGE_EXECUTE_WRITECOPY:
+        *vprot = VPROT_EXEC | VPROT_READ | VPROT_WRITECOPY;
+        break;
+    case PAGE_NOACCESS:
+        *vprot = 0;
+        break;
+    default:
+        return STATUS_INVALID_PAGE_PROTECTION;
+    }
+    if (protect & PAGE_GUARD) *vprot |= VPROT_GUARD;
+    return STATUS_SUCCESS;
+}
+
+
+static inline int mprotect_exec( void *base, size_t size, int unix_prot )
+{
+    /* JIT pages keep their blessing no matter what is asked of them; the caller
+     * writes through the alias. See is_arena_jit(). */
+    if (is_arena_jit( base )) return 0;
+
+    if (is_arena_addr( base ))
+    {
+        char *pg;
+
+        if (!(unix_prot & PROT_WRITE)) return 0;   /* already R+X */
+
+        if ((unix_prot & PROT_EXEC) && arena_delta && !no_write_forward())
+        {
+            static int once;
+
+            if (!once++)
+                ERR( "ios: %p wants write+exec; keeping it executable and "
+                     "forwarding writes through the alias (4k section "
+                     "alignment)\n", base );
+            return 0;
+        }
+
+        if (unix_prot & PROT_EXEC)
+            ERR( "ios: %p wants write+exec; de-blessing, so code on this page "
+                 "stops running. A module with 4k section alignment will do "
+                 "this -- rebuild it with --section-alignment=0x10000\n", base );
+
+        for (pg = base; pg < (char *)base + size; pg += host_page_size)
+        {
+            if (!is_arena_addr( pg )) continue;    /* already gave up its blessing */
+            if (mprotect( pg, host_page_size, unix_prot )) return -1;
+            mark_arena_unblessed( pg, host_page_size );
+        }
+        return 0;
+    }
+
+    if (force_exec_prot && (unix_prot & PROT_READ) && !(unix_prot & PROT_EXEC))
+    {
+        TRACE( "forcing exec permission on %p-%p\n", base, (char *)base + size - 1 );
+        if (!mprotect( base, size, unix_prot | PROT_EXEC )) return 0;
+        /* exec + write may legitimately fail, in that case fall back to write only */
+        if (!(unix_prot & PROT_WRITE)) return -1;
+    }
+
+    if (mprotect( base, size, unix_prot ))
+    {
+        static unsigned stripped;
+        if (!(unix_prot & PROT_EXEC)) return -1;
+        if (mprotect( base, size, unix_prot & ~PROT_EXEC )) return -1;
+        if (stripped++ < 8)
+            ERR( "ios: %p+%#zx exec refused by iOS; mapped %s without host exec (FEX reads guest code)\n",
+                 base, size, (unix_prot & PROT_WRITE) ? "RW" : "R" );
+    }
+    return 0;
+}
+
+
+static int mprotect_range( void *base, size_t size, BYTE set, BYTE clear )
+{
+    size_t i, count;
+    char *addr = ROUND_ADDR( base, host_page_mask );
+    int prot, next;
+    BYTE vprot;
+
+    size = ROUND_SIZE( base, size, host_page_mask );
+
+    vprot = get_host_page_vprot( addr );
+    prot = get_unix_prot( (vprot & ~clear) | set );
+    for (count = i = 1; i < size / host_page_size; i++, count++)
+    {
+        vprot = get_host_page_vprot( addr + count * host_page_size );
+        next = get_unix_prot( (vprot & ~clear) | set );
+        if (next == prot) continue;
+        if (mprotect_exec( addr, count * host_page_size, prot )) return -1;
+        addr += count * host_page_size;
+        prot = next;
+        count = 0;
+    }
+    return mprotect_exec( addr, count * host_page_size, prot );
+}
