+        status = STATUS_NO_MEMORY; goto failed;
+    }
+    status = NtAllocateVirtualMemory( NtCurrentProcess(), (void **)&boot->peb, 0, &size,
+                                      MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE );
+    if (status) { ERR( "ios: threaded child: PEB allocation failed %#x\n", status ); goto failed; }
+    boot->peb->NumberOfProcessors = RtlGetCurrentPeb()->NumberOfProcessors;
+    boot->peb->ApiSetMap = RtlGetCurrentPeb()->ApiSetMap; /* immutable shared schema */
+    dbg_init_child_peb( boot->peb );
