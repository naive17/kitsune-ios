+    int reply_pipe;
+    if (!data || !data->ios_process || !data->ios_process->state->child || !data->teb)
+        return STATUS_INVALID_PARAMETER;
+    data->request_fd = wine_server_receive_fd( &version );
+    if (data->request_fd < 0 || version != SERVER_PROTOCOL_VERSION) return STATUS_REVISION_MISMATCH;
+    reply_pipe = init_thread_pipe( data );
