+/* substring search of an ASCII needle in a (non-null-terminated) WCHAR buffer */
+static int wcsstr_ascii( const WCHAR *hay, unsigned long haylen, const char *needle )
+{
+    unsigned long nlen = 0, i, j;
+    while (needle[nlen]) nlen++;
+    if (!nlen) return 1;
+    for (i = 0; i + nlen <= haylen; i++)
+    {
+        for (j = 0; j < nlen; j++) if (hay[i+j] != (WCHAR)needle[j]) break;
+        if (j == nlen) return 1;
+    }
+    return 0;
+}
