+#define IOS_LOW_USD_BASE 0x7ffe0000ULL
+static BOOL ios_emulate_low_usd_read( siginfo_t *siginfo, ucontext_t *sigcontext, DWORD64 esr )
+{
+    ULONG_PTR addr = (ULONG_PTR)siginfo->si_addr, pc = PC_sig( sigcontext );
+    unsigned instr, rt, size_log2;
+    const void *src;
+    UINT64 value = 0;
+
+    if (addr < IOS_LOW_USD_BASE || addr >= IOS_LOW_USD_BASE + page_size) return FALSE;
+    if (esr & 0x40) return FALSE;            /* writes to USD are not expected; let them fault */
+    if (pc & 3) return FALSE;
+    if (!user_shared_data) return FALSE;
+    instr = *(ULONG *)pc;
+    rt = instr & 0x1f;
+
+    if ((instr & 0x3b400000) == 0x39400000)          /* LDR (unsigned offset), zero-extend */
+        size_log2 = instr >> 30;
+    else if ((instr & 0x3b600c00) == 0x38400000)     /* LDUR (unscaled), zero-extend */
+        size_log2 = instr >> 30;
+    else if ((instr & 0x3ffffc00) == 0x08dffc00)     /* LDAR */
+        size_log2 = instr >> 30;
+    else
+    {
+        static int unknown;
+        if (unknown++ < 8)
+            ERR( "ios-usd: read at %p not decoded: instr %08x pc %p -- add this load form\n",
+                 siginfo->si_addr, instr, (void *)pc );
+        return FALSE;
+    }
+
+    src = (const char *)user_shared_data + (addr - IOS_LOW_USD_BASE);
+    if (addr - IOS_LOW_USD_BASE + ((SIZE_T)1 << size_log2) > page_size) return FALSE;
+    switch (size_log2)
+    {
+    case 0: value = *(const volatile UINT8 *)src;  break;
+    case 1: value = *(const volatile UINT16 *)src; break;
+    case 2: value = *(const volatile UINT32 *)src; break;
+    default:value = *(const volatile UINT64 *)src; break;
+    }
+    if (rt != 31) REGn_sig( rt, sigcontext ) = value;   /* W-reg writes zero-extend to X */
+    {
+        static int once;
+        if (!once++)
+            ERR( "ios-usd: emulating CEF KUSER_SHARED_DATA reads at 0x7ffe0000 "
+                 "from relocated USD %p (first %p instr %08x)\n",
+                 user_shared_data, siginfo->si_addr, instr );
+    }
+    PC_sig( sigcontext ) += 4;
+    return TRUE;
+}
