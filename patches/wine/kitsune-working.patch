+    if ((fd = fcntl( socketfd, F_DUPFD_CLOEXEC, 0 )) < 0)
+    {
+        ERR( "ios: threaded child: socket dup failed (%s)\n", strerror( errno ) );
+        status = STATUS_TOO_MANY_OPENED_FILES; goto failed;
+    }
+    if ((status = ios_bind_child_context( boot->data, &boot->state, boot->peb, fd )))
+    {
+        ERR( "ios: threaded child: ios_bind_child_context failed %#x\n", status );
+        goto failed;
+    }
