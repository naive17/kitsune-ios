+            }
+        }
+        for (sl = IOS_CEF_POOL_LO; sl + IOS_CEF_SLOT <= ios_cef_band_hi; sl += IOS_CEF_SLOT)
+        {
+            void *p = anon_mmap_tryfixed( (char *)sl, IOS_CEF_SLOT, PROT_NONE, MAP_NORESERVE );
+            if (p == (void *)sl)
+                ERR( "ios: CEF slot fenced %p-%p\n", (void *)sl, (void *)(sl + IOS_CEF_SLOT) );
+            else
+            {
+                if (p != MAP_FAILED) munmap( p, IOS_CEF_SLOT );
+                ios_cef_unfenced |= IOS_CEF_SLOT_BIT( sl );
+                ERR( "ios: CEF slot %p already occupied; no soft pool goes there\n", (void *)sl );
+            }
+        }
+        /* The low-band tail becomes one more segment for large RW allocs. */
+        {
+            size_t extra_len = IOS_LOW_EXTRA_HI - IOS_LOW_EXTRA_LO;
+            void *p = anon_mmap_fixed( (void *)IOS_LOW_EXTRA_LO, extra_len,
+                                       PROT_NONE, MAP_NORESERVE );
+            if (p == (void *)IOS_LOW_EXTRA_LO)
+            {
+                struct bigpool_seg *seg = malloc( sizeof(*seg) );
+                if (seg)
+                {
+                    /* [IOS_V8_LOW_LO, IOS_V8_LOW_HI) stays fenced for the V8 sandbox */
+                    seg->base = (char *)IOS_V8_LOW_HI; seg->next = (char *)IOS_V8_LOW_HI;
+                    seg->end = (char *)p + extra_len;
+                    seg->link = bigpool_extra_segs; bigpool_extra_segs = seg;
+                    got += (size_t)(IOS_LOW_EXTRA_HI - IOS_V8_LOW_HI);
+                    ERR( "ios: big-reservation EXTRA segment %p-%p (%zu MB, low-band tail); total %zu MB\n",
+                         p, (char *)p + extra_len, extra_len / (1024 * 1024), got / (1024 * 1024) );
+                }
+                else munmap( p, extra_len );
+            }
+            else
+            {
+                if (p != MAP_FAILED) munmap( p, extra_len );
+                ERR( "ios: low-band tail %p could not be claimed (%p, errno %d)\n",
+                     (void *)IOS_LOW_EXTRA_LO, p, errno );
+            }
+        }
+        if (bigpool_base)
+        {
+            ios_slack_armed = (ios_slack_hi > ios_slack_lo);
+            ERR( "ios: big-reservation pool ready, %zu MB (CEF bands fenced for soft pools)\n",
+                 got / (1024 * 1024) );
+            return;
+        }
+        ERR( "ios: the bigpool band could not be reserved; falling back to the ladder\n" );
+    }
+
+    for (i = 0; i < ARRAY_SIZE(ladder); i++)
+    {
+        size_t want = ladder[i] * (size_t)1024 * 1024;
+        void *p = anon_mmap_alloc( want, PROT_NONE );
+
+        if (p == MAP_FAILED) continue;
+        bigpool_base = p;
+        bigpool_next = p;
+        bigpool_end  = (char *)p + want;
+        ERR( "ios: big-reservation pool %p-%p (%zu MB)\n", bigpool_base, bigpool_end, ladder[i] );
+        return;
+    }
+    ERR( "ios: no big-reservation pool; reservations over ~256 MB will fail\n" );
+}
