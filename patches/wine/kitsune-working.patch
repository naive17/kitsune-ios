diff --git a/dlls/ntdll/unix/ios_fd_cache.h b/dlls/ntdll/unix/ios_fd_cache.h
new file mode 100644
index 0000000..30bf3fe
--- /dev/null
+++ b/dlls/ntdll/unix/ios_fd_cache.h
@@ -0,0 +1,75 @@
+#ifndef KITSUNE_FD_CACHE_H
+#define KITSUNE_FD_CACHE_H
+
+/* Included after Wine's union fd_cache_entry and FD_CACHE_* definitions.
+ * Every function requires fd_cache_mutex, with Wine signals blocked. The
+ * pointer returned by lookup must not escape that critical section. */
+struct ios_fd_cache
+{
+    union fd_cache_entry *blocks[FD_CACHE_ENTRIES];
+    union fd_cache_entry initial_block[FD_CACHE_BLOCK_SIZE];
+};
+
+#define IOS_MAX_FD_CACHES 64
+static struct ios_fd_cache_slot
+{
+    const void *owner;  /* non-NULL PEB; unbound threads are never cached */
+    struct ios_fd_cache *cache;
+} ios_fd_caches[IOS_MAX_FD_CACHES];
+
+static struct ios_fd_cache *ios_get_fd_cache( const void *owner, BOOL create )
+{
+    unsigned int i, vacant = IOS_MAX_FD_CACHES;
+    struct ios_fd_cache *cache;
+
+    if (!owner) return NULL;
+    for (i = 0; i < IOS_MAX_FD_CACHES; ++i)
+    {
+        if (ios_fd_caches[i].owner == owner) return ios_fd_caches[i].cache;
+        if (!ios_fd_caches[i].owner && vacant == IOS_MAX_FD_CACHES) vacant = i;
+    }
+    if (!create || vacant == IOS_MAX_FD_CACHES) return NULL;
+    if (!(cache = calloc( 1, sizeof(*cache) ))) return NULL;
+    ios_fd_caches[vacant].cache = cache;
+    ios_fd_caches[vacant].owner = owner;
+    return cache;
+}
+
+/* Returns how many cached descriptors it closed. */
+static inline unsigned int ios_release_fd_cache( const void *owner )
+{
+    unsigned int slot, i, j, closed = 0;
+    struct ios_fd_cache *cache = NULL;
+
+    if (!owner) return 0;
+    for (slot = 0; slot < IOS_MAX_FD_CACHES; ++slot)
+        if (ios_fd_caches[slot].owner == owner)
+        {
+            cache = ios_fd_caches[slot].cache;
+            ios_fd_caches[slot].owner = NULL;
+            ios_fd_caches[slot].cache = NULL;
+            break;
+        }
+    if (!cache) return 0;
+    for (i = 0; i < FD_CACHE_ENTRIES; ++i)
+    {
+        union fd_cache_entry *block = cache->blocks[i];
+        if (!block) continue;
+        for (j = 0; j < FD_CACHE_BLOCK_SIZE; ++j)
+        {
+            /* Wine encodes real descriptors as fd+1; FD_TYPE_INVALID carries
+             * an NTSTATUS instead. Neither empty nor error entries own fds. */
+            if (block[j].s.fd && block[j].s.type != FD_TYPE_INVALID)
+            {
+                close( block[j].s.fd - 1 );
+                closed++;
+            }
+        }
+        if (block != cache->initial_block)
+            munmap( block, FD_CACHE_BLOCK_SIZE * sizeof(*block) );
+    }
+    free( cache );
+    return closed;
+}
+
+#endif
