+static NTSTATUS find_system_builtin( UNICODE_STRING *nt_name, WINE_MODREF **pwm, HANDLE *mapping,
+                                     SECTION_IMAGE_INFORMATION *image_info, struct file_id *id )
+{
+    const WCHAR *path = nt_name->Buffer + 4;  /* skip \??\ */
+    ULONG len = wcslen( system_dir );
+    WCHAR name[MAX_PATH];
