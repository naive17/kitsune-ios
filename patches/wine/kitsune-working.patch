+#ifdef WINE_IOS_JIT_ARENA
+/* Request mix, printed every 10 s at the Full diagnostics level: whether
+ * synchronization requests dominate decides whether an in-process sync
+ * backend is worth it. */
+extern const char *ios_request_name( enum request req );
+static unsigned int ios_census_counts[REQ_NB_REQUESTS];
+static unsigned int ios_census_total;
+static int ios_census_on = -1;
+static timeout_t ios_census_since;
+
+static void ios_census_tick( enum request req )
+{
+    unsigned int i, j, top[8] = {0}, n;
+    double secs;
+    char line[512];
+    int len;
+
+    if (ios_census_on < 0)
+    {
+        const char *level = getenv( "KITSUNE_DIAG_LEVEL" );
+        ios_census_on = level && atoi( level ) >= 2;
+        ios_census_since = monotonic_time;
+    }
+    if (!ios_census_on || req >= REQ_NB_REQUESTS) return;
+    ios_census_counts[req]++;
+    if (++ios_census_total & 1023) return;
+    if (monotonic_time - ios_census_since < 10 * (timeout_t)TICKS_PER_SEC) return;
+
+    for (i = 0; i < REQ_NB_REQUESTS; i++)
+        for (j = 0; j < 8; j++)
+            if (ios_census_counts[i] > ios_census_counts[top[j]])
+            {
+                memmove( top + j + 1, top + j, (7 - j) * sizeof(top[0]) );
+                top[j] = i;
+                break;
+            }
+    for (i = n = 0; i < REQ_NB_REQUESTS; i++) n += ios_census_counts[i];
+    secs = (double)(monotonic_time - ios_census_since) / TICKS_PER_SEC;
+    len = snprintf( line, sizeof(line), "[server-census] %.0f req/s over %.0f s:", n / secs, secs );
+    for (j = 0; j < 8 && len < (int)sizeof(line) - 48 && n; j++)
+        if (ios_census_counts[top[j]])
+            len += snprintf( line + len, sizeof(line) - len, " %s %u%%", ios_request_name( top[j] ),
+                             (unsigned int)(100ull * ios_census_counts[top[j]] / n) );
+    fprintf( stderr, "%s\n", line );
+    memset( ios_census_counts, 0, sizeof(ios_census_counts) );
+    ios_census_since = monotonic_time;
+}
+#endif
