+            client->trace_packet[index] = packet;
+            client->trace_status[index] = ret;
+            count = ++client->trace_count;
+            emit = TRUE;
+        }
+        ReleaseSRWLockExclusive(&ios_clients_lock);
+        if (emit) WINE_MESSAGE("[ios-xinput] state pid=%04lx slot=%lu ret=%lu enabled=%d held=%d packet=%lu raw-buttons=%04x lt=%u rt=%u l=%d,%d r=%d,%d trace=%lu/128\n",
+                              client->pid, index, ret, enabled, held, packet, pad.buttons,
+                              pad.left_trigger, pad.right_trigger, pad.lx, pad.ly, pad.rx, pad.ry, count);
