+/*
+ * ios-wine: reclaim superseded code buffers.
+ *
+ * When a buffer fills, FEX starts a new one and the old one lives until every
+ * thread drops its reference -- which a thread only does when it next
+ * compiles. Chromium has dozens of threads that never compile again, so on a
+ * 1GB JIT arena the webhelper leaked a 128MB buffer every few minutes until
+ * the arena was gone and nothing (not even a game) could start.
+ *
+ * Nothing needs the old code once lookups can no longer reach it: ARM64EC
+ * exits to native code with a tail branch (ExitFunctionEC), so no native frame
+ * returns into JIT code. What can reach it is the old buffer's own lookup map
+ * and block links, each thread's L1/L2 cache, and the call-ret shadow stack.
+ * Stage 1 purges all of those (the same operations a cross-thread
+ * invalidation performs); a thread still on the old buffer then misses,
+ * compiles, and switches. Stage 2, after a grace period long enough for any
+ * thread that was mid-block to leave it, frees the memory. The CodeBuffer
+ * object itself stays until its last reference goes.
+ */
+void ContextImpl::IosRetireStaleCodeBuffers(FEXCore::Core::InternalThreadState* const* Threads, size_t NumThreads) {
+  /* 5s, not 20: the grace only has to outlast a thread that is mid-block in
+   * the old buffer, and during Dark Souls' level load every stranded 64MB
+   * buffer counts against a 3.7GB ceiling the app dies at (2026-09-23). */
+  static constexpr uint64_t GraceMs = 5000;
+  const uint64_t Now =
+    std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count() | 1;
+
+  fextl::vector<fextl::shared_ptr<CPU::CodeBuffer>> Stale;
+  {
+    std::scoped_lock lk {CodeBufferListLock};
+    if (CodeBufferList.size() < 2) {
+      return;
+    }
+    for (size_t i = 0; i + 1 < CodeBufferList.size(); ++i) {
+      if (auto Strong = CodeBufferList[i].lock(); Strong && !Strong->IosReleased) {
+        Stale.push_back(std::move(Strong));
+      }
+    }
+  }
+
+  for (auto& Buffer : Stale) {
+    if (!Buffer->IosPurgedAtMs) {
+      Buffer->LookupCache->InvalidateRange(0, ~0ULL);
+      for (size_t i = 0; i < NumThreads; ++i) {
+        InvalidateThreadCachedCodeRange(Threads[i], 0, ~0ULL);
+      }
+      Buffer->IosPurgedAtMs = Now;
+      LogMan::Msg::EFmt("ios-codebuf-retire: purged {} ({} MB), {} threads", fmt::ptr(Buffer->Ptr), Buffer->AllocatedSize >> 20, NumThreads);
+    } else if (Now - Buffer->IosPurgedAtMs > GraceMs) {
+      Buffer->IosReleased = true;
+      FEXCore::Allocator::VirtualFree(Buffer->Ptr, Buffer->AllocatedSize);
+      LogMan::Msg::EFmt("ios-codebuf-retire: freed {} ({} MB)", fmt::ptr(Buffer->Ptr), Buffer->AllocatedSize >> 20);
+    }
+  }
+}
