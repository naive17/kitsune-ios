+#ifdef _WIN32
+/*
+ * ios-wine: learn the RW alias of a freshly allocated code buffer.
+ *
+ * On iOS a page can never be writable and executable at once, so Wine hands
+ * out executable memory from a debugger-blessed arena that is mapped twice:
+ * RX where code runs, RW at exec + delta. FEX must branch to the first and
+ * store through the second.
+ *
+ * The delta cannot be discovered from inside a PE module any other way -- the
+ * arena belongs to the iOS app, below Wine, and dlsym() is not reachable from
+ * here. ntdll answers for it through a private NtQueryVirtualMemory class.
+ *
+ * 1100 == MemoryWineIosJitWriteDelta, defined in wine/include/winternl.h.
+ * Repeated rather than included because FEX builds against mingw-w64's headers
+ * and must keep working on real Windows, where this call simply fails and the
+ * delta stays 0.
