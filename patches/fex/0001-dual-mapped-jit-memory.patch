diff --git a/FEXCore/include/FEXCore/Utils/JITWriteAlias.h b/FEXCore/include/FEXCore/Utils/JITWriteAlias.h
new file mode 100644
index 0000000..d6a409a
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/JITWriteAlias.h
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+/*
+ * Dual-mapped JIT memory support (iOS 26+).
+ *
+ * On iOS the app cannot make its own memory executable. Executable pages come
+ * from a debugger handshake (`brk #0xf00d`) which returns an RX region; to write
+ * into it we vm_remap a second, writable view of the same physical pages. So a
+ * given instruction has two addresses:
+ *
+ *      exec  -- where it runs, and what every branch/entry point refers to
+ *      write -- where it must be stored, exec + WriteAliasDelta
+ *
+ * FEX otherwise assumes these are the same pointer. Rather than thread a second
+ * pointer through the emitter, note that FEX already emits into a temporary
+ * buffer and *relocates* finished code into the CodeBuffer -- so only the small
+ * number of places that touch executable memory directly need adjusting:
+ *
+ *   - the relocation memcpy                       (JIT.cpp)
+ *   - block link/delink branch patching           (JIT.cpp, 4 sites)
+ *   - dispatcher emission                         (Dispatcher.cpp)
+ *
+ * WriteAliasDelta is 0 on every other platform, making Write() an identity and
+ * this whole mechanism a no-op there.
+ *
+ * INVARIANT: all code buffers must be carved from ONE blessed region, so a
+ * single delta is valid process-wide. That is required anyway -- regions can
+ * only be blessed before the debugger detaches, so FEX must reserve its code
+ * memory up front.
+ */
+namespace FEXCore::JIT {
+
+// write_address - exec_address. Zero unless dual mapping is in use.
+extern ptrdiff_t WriteAliasDelta;
+
+/*
+ * Bounds of the dual-mapped region, as exec addresses. Write() applies the
+ * delta ONLY inside them.
+ *
+ * This is not defensive programming, it is required for correctness. FEX
+ * compiles each block into a TEMPORARY buffer and only relocates the finished
+ * block into the CodeBuffer at the end:
+ *
+ *     JIT.cpp:865   SetBuffer(TempCodeBuffer, UsableBufferRange);   <- heap
+ *     JIT.cpp:1092  SetBuffer(CurrentCodeBuffer->Ptr, ...);         <- arena
+ *
+ * so the very same Buffer::dcn(), Emitter::Bind() and block-tail memcpy run
+ * against ordinary heap memory for most of their life. Adding the delta there
+ * would store at temp + 0x6e_dfff_0000, which is not mapped at all.
+ *
+ * The earlier version of this patch had no range check and was wrong for every
+ * store made during block compilation. It went unnoticed because nothing had
+ * ever reached the point of compiling a block.
+ */
+extern uintptr_t WriteAliasLo;   // exec base of the arena
+extern size_t WriteAliasSize;    // 0 when no dual mapping is installed
+
+/*
+ * Discover the alias for a freshly allocated executable region and install it.
+ *
+ * Called from FEXCore::Allocator::VirtualAlloc for every Execute=true
+ * allocation, NOT just the CodeBuffer: the dispatcher, the block-linker thunks
+ * and X64ReturnInstr are all separate allocations, and each of them is written
+ * before the first CodeBuffer exists. Installing the delta only at CodeBuffer
+ * creation left the dispatcher emitting through a zero delta, i.e. straight
+ * into the RX mapping -- measured as a fault in
+ * Arm64Emitter::PushCalleeSavedRegisters with x10 (the loaded delta) == 0.
+ *
+ * No-op on every platform where the query is unavailable.
+ */
+void InstallWriteAlias(void* ExecPtr);
+
+/// True if this address is inside the dual-mapped region.
+/// One unsigned compare: a negative difference wraps to a huge unsigned value.
+inline bool IsAliased(uintptr_t Addr) {
+  return (Addr - WriteAliasLo) < WriteAliasSize;
+}
+
+/// Translate an executable address to the address it must be written through.
+/// Returns the pointer unchanged for anything outside the dual-mapped region --
+/// notably the per-block temporary buffer, which is plain heap.
+template<typename T>
+inline T* Write(T* ExecPtr) {
+  const auto Addr = reinterpret_cast<uintptr_t>(ExecPtr);
+  if (!IsAliased(Addr)) {
+    return ExecPtr;
+  }
+  return reinterpret_cast<T*>(Addr + WriteAliasDelta);
+}
+
+} // namespace FEXCore::JIT
