diff --git a/Source/Windows/ARM64EC/CxaEhStorage.cpp b/Source/Windows/ARM64EC/CxaEhStorage.cpp
new file mode 100644
index 0000000..6cd9e4c
--- /dev/null
+++ b/Source/Windows/ARM64EC/CxaEhStorage.cpp
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: MIT
+/*
+ * ios-wine: per-thread C++ exception state WITHOUT compiler thread-local storage.
+ *
+ * WHY THIS FILE EXISTS.  Windows thread-local storage lowers to a hard-coded
+ * TEB read.  Measured with clang 21.1.0 (bylaws) and 23.1.0-rc3, for both
+ * aarch64-w64-mingw32 and arm64ec-w64-mingw32, a single `_Thread_local int`
+ * compiles to:
+ *
+ *     ldr x9, [x18, #0x58]        // TEB->ThreadLocalStoragePointer
+ *
+ * On this port the TEB is in x28, because Darwin ZEROES x18 on return from any
+ * exception -- including plain timer preemption with no syscall involved.  So
+ * that instruction reads a register that is zero most of the time, and the load
+ * faults.  Neither -ffixed-x28 nor -DWINE_TEB_IN_X28 reaches it: it is emitted
+ * by the backend, not by a header.
+ *
+ * libc++abi's cxa_exception_storage.cpp is the only place in libarm64ecfex.dll
+ * where this survives -- everything else goes through NtCurrentTeb(), which the
+ * build patches to read x28 (scripts/06-fex-arm64ec.sh).  It is a PREBUILT
+ * object in the toolchain's libc++abi.a, so it cannot be recompiled here.
+ *
+ * Measured, before this file existed:
+ *
+ *     x18 references in the shipped image: 2
+ *       __cxa_get_globals:      1801b5eb4: ldr x9, [x18, #0x58]
+ *       __cxa_get_globals_fast: 1801b5ed4: ldr x9, [x18, #0x58]
+ *
+ * Both are reached from __cxa_throw / __cxa_begin_catch / __cxa_end_catch,
+ * which are all present and called in the built image, so this is not dead
+ * code that could be ignored.
+ *
+ * HOW.  Defining both symbols here means the linker never extracts
+ * cxa_exception_storage.o from libc++abi.a at all -- this is a translation unit
+ * of the arm64ecfex target itself, so it is on the link line before any
+ * archive.  Storage moves to a TEB TLS slot, reached through FEX's own
+ * TlsGetValue/TlsSetValue, which read the TEB via NtCurrentTeb() and therefore
+ * via x28.
+ *
+ * The block is allocated ZEROED and deliberately OVER-SIZED.  libc++abi's
+ * __cxa_eh_globals is
+ *     { __cxa_exception *caughtExceptions; unsigned int uncaughtExceptions; }
+ * -- 16 bytes -- and has been for many years, but this file cannot include the
+ * private header that declares it.  Over-allocating removes the whole class of
+ * "libc++abi grew a field and we silently corrupted the heap" failure for the
+ * price of a few bytes per thread.
+ *
+ * LIMITATION: the block is leaked when a thread exits.  libc++abi's version is
+ * freed by a thread_local destructor, which is exactly the mechanism being
+ * avoided here.  It is 64 bytes, allocated only on a thread's first throw.
+ *
+ * NOTHING HERE MAY IMPORT ANYTHING BUT NTDLL.  An earlier version of this file
+ * called HeapAlloc/GetProcessHeap, which added
+ *     api-ms-win-core-heap-l1-1-0.dll  ->  kernelbase.dll
+ * to libarm64ecfex.dll's import table.  That is not a size problem, it is a
+ * correctness one: kernelbase then loads as an import of the EMULATOR, i.e.
+ * before ntdll's arm64ec_process_init() has run, so
+ * arm64ec_update_hybrid_metadata() patches kernelbase's
+ * __os_arm64x_dispatch_call/_ret/_fptr slots with the NULLs they still hold.
+ *
+ * The failure is a long way from the cause.  x86 code ran, called
+ * kernelbase!GetStdHandle through its entry thunk, the function returned
+ * correctly, and then the thunk's last instruction
+ *
+ *     1800ef900: ldr x1, [x8, #0x798]   // __os_arm64x_dispatch_ret
+ *     1800ef920: br  x1
+ *
+ * branched to zero.  scripts/06-fex-arm64ec.sh now asserts the import table.
+ */
+
+#include <atomic>
+#include <cstdint>
+
+#include <windows.h>
+#include <winternl.h>
+
+#include "Common/Priv.h"
+
+namespace {
+// Generously sized; see the note above about not being able to include
+// libc++abi's private cxa_exception.h.
+constexpr size_t EhGlobalsSize = 64;
+
+constexpr uint32_t NoSlot = 0xFFFFFFFFu;
+std::atomic<uint32_t> EhTlsSlot {NoSlot};
+
+uint32_t AcquireSlot() {
+  uint32_t Slot = EhTlsSlot.load(std::memory_order_acquire);
+  if (Slot != NoSlot) {
+    return Slot;
+  }
+
+  // Two threads can race here; the loser gives its slot straight back rather
+  // than leaking a TLS index, of which there are only 64 before the expansion
+  // slots (which FEX's TlsAlloc deliberately refuses to use).
+  const uint32_t Fresh = ::TlsAlloc();
+  if (Fresh == TLS_OUT_OF_INDEXES) {
+    return NoSlot;
+  }
+
+  uint32_t Expected = NoSlot;
+  if (EhTlsSlot.compare_exchange_strong(Expected, Fresh, std::memory_order_acq_rel)) {
+    return Fresh;
+  }
+  ::TlsFree(Fresh);
+  return Expected;
+}
+} // namespace
+
+extern "C" {
+
+// Returns the calling thread's exception globals, creating them if needed.
+void* __cxa_get_globals() {
+  const uint32_t Slot = AcquireSlot();
+  if (Slot == NoSlot) {
+    return nullptr;
+  }
+
+  void* Globals = ::TlsGetValue(Slot);
+  if (!Globals) {
+    // RtlAllocateHeap, not HeapAlloc: ntdll only. See the header comment.
+    Globals = ::RtlAllocateHeap(GetCurrentPEB()->ProcessHeap, HEAP_ZERO_MEMORY, EhGlobalsSize);
+    ::TlsSetValue(Slot, Globals);
+  }
+  return Globals;
+}
+
+// Same, but must not allocate. libc++abi's callers null-check this.
+void* __cxa_get_globals_fast() {
+  const uint32_t Slot = EhTlsSlot.load(std::memory_order_acquire);
+  if (Slot == NoSlot) {
+    return nullptr;
+  }
+  return ::TlsGetValue(Slot);
+}
+
+} // extern "C"
