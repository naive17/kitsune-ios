dxmt: Bound staging and dynamic-buffer memory.

Idle dynamic buffers go once they have been idle for 120 command buffers.
The resource initializer flushes once 64 MB of uploads are staged, and the
staging ring frees a completed one-off block wherever it sits. A level load
(Cuphead: 70 textures of 4096x4096) kept every upload's staging alive and
ran the phone out of memory.
---
diff --git a/src/dxmt/dxmt_dynamic.cpp b/src/dxmt/dxmt_dynamic.cpp
index ce7941eaa99b9cb48608e023200bed65a40fe99f..08199266f70b434effa24eee4c0c8608ed7c69d3 100644
--- a/src/dxmt/dxmt_dynamic.cpp
+++ b/src/dxmt/dxmt_dynamic.cpp
@@ -2,6 +2,23 @@
 #include "dxmt_texture.hpp"
 
 namespace dxmt {
+
+/* Idle allocations kept for reuse per dynamic resource. A game that discards
+ * a buffer many times in one frame and then stops would otherwise keep every
+ * allocation it ever made. Only allocations idle for kStaleSeqs command
+ * buffers are dropped: one discarded more than 64 times per frame cycles that
+ * many through the queue, and dropping those as soon as there were 64 would
+ * create and destroy Metal buffers every frame. */
+constexpr size_t kMaxIdleAllocations = 64;
+constexpr uint64_t kStaleSeqs = 120;
+
+template <typename Queue>
+static void
+drop_stale(Queue &fifo, uint64_t coherent_seq_id) {
+  while (fifo.size() > kMaxIdleAllocations && fifo.front().will_free_at + kStaleSeqs <= coherent_seq_id)
+    fifo.pop();
+}
+
 DynamicBuffer::DynamicBuffer(Buffer *buffer, Flags<BufferAllocationFlag> flags) :
     buffer(buffer),
     flags_(flags),
@@ -22,18 +39,11 @@ Rc<BufferAllocation>
 DynamicBuffer::allocate(uint64_t coherent_seq_id) {
   std::lock_guard<dxmt::mutex> lock(mutex_);
   Rc<BufferAllocation> ret;
-  for (;;) {
-    if (fifo.empty()) {
-      break;
-    }
-    auto entry = fifo.front();
-    if (entry.will_free_at > coherent_seq_id) {
-      break;
-    }
-    ret = std::move(entry.allocation);
+  if (!fifo.empty() && fifo.front().will_free_at <= coherent_seq_id) {
+    ret = std::move(fifo.front().allocation);
     fifo.pop();
-    break;
   }
+  drop_stale(fifo, coherent_seq_id);
   if (!ret.ptr())
     ret = buffer->allocate(flags_);
   return ret;
@@ -90,18 +100,11 @@ Rc<TextureAllocation>
 DynamicLinearTexture::allocate(uint64_t coherent_seq_id) {
   std::lock_guard<dxmt::mutex> lock(mutex_);
   Rc<TextureAllocation> ret;
-  for (;;) {
-    if (fifo.empty()) {
-      break;
-    }
-    auto entry = fifo.front();
-    if (entry.will_free_at > coherent_seq_id) {
-      break;
-    }
-    ret = std::move(entry.allocation);
+  if (!fifo.empty() && fifo.front().will_free_at <= coherent_seq_id) {
+    ret = std::move(fifo.front().allocation);
     fifo.pop();
-    break;
   }
+  drop_stale(fifo, coherent_seq_id);
   if (!ret.ptr())
     ret = texture->allocate(flags_);
   return ret;
