+static bool texture_upload_pitch_ok(id<MTLTexture> tex, size_t width, size_t bytes_per_row) {
+  if (bytes_per_row == 0)
+    return true;
+  size_t bpp;
+  if (!format_bytes_per_pixel([tex pixelFormat], &bpp))
+    return true;
+  return bytes_per_row >= width * bpp;
 }
 
