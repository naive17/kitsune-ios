+inline bool IsBCFormat(uint32_t f) { return (f >= 70 && f <= 84) || (f >= 94 && f <= 99); }
+
+uint32_t MipClampLevels() {
+  static int cached = -1;
+  if (cached < 0)
+    cached = std::max(0, std::min(4, Config::getInstance().getOption<int>("d3d11.mipClampBC", 0)));
+  return (uint32_t)cached;
+}
+
+uint32_t MipClampMaxDim() {
+  static int cached = -1;
+  if (cached < 0)
+    cached = std::max(0, Config::getInstance().getOption<int>("d3d11.bcMaxDim", 0));
+  return (uint32_t)cached;
+}
+
+/* Levels to drop for one texture under both knobs. */
+uint32_t MipClampDropsFor(uint32_t width, uint32_t height, uint32_t mips) {
+  uint32_t clamp = std::min(MipClampLevels(), mips - 1);   /* always keep >= 1 mip */
+  if (uint32_t cap = MipClampMaxDim()) {
+    uint32_t n = 0, w = width, h = height;
+    while (n < clamp && (w > cap || h > cap)) { w = std::max(1u, w >> 1); h = std::max(1u, h >> 1); n++; }
+    clamp = n;
+  }
+  while (clamp && ((width >> clamp) < 4 || (height >> clamp) < 4))
+    clamp--;                                               /* never below one 4x4 block */
+  return clamp;
+}
+
+bool MipClampEligible(const D3D11_TEXTURE2D_DESC1 *d, const D3D11_SUBRESOURCE_DATA *data) {
+  if (!MipClampLevels() || !data) return false;
+  if (!IsBCFormat((uint32_t)d->Format)) return false;
+  if (d->Usage != D3D11_USAGE_DEFAULT && d->Usage != D3D11_USAGE_IMMUTABLE) return false;
+  if (d->BindFlags != D3D11_BIND_SHADER_RESOURCE) return false;   /* no RT/UAV/DS */
+  if (d->CPUAccessFlags) return false;
+  if (d->MipLevels < 2) return false;              /* MipLevels==0 means "generate"; also excluded */
+  if (d->SampleDesc.Count > 1) return false;
+  if (d->Width < 8 || d->Height < 8) return false; /* keep the clamped top >= one 4x4 block */
+  /* Under a dimension cap, a texture already within it is left alone. */
+  if (uint32_t cap = MipClampMaxDim())
+    if (d->Width <= cap && d->Height <= cap) return false;
+  return true;
+}
+
+uint32_t MipClampFor(const void *res) {
+  return static_cast<const D3D11ResourceCommon *>(res)->mip_clamp.levels;
+}
+
+} // namespace
