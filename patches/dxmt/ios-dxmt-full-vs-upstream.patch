+          "fmt=%lu device=%s maxDrawables=%lu superlayer=%s\n",
+          (unsigned long long)n, app,
+          (double)layer.drawableSize.width, (double)layer.drawableSize.height,
+          (double)layer.contentsScale, (unsigned long)layer.pixelFormat,
+          layer.device ? "ok" : "NIL",
+          (unsigned long)layer.maximumDrawableCount,
+          layer.superlayer ? "yes" : "NO");
+}
+
+/* KITSUNE_NIL_DRAWABLE_EVERY=N makes every Nth -nextDrawable return nil, so
+ * the drop-frame path runs without a backgrounded app or a starved pool. */
+static int
+nil_drawable_forced(void) {
+  static int every = -1;
+
+  if (every < 0) {
+    const char *e = getenv("KITSUNE_NIL_DRAWABLE_EVERY");
+    every = (e && *e) ? atoi(e) : 0;
+  }
+  if (every <= 0) return 0;
+  {
+    static _Atomic uint64_t calls = 0;
+    return ((atomic_fetch_add(&calls, 1) + 1) % (uint64_t)every) == 0;
+  }
+}
+
 static NTSTATUS
 _MetalLayer_nextDrawable(void *obj) {
   struct unixcall_generic_obj_obj_ret *params = obj;
-  params->ret = (obj_handle_t)[(CAMetalLayer *)params->handle nextDrawable];
+  CAMetalLayer *layer = (CAMetalLayer *)params->handle;
+  id<CAMetalDrawable> drawable = nil_drawable_forced() ? nil : [layer nextDrawable];
+
+  params->ret = (obj_handle_t)drawable;
+#if !TARGET_OS_OSX
+  watch_app_state();
+#endif
+  if (!drawable) report_nil_drawable(layer);
   return STATUS_SUCCESS;
 }
 
