new file mode 100644
index 0000000..7f83f68
--- /dev/null
+++ b/src/dxmt/dxmt_bc_decode.hpp
@@ -0,0 +1,119 @@
+// iOS BC upload layout. Keep in sync with winemetal's physical format remap.
+// bcdec.h is vendored unchanged under its MIT license (see bcdec.README).
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include "../winemetal/winemetal.h"
+#define BCDECDEF static inline
+#define BCDEC_BC4BC5_PRECISE
+#define BCDEC_IMPLEMENTATION
+#include "bcdec.h"
+#undef BCDEC_IMPLEMENTATION
+#undef BCDEC_BC4BC5_PRECISE
+#undef BCDECDEF
+
+namespace dxmt {
+/* 16-bit BC1 applies only to the decoded path; with KITSUNE_BC_NATIVE the unix
+ * half transcodes BC1 from RGBA8 texels. Both halves must agree. */
+inline bool bc_16bit_enabled() {
+  static const bool enabled = [] {
+    const char *native = std::getenv("KITSUNE_BC_NATIVE");
+    if (native && *native && *native != '0') return false;
+    const char *e = std::getenv("KITSUNE_BC_16BIT");
+    return e && *e && *e != '0';
+  }();
+  return enabled;
+}
+
+struct BCUploadLayout {
+  unsigned kind = 0, bytes_per_block = 0, bytes_per_pixel = 0;
+  bool is_signed = false, bgr5551 = false;
+  size_t row_pitch = 0, image_pitch = 0;
+};
+
+inline BCUploadLayout bc_upload_layout(WMTPixelFormat format, uint32_t width,
+                                       uint32_t height, bool use_16bit) {
+  BCUploadLayout l;
+  switch (format) {
+  case WMTPixelFormatBC1_RGBA:
+    l.bgr5551 = use_16bit;
+    [[fallthrough]];
+  case WMTPixelFormatBC1_RGBA_sRGB:
+    l.kind = 1; l.bytes_per_block = 8; l.bytes_per_pixel = l.bgr5551 ? 2 : 4; break;
+  case WMTPixelFormatBC2_RGBA: case WMTPixelFormatBC2_RGBA_sRGB:
+    l.kind = 2; l.bytes_per_block = 16; l.bytes_per_pixel = 4; break;
+  case WMTPixelFormatBC3_RGBA: case WMTPixelFormatBC3_RGBA_sRGB:
+    l.kind = 3; l.bytes_per_block = 16; l.bytes_per_pixel = 4; break;
+  case WMTPixelFormatBC4_RSnorm: l.is_signed = true; [[fallthrough]];
+  case WMTPixelFormatBC4_RUnorm:
+    l.kind = 4; l.bytes_per_block = 8; l.bytes_per_pixel = 1; break;
+  case WMTPixelFormatBC5_RGSnorm: l.is_signed = true; [[fallthrough]];
+  case WMTPixelFormatBC5_RGUnorm:
+    l.kind = 5; l.bytes_per_block = 16; l.bytes_per_pixel = 2; break;
+  case WMTPixelFormatBC6H_RGBFloat: l.is_signed = true; [[fallthrough]];
+  case WMTPixelFormatBC6H_RGBUfloat:
+    l.kind = 6; l.bytes_per_block = 16; l.bytes_per_pixel = 8; break;
+  case WMTPixelFormatBC7_RGBAUnorm: case WMTPixelFormatBC7_RGBAUnorm_sRGB:
+    l.kind = 7; l.bytes_per_block = 16; l.bytes_per_pixel = 4; break;
+  default: return l;
+  }
+  if (!width || !height || width > (std::numeric_limits<size_t>::max() - 3) / l.bytes_per_pixel)
+    return {};
+  // This is the GPU staging pitch too, not merely a temporary decode pitch.
+  l.row_pitch = (size_t(width) * l.bytes_per_pixel + 3) & ~size_t(3);
+  if (height > std::numeric_limits<size_t>::max() / l.row_pitch) return {};
+  l.image_pitch = l.row_pitch * height;
+  return l;
+}
+
+inline bool bc_decode_upload(const BCUploadLayout &l, const void *data, size_t source_pitch,
+                             uint8_t *dst, uint32_t width, uint32_t height) {
+  if (!l.kind || !data || !dst || !width || !height ||
+      source_pitch < ((size_t(width) + 3) / 4) * l.bytes_per_block) return false;
+  std::memset(dst, 0, l.image_pitch);
+  for (uint32_t by = 0; by < height; by += 4) {
+    for (uint32_t bx = 0; bx < width; bx += 4) {
+      const auto *src = static_cast<const uint8_t *>(data) + size_t(by / 4) * source_pitch +
+                        size_t(bx / 4) * l.bytes_per_block;
+      alignas(8) uint8_t block[128] = {};
+      unsigned decoded_pixel_bytes = l.bgr5551 ? 4 : l.bytes_per_pixel;
+      switch (l.kind) {
+      case 1: bcdec_bc1(src, block, 16); break;
+      case 2: bcdec_bc2(src, block, 16); break;
+      case 3: bcdec_bc3(src, block, 16); break;
+      case 4: bcdec_bc4(src, block, 4, l.is_signed); break;
+      case 5: bcdec_bc5(src, block, 8, l.is_signed); break;
+      case 6: {
+        uint16_t rgb[48];
+        // bcdec's HALF pitch is in half values, not bytes.
+        bcdec_bc6h_half(src, rgb, 12, l.is_signed);
+        auto *rgba = reinterpret_cast<uint16_t *>(block);
+        for (unsigned p = 0; p < 16; p++) {
+          std::memcpy(rgba + p * 4, rgb + p * 3, 6);
+          rgba[p * 4 + 3] = 0x3c00; // alpha = half(1.0)
+        }
+        break;
+      }
+      case 7: bcdec_bc7(src, block, 16); break;
+      default: return false;
+      }
+      for (uint32_t y = 0; y < std::min(4u, height - by); y++) {
+        for (uint32_t x = 0; x < std::min(4u, width - bx); x++) {
+          const auto *pixel = block + (y * 4 + x) * decoded_pixel_bytes;
+          auto *out = dst + size_t(by + y) * l.row_pitch + size_t(bx + x) * l.bytes_per_pixel;
+          if (l.bgr5551) {
+            uint16_t packed = (pixel[2] >> 3) | ((pixel[1] >> 3) << 5) |
+                              ((pixel[0] >> 3) << 10) | (pixel[3] >= 128 ? 0x8000 : 0);
+            std::memcpy(out, &packed, sizeof(packed));
+          } else std::memcpy(out, pixel, l.bytes_per_pixel);
+        }
+      }
+    }
+  }
+  return true;
+}
+} // namespace dxmt
