+extern int ios_bc_transcode(const uint8_t *src, size_t pitch, unsigned bpp, unsigned width, unsigned height,
+                            int kind, uint8_t *dst, size_t dst_size);
+extern size_t ios_bc_block_bytes(int kind);
+
+/* Which transcode a destination format needs, and the decoded texel size the
+ * PE half uploads for it. */
+static bool bc_native_kind(MTLPixelFormat fmt, int *kind, unsigned *src_bpp) {
+  switch (fmt) {
+  case MTLPixelFormatEAC_RGBA8:
+  case MTLPixelFormatEAC_RGBA8_sRGB:
+    *kind = 0; *src_bpp = 4; return true;
+  case MTLPixelFormatEAC_R11Unorm:
+    *kind = 1; *src_bpp = 1; return true;
+  case MTLPixelFormatEAC_RG11Unorm:
+    *kind = 2; *src_bpp = 2; return true;
+  default:
+    return false;
+  }
+}
+
+/* Buffers handed to a blit encoder must outlive the command buffer; they are
+ * collected here and released from the commit's completion handler. */
+static pthread_mutex_t bc_pending_lock = PTHREAD_MUTEX_INITIALIZER;
+static NSMutableArray *bc_pending_buffers;
+
+static void bc_pending_add(id<MTLBuffer> buf) {
+  pthread_mutex_lock(&bc_pending_lock);
+  if (!bc_pending_buffers) bc_pending_buffers = [[NSMutableArray alloc] init];
+  [bc_pending_buffers addObject:buf];
+  pthread_mutex_unlock(&bc_pending_lock);
+}
+
+static void bc_pending_attach(id<MTLCommandBuffer> cmdbuf) {
+  NSMutableArray *batch;
+  pthread_mutex_lock(&bc_pending_lock);
+  batch = bc_pending_buffers;
+  bc_pending_buffers = nil;
+  pthread_mutex_unlock(&bc_pending_lock);
+  if (!batch) return;
+  [cmdbuf addCompletedHandler:^(id<MTLCommandBuffer> cb) { (void)cb; [batch release]; }];
+}
+
+/* Encode a decoded upload into the compressed destination. Returns true when
+ * the copy was issued (or must be dropped), false to fall through. */
+static bool bc_native_upload(id<MTLBlitCommandEncoder> encoder, struct wmtcmd_blit_copy_from_buffer_to_texture *body) {
+  id<MTLTexture> dst = (id<MTLTexture>)body->dst;
+  id<MTLBuffer> src = (id<MTLBuffer>)body->src;
+  int kind; unsigned bpp;
+  static unsigned n_failed;
+
+  if (!bc_native_kind([dst pixelFormat], &kind, &bpp)) return false;
+  if (body->size.depth != 1 || [src storageMode] == MTLStorageModePrivate ||
+      body->bytes_per_row < (size_t)body->size.width * bpp) {
+    if (n_failed++ < 8) dprintf(STDERR_FILENO, "[bc-native] cannot transcode %ux%u depth %u pitch %u (bpp %u)\n",
+                                (unsigned)body->size.width, (unsigned)body->size.height, (unsigned)body->size.depth,
+                                (unsigned)body->bytes_per_row, bpp);
+    return true;
+  }
+  unsigned w = (unsigned)body->size.width, h = (unsigned)body->size.height;
+  {
+    /* Blocks are 4x4: an update must start on a block and end on one or on
+     * the level's edge. Anything else cannot be encoded in place. */
+    NSUInteger lw = MAX(1u, [dst width] >> body->level), lh = MAX(1u, [dst height] >> body->level);
+    if ((body->origin.x | body->origin.y) & 3 ||
+        ((w & 3) && body->origin.x + w != lw) || ((h & 3) && body->origin.y + h != lh)) {
+      if (n_failed++ < 8) dprintf(STDERR_FILENO, "[bc-native] unaligned update %ux%u at %u,%u of %lux%lu dropped\n",
+                                  w, h, (unsigned)body->origin.x, (unsigned)body->origin.y, (unsigned long)lw, (unsigned long)lh);
+      return true;
+    }
+  }
+  unsigned bw = (w + 3) / 4, bh = (h + 3) / 4;
+  size_t block = ios_bc_block_bytes(kind), bytes = (size_t)bw * bh * block;
+  id<MTLBuffer> out = [[dst device] newBufferWithLength:bytes options:MTLResourceStorageModeShared];
+  if (!out) return true;
+  const uint8_t *in = (const uint8_t *)[src contents] + body->src_offset;
+  if (ios_bc_transcode(in, body->bytes_per_row, bpp, w, h, kind, (uint8_t *)[out contents], bytes)) {
+    [out release];
+    if (n_failed++ < 8) dprintf(STDERR_FILENO, "[bc-native] encode failed %ux%u kind %d\n", w, h, kind);
+    return true;
+  }
+  [encoder copyFromBuffer:out
+             sourceOffset:0
+        sourceBytesPerRow:bw * block
+      sourceBytesPerImage:bytes
+               sourceSize:MTLSizeMake(w, h, 1)
+                toTexture:dst
+         destinationSlice:body->slice
+         destinationLevel:body->level
+        destinationOrigin:MTLOriginMake(body->origin.x, body->origin.y, body->origin.z)];
+  bc_pending_add(out);
+  [out release];
+  return true;
+}
