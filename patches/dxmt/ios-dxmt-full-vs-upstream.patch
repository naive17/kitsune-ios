+extern "C" unsigned MipClampLevelsOf(const void *res) { return MipClampFor(res); }
+
+extern "C" void MipClampWarnRuntimeOp(const void *res, const char *op) {
+  if (!MipClampFor(res)) return;
+  static int warned;
+  if (warned++ < 16)
+    ERR("[mip-clamp] ", op, " on a clamped resource ", res,
+        " skipped: its subresource indices are not translated");
+}
