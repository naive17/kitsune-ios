+/* Idle allocations kept for reuse per dynamic resource. A game that discards
+ * a buffer many times in one frame and then stops would otherwise keep every
+ * allocation it ever made. Only allocations idle for kStaleSeqs command
+ * buffers are dropped: one discarded more than 64 times per frame cycles that
+ * many through the queue, and dropping those as soon as there were 64 would
+ * create and destroy Metal buffers every frame. */
+constexpr size_t kMaxIdleAllocations = 64;
