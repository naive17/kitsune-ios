+
+/* GPU busy time as the union of command buffer execution intervals, for the
+ * host's performance readout. Off until the host asks for it. */
+static _Atomic int g_gpu_timing;
+static _Atomic uint64_t g_gpu_busy_ns;
+static os_unfair_lock g_gpu_lock = OS_UNFAIR_LOCK_INIT;
+static double g_gpu_last_end;
+
+__attribute__((visibility("default"))) void kitsune_gpu_timing_enable(int on) {
+  atomic_store_explicit(&g_gpu_timing, on ? 1 : 0, memory_order_relaxed);
+}
+
+__attribute__((visibility("default"))) uint64_t kitsune_gpu_busy_ns(void) {
+  return atomic_load_explicit(&g_gpu_busy_ns, memory_order_relaxed);
+}
+
+static void gpu_timing_attach(id<MTLCommandBuffer> cmdbuf) {
+  if (!atomic_load_explicit(&g_gpu_timing, memory_order_relaxed)) return;
+  [cmdbuf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+    double start = cb.GPUStartTime, end = cb.GPUEndTime;
+    if (!(end > start)) return;
+    os_unfair_lock_lock(&g_gpu_lock);
+    if (start < g_gpu_last_end) start = g_gpu_last_end;
+    if (end > start)
+      atomic_fetch_add_explicit(&g_gpu_busy_ns, (uint64_t)((end - start) * 1e9), memory_order_relaxed);
+    if (end > g_gpu_last_end) g_gpu_last_end = end;
+    os_unfair_lock_unlock(&g_gpu_lock);
+  }];
+}
