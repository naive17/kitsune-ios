+/* Presents so far, for the host's frame-rate readout. With diagnostics on
+ * (KITSUNE_DIAG_LEVEL >= 1) the first and every 60th present are logged, and
+ * each of those re-reads the GPU debug mask. */
+static _Atomic uint64_t g_present_count = 0;
+static int g_present_log = -1;
+static inline void log_present_cadence(const char *path) {
+  uint64_t n = atomic_fetch_add_explicit(&g_present_count, 1, memory_order_relaxed) + 1;
+  if (__builtin_expect(g_present_log < 0, 0)) {
+    const char *level = getenv("KITSUNE_DIAG_LEVEL");
+    g_present_log = level && atoi(level) >= 1;
+  }
+  if (g_present_log && (n == 1 || (n % 60) == 0)) {
+    ios_refresh_gpu_debug();
+    dprintf(STDERR_FILENO, "[iOS DXMT] Present #%llu (%s)\n",
+            (unsigned long long)n, path);
+  }
+}
