build: Build with Xcode 27's Metal compiler and current libc++.

Xcode 27's Metal compiler takes a memory-flags argument in its atomic
builtins, so the tessellation shader calls the public
atomic_fetch_add_explicit, which every toolchain forwards correctly; this
is upstream DXMT 06065754af (Paweł Kołodziejski, MIT). Current libc++ no
longer pulls in <iterator> and friends transitively, and the build finds
Homebrew's llvm@15.
---
diff --git a/include/ftl.hpp b/include/ftl.hpp
index c20f48fa08a45d7c1735845ebe0da944faf5a853..63ecef2b160559b8a890033bc759e5879aab802c 100644
--- a/include/ftl.hpp
+++ b/include/ftl.hpp
@@ -3,6 +3,7 @@
 #include <utility>
 #include <vector>
 #include <algorithm>
+#include <iterator>
 
 template <class Tp, typename Func>
 auto operator | (const std::vector<Tp> &vec, Func &&f)  {
diff --git a/src/airconv/darwin/meson.build b/src/airconv/darwin/meson.build
index f3e39ecd76157b910e9d6da3b311e3133e279296..5d3b914b04297c8a7099b7862064a07d1e8d1797 100644
--- a/src/airconv/darwin/meson.build
+++ b/src/airconv/darwin/meson.build
@@ -19,6 +19,9 @@ if native_llvm_path.startswith('/usr/local/opt')
     llvm_ld_flags_darwin,
     '/usr/local/opt/zstd/lib/libzstd.a', '/usr/local/opt/llvm@15/lib/libunwind.a'
   ]
+elif import('fs').exists('/opt/homebrew/opt/zstd/lib/libzstd.a')
+  # Kitsune: Apple-silicon Homebrew (brew's llvm@15 references zstd)
+  llvm_ld_flags_darwin = [ llvm_ld_flags_darwin, '/opt/homebrew/opt/zstd/lib/libzstd.a' ]
 endif
 
 airconv_lib_darwin = static_library('airconv', airconv_src,
diff --git a/src/airconv/shaders/air_tessellation.metal b/src/airconv/shaders/air_tessellation.metal
index 56ba86e93e4aa38777164a875d78c691111f89ab..e6705d8f3c4fcc4ce0298b6da777d8ea2e6e995e 100644
--- a/src/airconv/shaders/air_tessellation.metal
+++ b/src/airconv/shaders/air_tessellation.metal
@@ -150,7 +150,7 @@ struct TessMeshWorkload {

 int
 get_next_index(threadgroup int *out_count) {
-  return __metal_atomic_fetch_add_explicit(out_count, 1, int(memory_order_relaxed), __METAL_MEMORY_SCOPE_THREADGROUP__);
+  return atomic_fetch_add_explicit(reinterpret_cast<threadgroup atomic_int *>(out_count), 1, memory_order_relaxed);
 }
 
 template <partitioning partition>
diff --git a/src/util/sha1/sha1_util.hpp b/src/util/sha1/sha1_util.hpp
index 8197c5ef71c49ada46af08c1c17ffc73b8790405..df809894c344f8af806dac43b5de0d8e29ed0abd 100644
--- a/src/util/sha1/sha1_util.hpp
+++ b/src/util/sha1/sha1_util.hpp
@@ -12,6 +12,7 @@
 
 #include <cstdint>
 #include <cstring>
+#include <functional>
 #include <string>
 #include "./sha1.h"
 
