diff --git a/src/airconv/shaders/air_tessellation.metal b/src/airconv/shaders/air_tessellation.metal
index 56ba86e..aebb685 100644
--- a/src/airconv/shaders/air_tessellation.metal
+++ b/src/airconv/shaders/air_tessellation.metal
@@ -150,7 +150,18 @@ struct TessMeshWorkload {
 
 int
 get_next_index(threadgroup int *out_count) {
-  return __metal_atomic_fetch_add_explicit(out_count, 1, int(memory_order_relaxed), __METAL_MEMORY_SCOPE_THREADGROUP__);
+  // The Xcode 27 Metal compiler (metalfe-32023.921) added a 5th memory-flags
+  // parameter to this internal builtin; see the toolchain's <metal_atomic>,
+  // which now calls it as (ptr, val, order, scope, flags).
+  // __METAL_MEMORY_FLAGS_NONE__ is the neutral value the public wrappers pass.
+#if defined(__METAL_MEMORY_FLAGS_NONE__)
+  return __metal_atomic_fetch_add_explicit(out_count, 1, int(memory_order_relaxed),
+                                           __METAL_MEMORY_SCOPE_THREADGROUP__,
+                                           __METAL_MEMORY_FLAGS_NONE__);
+#else
+  return __metal_atomic_fetch_add_explicit(out_count, 1, int(memory_order_relaxed),
+                                           __METAL_MEMORY_SCOPE_THREADGROUP__);
+#endif
 }
 
