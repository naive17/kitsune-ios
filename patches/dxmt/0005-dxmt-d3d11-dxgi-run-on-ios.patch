+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -1096,12 +1096,9 @@ CreateSwapChain(
     return DXGI_ERROR_INVALID_CALL;
   InitReturnPtr(ppSwapChain);
 
-  DWORD window_process_id;
-  GetWindowThreadProcessId(hWnd, &window_process_id);
-  if (GetProcessId(GetCurrentProcess()) != window_process_id) {
-    ERR("CreateSwapChain: cross-process swapchain not supported yet");
-    return E_FAIL;
-  }
+  /* On iOS every Wine process runs as threads inside the app, so the HWND's
+   * owning process and GetCurrentProcess() can disagree without the swapchain
+   * being cross-process. Skip the check. */
 
   Com<IMTLDXGIDevice> layer_factory;
   if (FAILED(pDevice->QueryInterface(IID_PPV_ARGS(&layer_factory)))) {
