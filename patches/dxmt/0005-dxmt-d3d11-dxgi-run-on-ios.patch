dxmt, d3d11, dxgi: Run on iOS.

iOS Metal has no Managed storage, so it becomes Shared (DXMT_IOS). A
swapchain's window may belong to another Wine process, since every process
is a thread of the app. A sample count the GPU lacks drops to the largest it
has (8x on the A15). DXGI's content-protection and budget notifications
return unsupported instead of asserting.
---
diff --git a/meson.build b/meson.build
index e10c90191f15e4871c7b703f1f9376241f8255a0..4129241b6bdfaadc6f0aafeebacf71c6878a94f3 100644
--- a/meson.build
+++ b/meson.build
@@ -139,6 +139,15 @@ endif
 
 add_project_arguments('-DDXMT_PAGE_SIZE=4096', language: 'cpp')
 
+# On iOS all Metal storage modes that are Managed on macOS must become
+# Shared — iOS has unified memory and raises an assertion for storageMode 1
+# (Managed). The iOS target is the ARM64EC build (build-arm64ec.txt), whose
+# host machine is aarch64 windows.
+if host_machine.cpu_family() == 'aarch64' and host_machine.system() == 'windows'
+  add_project_arguments('-DDXMT_IOS=1', language: 'cpp')
+  add_project_arguments('-DDXMT_IOS=1', language: 'c')
+endif
+
 dxmt_version = vcs_tag(
   command: ['git', 'describe', '--always'],
   input:  'version.h.in',
diff --git a/src/d3d11/d3d11_resource_helper.cpp b/src/d3d11/d3d11_resource_helper.cpp
index 6624ed6c9a0b516f66c9721c6ae623383a2e52a3..5b24526d6a87b8dfa380346058e136a240bc679d 100644
--- a/src/d3d11/d3d11_resource_helper.cpp
+++ b/src/d3d11/d3d11_resource_helper.cpp
@@ -433,9 +433,18 @@ CreateMTLTextureDescriptorInternal(
     } else {
       if (SampleCount > 1) {
         if (!pDevice->GetMTLDevice().supportsTextureSampleCount(SampleCount)) {
-          ERR("CreateMTLTextureDescriptorInternal: sample count ", SampleCount,
-              " is not supported.");
-          return E_INVALIDARG;
+          /* Games that ask for more samples than the GPU has (8x on A15) get
+           * the largest count it supports; views and pipelines take the count
+           * from the Metal texture, so attachments stay consistent. */
+          UINT requested = SampleCount;
+          do SampleCount >>= 1; while (SampleCount > 1 && !pDevice->GetMTLDevice().supportsTextureSampleCount(SampleCount));
+          if (SampleCount <= 1) {
+            ERR("CreateMTLTextureDescriptorInternal: sample count ", requested, " is not supported.");
+            return E_INVALIDARG;
+          }
+          static unsigned warned;
+          if (warned++ < 4)
+            WARN("CreateMTLTextureDescriptorInternal: sample count ", requested, " clamped to ", SampleCount);
         }
         if (ArraySize > 1) {
           pDescOut->type = WMTTextureType2DMultisampleArray;
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 5e9404d3fa549e722ef35131552ea2c14cc6e0a9..4c8a5a674410069013c53c6d3fe59d17a6f967c0 100644
