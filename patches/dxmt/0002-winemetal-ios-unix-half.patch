index cb1a6cf..cc27e54 100644
--- a/src/dxgi/dxgi.cpp
+++ b/src/dxgi/dxgi.cpp
@@ -53,9 +53,30 @@ static void InitializeMetalCachePath() {
   if (env::getEnvVar("DXMT_USE_DEFAULT_METAL_CACHE") == "1")
     return;
   // This is the framework cache (mainly for PSOs), not managed by DXMT
-  auto metal_cache_path = str::format("dxmt/", env::getExeName(), "/com.apple.metal");
+  //
+  // A relative path is resolved by the unix half against
+  // confstr(_CS_DARWIN_USER_CACHE_DIR), which is a macOS per-user cache
+  // directory. Where that is unavailable -- an iOS app sandbox -- the resolve
+  // yields nil and this reports failure with no way to tell that apart from the
+  // framework simply refusing the path. DXMT_SHADER_CACHE_PATH already names an
+  // absolute directory for DXMT's own shader database; when it is set, put the
+  // framework cache beside it so neither depends on confstr.
+  std::string metal_cache_path;
+  auto base = env::getEnvVar("DXMT_SHADER_CACHE_PATH");
+  if (!base.empty() && base.starts_with("/")) {
+    if (!base.ends_with('/'))
+      base += "/";
+    metal_cache_path = base + "com.apple.metal";
+  } else {
+    metal_cache_path = str::format("dxmt/", env::getExeName(), "/com.apple.metal");
+  }
+  // Name the path in both outcomes. Without it "failed" is indistinguishable
+  // from "resolved to nowhere", and the two have different fixes.
   if (!WMTSetMetalShaderCachePath(metal_cache_path.c_str())) {
-    Logger::info("Failed to set Metal cache path, fallback to system default");
+    Logger::info(str::format("Failed to set Metal cache path (", metal_cache_path,
+                             "), fallback to system default"));
+  } else {
+    Logger::info(str::format("Metal cache path: ", metal_cache_path));
   }
 }
 
