 void initializeModule(llvm::Module &M) {
   M.setSourceFileName("airconv_generated.metal");
+  /*
+   * The target triple of the AIR this converter GENERATES at run time, which is
+   * a different thing from the platform airconv itself was compiled for -- and
+   * the reason it is easy to miss. Everything else about an iOS build can be
+   * right and Metal will still refuse every shader, because a metallib carrying
+   * a macosx triple does not load on iOS.
+   *
+   * Taken from the Metal compiler rather than guessed:
+   *   metal -std=metal3.1 --target=air64-apple-ios17.0 -> air64-apple-ios17.0.0
+   */
+#if TARGET_OS_OSX
   M.setTargetTriple("air64-apple-macosx14.0.0");
+#else
+  M.setTargetTriple("air64-apple-ios17.0.0");
+#endif
   M.setDataLayout(
     "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-f64:"
     "64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-"
     "v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:"
     "16:32"
   );
+#if TARGET_OS_OSX
   M.setSDKVersion(VersionTuple(15, 0));
+#else
+  /* Kept in step with the triple above. If a metallib is ever rejected with a
+   * version complaint rather than a platform one, this is the number. */
+  M.setSDKVersion(VersionTuple(17, 0));
+#endif
   M.addModuleFlag(Module::ModFlagBehavior::Error, "wchar_size", 4);
   M.addModuleFlag(Module::ModFlagBehavior::Max, "frame-pointer", 2);
   M.addModuleFlag(Module::ModFlagBehavior::Max, "air.max_device_buffers", 31);
