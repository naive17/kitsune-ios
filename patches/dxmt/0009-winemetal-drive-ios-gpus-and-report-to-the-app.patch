@@ -0,0 +1,47 @@
+/* RGBA8/R8/RG8 -> ETC2/EAC block encoding for BC textures on GPUs without BC. */
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "etcpak/ProcessRGB.hpp"
+
+extern "C" {
+
+enum ios_bc_kind { IOS_BC_EAC_RGBA8 = 0, IOS_BC_EAC_R11 = 1, IOS_BC_EAC_RG11 = 2 };
+
+size_t ios_bc_block_bytes(int kind) { return kind == IOS_BC_EAC_R11 ? 8 : 16; }
+
+/* Expand `src` (bpp 1, 2 or 4 bytes per texel, `pitch` bytes per row) into a
+ * 4-aligned RGBA8 image, edge-replicated, then encode. `dst` receives
+ * ceil(w/4)*ceil(h/4) blocks in row-major order. Returns 0 on success. */
+int ios_bc_transcode(const uint8_t *src, size_t pitch, unsigned bpp,
+                     unsigned width, unsigned height, int kind,
+                     uint8_t *dst, size_t dst_size) {
+  if (!src || !dst || !width || !height || (bpp != 1 && bpp != 2 && bpp != 4)) return -1;
+  if (pitch < (size_t)width * bpp) return -1;
+  unsigned w4 = (width + 3) & ~3u, h4 = (height + 3) & ~3u;
+  size_t blocks = (size_t)(w4 / 4) * (h4 / 4);
+  if (dst_size < blocks * ios_bc_block_bytes(kind)) return -1;
+  uint32_t *rgba = (uint32_t *)malloc((size_t)w4 * h4 * 4);
+  if (!rgba) return -1;
+  for (unsigned y = 0; y < h4; y++) {
+    const uint8_t *row = src + pitch * (y < height ? y : height - 1);
+    uint32_t *out = rgba + (size_t)y * w4;
+    for (unsigned x = 0; x < w4; x++) {
+      const uint8_t *p = row + (size_t)(x < width ? x : width - 1) * bpp;
+      uint32_t r = p[0], g = bpp >= 2 ? p[1] : 0, b = bpp == 4 ? p[2] : 0, a = bpp == 4 ? p[3] : 255;
+      /* etcpak reads B, G, R, A bytes (its EAC R/RG encoders take bytes 2 and
+       * 1); packing R first swapped red and blue and zeroed EAC's red. */
+      out[x] = b | (g << 8) | (r << 16) | (a << 24);
+    }
+  }
+  switch (kind) {
+  case IOS_BC_EAC_RGBA8: CompressEtc2Rgba(rgba, (uint64_t *)dst, (uint32_t)blocks, w4, true); break;
+  case IOS_BC_EAC_R11:   CompressEacR(rgba, (uint64_t *)dst, (uint32_t)blocks, w4); break;
+  case IOS_BC_EAC_RG11:  CompressEacRg(rgba, (uint64_t *)dst, (uint32_t)blocks, w4); break;
+  default: free(rgba); return -1;
+  }
+  free(rgba);
+  return 0;
+}
+
+}
