+/* Kitsune: cumulative Metal allocation totals, logged every 128 MB, to see
+ * where a game's GPU memory goes (buffers by storage mode, textures by pixel
+ * format). Frees are not tracked; MTLDevice.currentAllocatedSize (the app's
+ * heartbeat) gives the live total to compare with. */
+static void kitsune_count_alloc(int is_texture, NSUInteger storage, NSUInteger format, NSUInteger bytes,
+                                NSUInteger w, NSUInteger h, NSUInteger mips)
+{
+  static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+  static unsigned long long buf_bytes[4], tex_bytes[4], next_report = 128ull << 20, total;
+  static struct { NSUInteger fmt; unsigned long long bytes; unsigned count; } fmts[48];
+  static unsigned nfmts;
+  unsigned i;
+
+  pthread_mutex_lock(&lock);
+  if (storage > 3) storage = 3;
+  if (is_texture) {
+    tex_bytes[storage] += bytes;
+    for (i = 0; i < nfmts && fmts[i].fmt != format; i++) ;
+    if (i == nfmts && nfmts < 48) { fmts[i].fmt = format; fmts[i].bytes = 0; fmts[i].count = 0; nfmts++; }
+    if (i < 48) { fmts[i].bytes += bytes; fmts[i].count++; }
+    if (bytes >= (16u << 20))
+      fprintf(stderr, "[iOS DXMT] big texture: fmt %lu %lux%lu mips %lu storage %lu -> %lu MB\n",
+              (unsigned long)format, (unsigned long)w, (unsigned long)h, (unsigned long)mips,
+              (unsigned long)storage, (unsigned long)(bytes >> 20));
+  } else {
+    buf_bytes[storage] += bytes;
+    if (bytes >= (16u << 20))
+      fprintf(stderr, "[iOS DXMT] big buffer: %lu MB storage %lu\n", (unsigned long)(bytes >> 20), (unsigned long)storage);
+  }
+  total += bytes;
+  if (total >= next_report) {
+    next_report = total + (128ull << 20);
+    fprintf(stderr, "[iOS DXMT] alloc totals %llu MB: buffers shared %llu private %llu | textures shared %llu private %llu memoryless %llu\n",
+            total >> 20, buf_bytes[0] >> 20, buf_bytes[2] >> 20, tex_bytes[0] >> 20, tex_bytes[2] >> 20, tex_bytes[3] >> 20);
+    for (i = 0; i < nfmts; i++)
+      if (fmts[i].bytes >= (16u << 20))
+        fprintf(stderr, "[iOS DXMT]   texture fmt %lu: %u textures, %llu MB\n",
+                (unsigned long)fmts[i].fmt, fmts[i].count, fmts[i].bytes >> 20);
+  }
+  pthread_mutex_unlock(&lock);
+}
