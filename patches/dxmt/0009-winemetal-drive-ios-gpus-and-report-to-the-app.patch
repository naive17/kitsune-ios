+static _Atomic unsigned ios_gpu_debug_mask = 0;
+static void ios_refresh_gpu_debug(void) {
+#if !TARGET_OS_OSX
+  @autoreleasepool {
+    NSString *docs = NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES).firstObject;
+    const char *path = [[docs stringByAppendingPathComponent:@"dxmt-gpu-debug.txt"] fileSystemRepresentation];
+    unsigned mask = 0;
+    FILE *f = path ? fopen(path, "r") : NULL;
+    if (f) {
+      if (fscanf(f, "%u", &mask) != 1 || mask > 3) mask = 0;
+      fclose(f);
+    }
+    unsigned old = atomic_exchange_explicit(&ios_gpu_debug_mask, mask, memory_order_relaxed);
+    static atomic_bool reported = false;
+    if (!atomic_exchange_explicit(&reported, true, memory_order_relaxed) || old != mask) {
+      dprintf(STDERR_FILENO, "[iOS DXMT] gpu-debug mask=%u serial=%u preserve-store=%u\n",
+              mask, !!(mask & 1), !!(mask & 2));
+    }
+  }
+#endif
+}
