+/* Shared on/off switch for the 16-bit BC decode. Read once; the PE half reads
+ * the same variable so both agree on the physical texture format. */
+static int g_bc16_cached = -1;
+static bool bc_16bit_enabled(void) {
+  if (__builtin_expect(g_bc16_cached >= 0, 1))
+    return g_bc16_cached != 0;
+  const char *e = getenv("KITSUNE_BC_16BIT"), *native = getenv("KITSUNE_BC_NATIVE");
+  g_bc16_cached = (e && *e && *e != '0' && !(native && *native && *native != '0')) ? 1 : 0;
+  dprintf(STDERR_FILENO, "[iOS DXMT] BC 16-bit decode = %s\n", g_bc16_cached ? "ON (BC1 -> BGR5A1)" : "off");
+  return g_bc16_cached != 0;
+}
+
+static int g_bc_native_cached = -1;
+static bool bc_native_enabled(void) {
+  if (__builtin_expect(g_bc_native_cached >= 0, 1))
+    return g_bc_native_cached != 0;
+  const char *e = getenv("KITSUNE_BC_NATIVE");
+  g_bc_native_cached = (e && *e && *e != '0') ? 1 : 0;
+  dprintf(STDERR_FILENO, "[iOS DXMT] BC native transcode = %s\n", g_bc_native_cached ? "ON (ETC2/EAC)" : "off");
+  return g_bc_native_cached != 0;
+}
+
+/* Kitsune: large sampled-only RGBA8 textures stored as ETC2/EAC (8 bits per
+ * texel instead of 32). Unity games ship uncompressed RGBA8 atlases (Blasphemous:
+ * ~2.2 GB of them) that do not fit the 4 GB app limit; the A15 decodes ETC2 in
+ * hardware. Uploads go through the BC path's encoder (bc_native_upload), which
+ * already takes RGBA8 texels. Render targets, storage textures and small ones
+ * stay RGBA8. KITSUNE_RGBA_ETC2=1 enables it. */
+static int g_rgba_etc2_cached = -1;
+static bool rgba_etc2_enabled(void) {
+  if (__builtin_expect(g_rgba_etc2_cached >= 0, 1))
+    return g_rgba_etc2_cached != 0;
+  const char *e = getenv("KITSUNE_RGBA_ETC2");
+  g_rgba_etc2_cached = (e && *e && *e != '0') ? 1 : 0;
+  dprintf(STDERR_FILENO, "[iOS DXMT] RGBA8 -> ETC2 for large sampled textures = %s\n", g_rgba_etc2_cached ? "ON" : "off");
+  return g_rgba_etc2_cached != 0;
+}
+
+#define RGBA_ETC2_MIN_DIM 1024
+
+static bool rgba_etc2_eligible(MTLTextureDescriptor *desc) {
+  if (desc.pixelFormat != MTLPixelFormatRGBA8Unorm && desc.pixelFormat != MTLPixelFormatRGBA8Unorm_sRGB) return false;
+  if (desc.textureType != MTLTextureType2D && desc.textureType != MTLTextureType2DArray) return false;
+  if (desc.storageMode != MTLStorageModePrivate || desc.sampleCount != 1) return false;
+  if (desc.usage & (MTLTextureUsageRenderTarget | MTLTextureUsageShaderWrite)) return false;
+  return desc.width >= RGBA_ETC2_MIN_DIM || desc.height >= RGBA_ETC2_MIN_DIM;
+}
+
+static MTLPixelFormat rgba_etc2_format(MTLPixelFormat fmt) {
+  return fmt == MTLPixelFormatRGBA8Unorm_sRGB ? MTLPixelFormatEAC_RGBA8_sRGB : MTLPixelFormatEAC_RGBA8;
+}
+
+static bool is_eac_rgba(MTLPixelFormat fmt) {
+  return fmt == MTLPixelFormatEAC_RGBA8 || fmt == MTLPixelFormatEAC_RGBA8_sRGB;
+}
+
+static enum WMTPixelFormat remap_bc_native(enum WMTPixelFormat fmt) {
+  switch (fmt) {
+  case WMTPixelFormatBC1_RGBA:
+  case WMTPixelFormatBC2_RGBA:
+  case WMTPixelFormatBC3_RGBA:
+  case WMTPixelFormatBC7_RGBAUnorm:
+    return WMTPixelFormatEAC_RGBA8;
+  case WMTPixelFormatBC1_RGBA_sRGB:
+  case WMTPixelFormatBC2_RGBA_sRGB:
+  case WMTPixelFormatBC3_RGBA_sRGB:
+  case WMTPixelFormatBC7_RGBAUnorm_sRGB:
+    return WMTPixelFormatEAC_RGBA8_sRGB;
+  case WMTPixelFormatBC4_RUnorm:
+    return WMTPixelFormatEAC_R11Unorm;
+  case WMTPixelFormatBC5_RGUnorm:
+    return WMTPixelFormatEAC_RG11Unorm;
+  default:
+    return fmt;   /* snorm and BC6H keep the decoded formats below */
+  }
+}
+
+static enum WMTPixelFormat remap_unsupported_bc(enum WMTPixelFormat fmt, bool bc_supported) {
+  if (bc_supported)
+    return fmt;
+  if (bc_native_enabled()) {
+    enum WMTPixelFormat native = remap_bc_native(fmt);
+    if (native != fmt) return native;
+  }
+  switch (fmt) {
+  case WMTPixelFormatBC1_RGBA:
+    if (bc_16bit_enabled())
+      return WMTPixelFormatBGR5A1Unorm;
+    return WMTPixelFormatRGBA8Unorm;
+  case WMTPixelFormatBC2_RGBA:
+  case WMTPixelFormatBC3_RGBA:
+  case WMTPixelFormatBC7_RGBAUnorm:
+    return WMTPixelFormatRGBA8Unorm;
+  case WMTPixelFormatBC1_RGBA_sRGB:
+  case WMTPixelFormatBC2_RGBA_sRGB:
+  case WMTPixelFormatBC3_RGBA_sRGB:
+  case WMTPixelFormatBC7_RGBAUnorm_sRGB:
+    return WMTPixelFormatRGBA8Unorm_sRGB;
+  case WMTPixelFormatBC4_RUnorm:
+    return WMTPixelFormatR8Unorm;
+  case WMTPixelFormatBC4_RSnorm:
+    return WMTPixelFormatR8Snorm;
+  case WMTPixelFormatBC5_RGUnorm:
+    return WMTPixelFormatRG8Unorm;
+  case WMTPixelFormatBC5_RGSnorm:
+    return WMTPixelFormatRG8Snorm;
+  case WMTPixelFormatBC6H_RGBFloat:
+  case WMTPixelFormatBC6H_RGBUfloat:
+    return WMTPixelFormatRGBA16Float;
+  default:
+    return fmt;
+  }
+}
+
+/* Cached per-device check — set on first to_metal_pixel_format call.
+ * Safe because the process uses a single MTLDevice. */
+static int g_bc_supported_cached = -1;
+static bool query_bc_support(void) {
+  if (__builtin_expect(g_bc_supported_cached >= 0, 1))
+    return g_bc_supported_cached != 0;
+  bool supported = false;
+  @autoreleasepool {
+    id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+    if (dev) {
+      if ([dev respondsToSelector:@selector(supportsBCTextureCompression)])
+        supported = [dev supportsBCTextureCompression];
+      [dev release];
+    }
+  }
+  g_bc_supported_cached = supported ? 1 : 0;
+  /* Once per process: whether BC textures are sampled natively or decoded. */
+  dprintf(STDERR_FILENO,
+          "[iOS DXMT] supportsBCTextureCompression = %s\n",
+          supported ? "YES" : "NO");
+  return supported;
+}
+
 MTLPixelFormat to_metal_pixel_format(enum WMTPixelFormat format) {
-  return (MTLPixelFormat)ORIGINAL_FORMAT(format);
+  enum WMTPixelFormat stripped = (enum WMTPixelFormat)ORIGINAL_FORMAT(format);
+  stripped = remap_unsupported_bc(stripped, query_bc_support());
+  return (MTLPixelFormat)stripped;
+}
+
+static bool format_bytes_per_pixel(MTLPixelFormat fmt, size_t *bpp_out) {
+  switch (fmt) {
+  case MTLPixelFormatA8Unorm:
+  case MTLPixelFormatR8Unorm:
+  case MTLPixelFormatR8Snorm:
+  case MTLPixelFormatR8Uint:
+  case MTLPixelFormatR8Sint:
+  case MTLPixelFormatStencil8:
+    *bpp_out = 1; return true;
+  case MTLPixelFormatR16Unorm:
+  case MTLPixelFormatR16Snorm:
+  case MTLPixelFormatR16Uint:
+  case MTLPixelFormatR16Sint:
+  case MTLPixelFormatR16Float:
+  case MTLPixelFormatRG8Unorm:
+  case MTLPixelFormatRG8Snorm:
+  case MTLPixelFormatRG8Uint:
+  case MTLPixelFormatRG8Sint:
+  case MTLPixelFormatDepth16Unorm:
+    *bpp_out = 2; return true;
+  case MTLPixelFormatRGBA8Unorm:
+  case MTLPixelFormatRGBA8Unorm_sRGB:
+  case MTLPixelFormatRGBA8Snorm:
+  case MTLPixelFormatRGBA8Uint:
+  case MTLPixelFormatRGBA8Sint:
+  case MTLPixelFormatBGRA8Unorm:
+  case MTLPixelFormatBGRA8Unorm_sRGB:
+  case MTLPixelFormatRG16Unorm:
+  case MTLPixelFormatRG16Snorm:
+  case MTLPixelFormatRG16Uint:
+  case MTLPixelFormatRG16Sint:
+  case MTLPixelFormatRG16Float:
+  case MTLPixelFormatR32Uint:
+  case MTLPixelFormatR32Sint:
+  case MTLPixelFormatR32Float:
+  case MTLPixelFormatDepth32Float:
+  case MTLPixelFormatRGB10A2Unorm:
+  case MTLPixelFormatRGB10A2Uint:
+  case MTLPixelFormatBGR10A2Unorm:
+  case MTLPixelFormatRG11B10Float:
+  case MTLPixelFormatRGB9E5Float:
+    *bpp_out = 4; return true;
+  case MTLPixelFormatRGBA16Unorm:
+  case MTLPixelFormatRGBA16Snorm:
+  case MTLPixelFormatRGBA16Uint:
+  case MTLPixelFormatRGBA16Sint:
+  case MTLPixelFormatRGBA16Float:
+  case MTLPixelFormatRG32Uint:
+  case MTLPixelFormatRG32Sint:
+  case MTLPixelFormatRG32Float:
+  case MTLPixelFormatDepth32Float_Stencil8:
+    *bpp_out = 8; return true;
+  case MTLPixelFormatRGBA32Uint:
+  case MTLPixelFormatRGBA32Sint:
+  case MTLPixelFormatRGBA32Float:
+    *bpp_out = 16; return true;
+  default:
+    return false;
+  }
+}
